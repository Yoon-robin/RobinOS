# RobinOS GNOME/GTK interface defaults (system dconf database "local").
# Installed to /etc/dconf/db/local.d/00-robinos; run `dconf update` afterwards.
# GTK, libadwaita, Firefox and the xdg-desktop-portal settings read these.
# The shell changes color-scheme, gtk-theme and accent-color when the user picks a theme.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
cursor-size=24
font-name='Geist 11'
document-font-name='Geist 11'
monospace-font-name='Geist Mono 11'
accent-color='red'
enable-hot-corners=false

# Title bar buttons of GTK, Firefox and Qt apps. Hyprland 0.56 ignores an app's
# own minimize request (xdg_toplevel.set_minimized), so that button would do
# nothing; the dock minimizes instead (desktop/shell/ShellState.qml).
[org/gnome/desktop/wm/preferences]
button-layout='appmenu:maximize,close'

# Ptyxis, the terminal (T-154): follow the shell's light/dark choice, open each
# window clean instead of restoring the last session, a little larger than 80x24,
# and the interface's monospace font above (Geist Mono)
[org/gnome/Ptyxis]
interface-style='system'
restore-session=false
restore-window-size=false
default-columns=uint32 100
default-rows=uint32 28
