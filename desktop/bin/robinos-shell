#!/usr/bin/env bash
# Runs the RobinOS shell (Quickshell) for the session and keeps it on screen.
# Started by Hyprland (desktop/hypr/robinos.lua).
#
# - GPU drawing: some graphics drivers (VMware's vmwgfx, 2026-10) let Hyprland
#   use the GPU but give Qt no EGL surface, so the shell runs with nothing on
#   screen. When the shell's log shows that, it is restarted with software
#   rendering (llvmpipe) for the rest of the session. Hyprland keeps the GPU.
# - Crashes: the shell is started again. After 5 crashes within 2 minutes it
#   stops trying and Hyprland shows how to recover.
#
# Force software rendering with ROBINOS_SHELL_RENDER=software in ~/.bash_profile.
# Log: ~/.local/state/robinos/shell.log

set -uo pipefail

shell_dir="/usr/share/robinos/shell"
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/robinos"
log="${state_dir}/shell.log"
mkdir -p "${state_dir}"
: >"${log}"

software="false"
[[ "${ROBINOS_SHELL_RENDER:-auto}" == "software" || "${ROBINOS_RENDER:-}" == "software" ]] && software="true"
crashes=()

note() {
  printf '[robinos-shell] %s\n' "$*" >>"${log}"
  logger -t robinos-shell -- "$*" 2>/dev/null || true
}

# Qt prints these within a few seconds of the first window when it can't draw
# with the GPU. The shell then either shows nothing or dies with a Wayland error.
gpu_failed() {
  tail -n +"$((start_line + 1))" "${log}" | grep -qE 'Could not create EGL surface|eglSwapBuffers failed'
}

compositor_alive() {
  [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-1}" ]]
}

while compositor_alive; do
  note "starting the shell (software rendering: ${software})"
  start_line=$(wc -l <"${log}")
  if [[ "${software}" == "true" ]]; then
    LIBGL_ALWAYS_SOFTWARE=1 qs -p "${shell_dir}" >>"${log}" 2>&1 &
  else
    qs -p "${shell_dir}" >>"${log}" 2>&1 &
  fi
  pid=$!

  if [[ "${software}" != "true" ]]; then
    for _ in $(seq 1 20); do
      sleep 0.5
      gpu_failed && break
      kill -0 "${pid}" 2>/dev/null || break
    done
  fi
  if [[ "${software}" != "true" ]] && gpu_failed; then
    kill "${pid}" 2>/dev/null
  fi

  wait "${pid}"
  status=$?
  compositor_alive || break
  if [[ "${software}" != "true" ]] && gpu_failed; then
    note "Qt can't draw with the GPU here; restarting the shell with software rendering"
    software="true"
    continue
  fi
  note "the shell exited with ${status}"

  now=$(date +%s)
  recent=()
  for t in "${crashes[@]}" "${now}"; do
    (( now - t < 120 )) && recent+=("${t}")
  done
  crashes=("${recent[@]}")
  if (( ${#crashes[@]} >= 5 )); then
    note "the shell crashed 5 times within 2 minutes; not restarting"
    hyprctl notify 3 600000 "rgb(f87171)" "RobinOS 셸이 계속 멈춰요. Win+Enter로 터미널을 열고 robinctl doctor로 확인하세요. 최근 업데이트 때문이라면 robinctl snapshot list에서 이전 상태로 되돌릴 수 있어요. 기록: ~/.local/state/robinos/shell.log" >/dev/null 2>&1
    exit 1
  fi
  sleep 1
done
