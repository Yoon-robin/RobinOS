* text=auto

*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.desktop text eol=lf
*.colorscheme text eol=lf
*.qml text eol=lf
*.js text eol=lf
*.py text eol=lf
*.lua text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.md text eol=lf
# Armored keys and signatures, the same bytes on every checkout
*.asc text eol=lf

desktop/** text eol=lf
archiso/airootfs/usr/share/robinos/** text eol=lf
archiso/airootfs/usr/share/wayland-sessions/** text eol=lf
archiso/airootfs/usr/share/xdg-desktop-portal/** text eol=lf
archiso/airootfs/usr/share/dbus-1/** text eol=lf
archiso/airootfs/opt/robinos/desktop/** text eol=lf

bin/* text eol=lf
installer/* text eol=lf
archiso/airootfs/etc/** text eol=lf
archiso/airootfs/root/** text eol=lf
archiso/airootfs/usr/local/bin/** text eol=lf
archiso/packages.x86_64 text eol=lf
archiso/pacman.conf text eol=lf
archiso/profiledef.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.iso binary


# Scripts without an extension run in bash on Linux; a CRLF checkout would break them
bin/* text eol=lf
installer/* text eol=lf
desktop/bin/* text eol=lf
archiso/airootfs/usr/local/bin/* text eol=lf
archiso/airootfs/opt/robinos/bin/* text eol=lf
archiso/airootfs/opt/robinos/installer/* text eol=lf
archiso/airootfs/usr/share/robinos/bin/* text eol=lf
