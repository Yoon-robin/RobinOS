#!/usr/bin/env python3
"""RobinOS installer backend. Runs on the live ISO.

  robin-install                       how to start the installer
  robin-install disks                 disks the installer can use, as JSON
  sudo robin-install run PLAN.json    install RobinOS, printing progress
  sudo robin-install run -            the same, with the plan on stdin

The graphical installer (desktop/shell/Installer.qml) collects the choices and
pipes them to `sudo robin-install run -`, so the password never lands in a
file. A plan file is deleted after reading. The plan:

  {
    "disk": "/dev/nvme0n1",
    "mode": "whole",          "whole" erases the disk; "alongside" keeps what is
                              there and makes a partition in the largest free
                              space; "partition" installs into one existing
                              partition ("partition" below)
    "user": "robin",
    "password": "...",
    "hostname": "robinos",
    "timezone": "Asia/Seoul",
    "bitlocker_key_saved": true  needed for "alongside" when Windows is on
                              BitLocker: the person has its recovery key
    "size_gb": 80             optional, "alongside" only: how much of that free
                              space RobinOS gets, 40 or more (all of it if left
                              out, or if less than 1 GB would stay free)
    "partition": "/dev/nvme0n1p5"  "partition" only: the partition to install
                              into, one `disks` lists as "usable" in its
                              "partitions": made beforehand in Disk Management,
                              or an earlier RobinOS one (an install that stopped
                              half way, a reinstall). Its files are erased
  }

Layout: GPT; the EFI system partition on /efi (Windows' own one in
"alongside"); Btrfs with @ on /, @home, @log, @pkg and @snapshots on
/.snapshots. /boot stays inside @, so every snapshot carries its kernel
(docs/recovery.md). UEFI only. When Windows is on this PC (on the same disk, or
on another fixed disk), its boot manager goes in the GRUB menu and the hardware
clock stays in local time.

Output: the commands and their output, plus lines for the GUI:
  @@ <percent> <message>     progress
  @@ error <message>         the install stopped
A copy goes to /var/log/robin-install.log. While the packages come in, the bar
moves with pacman's lines (PacmanProgress); pacstrap runs with LC_ALL=C.UTF-8
because those lines are the English ones.
"""

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

ROBINOS = "/opt/robinos"
TARGET = "/mnt"
LOG_FILE = "/var/log/robin-install.log"
GIB = 1024**3
MIN_SIZE = 40 * GIB
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
WINDOWS_RESERVED_TYPE = "e3c9e316-0b5c-4db8-817d-f92df00215ae"
WINDOWS_DATA_TYPE = "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7"
WINDOWS_RECOVERY_TYPE = "de94bba4-06d1-4d40-a16a-bfd50179d6ac"
WINDOWS_TYPES = {WINDOWS_RESERVED_TYPE, WINDOWS_DATA_TYPE, WINDOWS_RECOVERY_TYPE}
LINUX_TYPE = "0fc63daf-8483-4772-8e79-3d69d8477de4"
# The GPT name robin-install gives its partition
ROBINOS_LABEL = "RobinOS"
SUBVOLUMES = [("@", ""), ("@home", "home"), ("@log", "var/log"),
              ("@pkg", "var/cache/pacman/pkg"), ("@snapshots", ".snapshots")]
MOUNT_OPTIONS = "noatime,compress=zstd:1"
UDEV_HOOKS = "base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck"
# Guest tools for the VM the installer runs in (systemd-detect-virt names):
# packages and the services to enable. VMware's vmtoolsd also tells the guest
# when its window is resized (desktop/bin/robinos-vm-display follows it).
# qemu-guest-agent starts by itself when QEMU offers its channel.
GUEST_TOOLS = {
    "vmware": (["open-vm-tools"], ["vmtoolsd.service"]),
    "kvm": (["qemu-guest-agent"], []),
    "qemu": (["qemu-guest-agent"], []),
}
PCI_DEVICES = "/sys/bus/pci/devices"
NVIDIA_VENDOR = 0x10DE
# NVIDIA's open kernel modules (nvidia-open) run on Turing (GTX 16, RTX 20) and
# newer, whose PCI device ids start at 0x1e00. Older cards keep nouveau: Arch
# only has their proprietary driver in the AUR.
NVIDIA_OPEN_FIRST_DEVICE = 0x1E00

log_file = None


class InstallError(Exception):
    pass


def say(text):
    print(text, flush=True)
    if log_file:
        log_file.write(text + "\n")
        log_file.flush()


def progress(percent, message):
    say(f"@@ {percent} {message}")


def run(*cmd, input=None, on_line=None, env=None):
    """Runs a command, streaming its output; raises InstallError on failure."""
    say("$ " + shlex.join(cmd))
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE if input else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            errors="replace", env=env)
    if input:
        proc.stdin.write(input)
        proc.stdin.close()
    for line in proc.stdout:
        line = line.rstrip("\n")
        say(line)
        if on_line:
            on_line(line)
    if proc.wait() != 0:
        raise InstallError(f"명령이 실패했어요 ({proc.returncode}): {cmd[0]}")


def output(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def chroot(*cmd, input=None):
    run("arch-chroot", TARGET, *cmd, input=input)


def write(path, text, mode=0o644):
    full = TARGET + path
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "w") as f:
        f.write(text)
    os.chmod(full, mode)
    say(f"# {path} 작성")


def package_list(name):
    with open(f"{ROBINOS}/packages/{name}.txt") as f:
        return [line.strip() for line in f if line.strip() and not line.startswith("#")]


# ---- Disks ----

def live_disk():
    """The disk the ISO booted from (a USB stick); never offered as a target."""
    try:
        source = output("findmnt", "-no", "SOURCE", "/run/archiso/bootmnt").strip()
        parent = output("lsblk", "-no", "PKNAME", source).strip().splitlines()
        return "/dev/" + parent[0] if parent and parent[0] else source
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def parted_table(disk):
    """The disk from start to end, from `parted -m ... print free`:
    [("part", number, size)] and [("free", 0, size)] in disk order, in bytes."""
    rows = []
    for line in output("parted", "-m", "-s", disk, "unit", "B", "print", "free").splitlines():
        fields = line.rstrip(";").split(":")
        if len(fields) < 5 or not fields[0].isdigit():
            continue  # "BYT;" and the disk's own line
        size = int(fields[3].rstrip("B"))
        if fields[4] == "free":
            rows.append(("free", 0, size))
        else:
            rows.append(("part", int(fields[0]), size))
    return rows


def free_spaces(disk):
    """Sizes of the free blocks on a disk, in bytes."""
    return [size for kind, _, size in parted_table(disk) if kind == "free"]


def is_robinos(part):
    """A partition an earlier robin-install made (its GPT name), finished or not."""
    return part.get("partlabel") == ROBINOS_LABEL and (part.get("parttype") or "").lower() == LINUX_TYPE


def windows_inside(path):
    """Whether an NTFS partition holds Windows (True), doesn't (False) or can't be
    read (None). Looked at read-only, so a Windows that hibernated stays as it is."""
    mount = tempfile.mkdtemp(prefix="robin-probe-")
    try:
        result = subprocess.run(["mount", "-o", "ro", "-t", "ntfs-3g", path, mount],
                                capture_output=True, timeout=30)
        if result.returncode != 0:
            return None
        try:
            return any(os.path.isdir(os.path.join(mount, name, "System32")) for name in ("Windows", "WINDOWS"))
        finally:
            subprocess.run(["umount", mount], capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        return None
    finally:
        try:
            os.rmdir(mount)
        except OSError:
            pass


def partition_usable(part, kind):
    """(usable, why not): can RobinOS be installed into this partition? Only ones
    that are big enough and not in use, and never Windows' own."""
    if kind in ("efi", "system"):
        return False, "윈도우나 부팅에 쓰는 파티션이에요"
    if int(part.get("size") or 0) < MIN_SIZE:
        return False, "40GB보다 작아요"
    if any(part.get("mountpoints") or []):
        return False, "지금 쓰고 있어요"
    fstype = part.get("fstype") or ""
    if fstype == "BitLocker":
        return False, "BitLocker로 잠겨 있어요"
    if fstype in ("swap", "crypto_LUKS", "LVM2_member", "linux_raid_member"):
        return False, f"{fstype} 형식이라 고를 수 없어요"
    if fstype == "ntfs":
        inside = windows_inside(part["path"])
        if inside is None:
            return False, "읽을 수 없어요(윈도우의 빠른 시작이 켜져 있을 수 있어요)"
        if inside:
            return False, "윈도우가 들어 있어요"
    return True, ""


def segment(part):
    """How the installer's disk picture shows a partition."""
    parttype = (part.get("parttype") or "").lower()
    if parttype == ESP_TYPE:
        kind, name = "efi", "EFI"
    elif is_robinos(part):
        kind, name = "robinos", "RobinOS"
    elif parttype == WINDOWS_RECOVERY_TYPE:
        kind, name = "system", "윈도우 복구"
    elif parttype == WINDOWS_RESERVED_TYPE:
        kind, name = "system", "윈도우 예약"
    elif part.get("fstype") in ("ntfs", "BitLocker") or parttype in WINDOWS_TYPES:
        kind, name = "windows", part.get("label") or "윈도우"
    else:
        kind, name = "other", part.get("label") or part.get("fstype") or "파티션"
    usable, reason = partition_usable(part, kind)
    return {"kind": kind, "name": name, "size": int(part.get("size") or 0), "path": part["path"],
            "number": int(part.get("partn") or 0), "fstype": part.get("fstype") or "",
            "label": part.get("label") or "", "usable": usable, "reason": reason}


def disk_layout(dev, parts):
    """The disk picture: partitions and free blocks in disk order. Alignment gaps
    under 64 MiB are left out; a disk without a partition table is one free block."""
    size = int(dev.get("size") or 0)
    if not dev.get("pttype"):
        return [{"kind": "free", "name": "빈 공간", "size": size, "path": "", "usable": False}]
    by_number = {int(p["partn"]): p for p in parts if p.get("partn")}
    try:
        table = parted_table(dev["path"])
    except subprocess.CalledProcessError:
        return [segment(p) for p in parts]
    layout = []
    for kind, number, part_size in table:
        if kind == "free":
            if part_size >= 64 * 1024**2:
                layout.append({"kind": "free", "name": "빈 공간", "size": part_size, "path": "", "usable": False})
        elif number in by_number:
            layout.append(segment(by_number[number]))
    return layout


def list_disks():
    data = json.loads(output("lsblk", "-J", "-b", "-o",
                             "NAME,PATH,SIZE,TYPE,MODEL,TRAN,RM,RO,PTTYPE,PARTTYPE,PARTLABEL,PARTN,FSTYPE,LABEL,MOUNTPOINTS"))
    live = live_disk()
    disks = []
    for dev in data.get("blockdevices", []):
        if dev.get("type") != "disk" or dev.get("ro") or dev["path"] == live:
            continue
        if dev["path"].startswith(("/dev/zram", "/dev/loop", "/dev/sr")):
            continue
        parts = dev.get("children") or []
        esp = next((p["path"] for p in parts if (p.get("parttype") or "").lower() == ESP_TYPE), None)
        windows = any(p.get("fstype") in ("ntfs", "BitLocker")
                      or (p.get("parttype") or "").lower() in WINDOWS_TYPES for p in parts)
        # blkid names an encrypted Windows volume "BitLocker"
        bitlocker = any(p.get("fstype") == "BitLocker" for p in parts)
        robinos = next(({"path": p["path"], "size": int(p.get("size") or 0)} for p in parts if is_robinos(p)), None)
        largest_free = 0
        if dev.get("pttype") == "gpt":
            try:
                largest_free = max(free_spaces(dev["path"]), default=0)
            except subprocess.CalledProcessError:
                pass
        layout = disk_layout(dev, parts)
        installable = [s for s in layout if s["path"] and s["usable"]]
        gpt = dev.get("pttype") == "gpt" and esp is not None
        disks.append({
            "path": dev["path"],
            "size": int(dev.get("size") or 0),
            "model": (dev.get("model") or "").strip(),
            "transport": dev.get("tran") or "",
            "removable": bool(dev.get("rm")),
            "pttype": dev.get("pttype") or "",
            "esp": esp,
            "windows": windows,
            "bitlocker": bitlocker,
            "free": largest_free,
            "robinos": robinos,
            "layout": layout,
            "partitions": [s for s in layout if s["path"]],
            "can_whole": int(dev.get("size") or 0) >= MIN_SIZE,
            "can_alongside": gpt and largest_free >= MIN_SIZE,
            "can_partition": gpt and bool(installable),
        })
    return disks


def windows_elsewhere(disks, path):
    """Windows installed on another fixed disk of this PC: an EFI partition next to
    NTFS. A data disk formatted NTFS has no EFI partition and doesn't count."""
    return any(d["path"] != path and d["windows"] and d["esp"] and not d["removable"] for d in disks)


def partitions(disk):
    """{partition number: path} for a disk, from sysfs."""
    found = {}
    for line in output("lsblk", "-lnp", "-o", "NAME,TYPE", disk).splitlines():
        name, kind = line.split()
        number_file = f"/sys/class/block/{os.path.basename(name)}/partition"
        if kind == "part" and os.path.exists(number_file):
            with open(number_file) as f:
                found[int(f.read())] = name
    return found


def settle(disk):
    run("partprobe", disk)
    run("udevadm", "settle")


# ---- Install ----

def read_plan(path):
    if path == "-":
        plan = json.load(sys.stdin)
    else:
        with open(path) as f:
            plan = json.load(f)
        os.remove(path)  # it holds the password

    for key in ("disk", "mode", "user", "password", "hostname", "timezone"):
        if not plan.get(key):
            raise InstallError(f"설치 계획에 {key} 항목이 없어요")
    # An earlier plan format: "alongside" plus the RobinOS partition to replace
    if plan.get("replace") and plan["mode"] == "alongside":
        plan["mode"], plan["partition"] = "partition", plan.pop("replace")
    if plan["mode"] not in ("whole", "alongside", "partition"):
        raise InstallError(f"알 수 없는 설치 방식이에요: {plan['mode']}")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", plan["user"]) or plan["user"] == "root":
        raise InstallError("사용자 이름은 영어 소문자로 시작하고 소문자, 숫자, -, _만 쓸 수 있어요")
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9-]{0,62}", plan["hostname"]):
        raise InstallError("컴퓨터 이름은 영어, 숫자, -만 쓸 수 있어요")
    if (not re.fullmatch(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*", plan["timezone"])
            or not os.path.isfile(f"/usr/share/zoneinfo/{plan['timezone']}")):
        raise InstallError(f"알 수 없는 시간대예요: {plan['timezone']}")
    if plan["mode"] == "partition" and not re.fullmatch(r"/dev/[A-Za-z0-9/_-]+", str(plan.get("partition") or "")):
        raise InstallError("설치할 파티션을 알려 주세요")
    if plan.get("partition") and plan["mode"] != "partition":
        raise InstallError("파티션은 \"만들어 둔 파티션에 설치\"에서만 골라요")
    if plan.get("replace"):
        raise InstallError("이전 RobinOS 파티션은 만들어 둔 파티션에 설치할 때만 다시 써요")
    if plan.get("size_gb") is not None:
        size = plan["size_gb"]
        if plan["mode"] != "alongside":
            raise InstallError("크기는 빈 공간에 설치할 때만 정해요")
        if isinstance(size, bool) or not isinstance(size, int) or not 40 <= size <= 1_000_000:
            raise InstallError("RobinOS가 쓸 크기는 40GB 이상으로 정해 주세요")
    return plan


def prepare_disk(plan, disk):
    """Partitions and formats; returns (esp, root) partition paths."""
    progress(2, "디스크 준비")
    if plan["mode"] == "whole":
        if not disk["can_whole"]:
            raise InstallError("디스크가 40GB보다 작아요")
        run("sgdisk", "--zap-all", disk["path"])
        run("sgdisk", "-n", "1:0:+1G", "-t", "1:ef00", "-c", "1:EFI",
            "-n", "2:0:0", "-t", "2:8300", "-c", "2:RobinOS", disk["path"])
        settle(disk["path"])
        parts = partitions(disk["path"])
        esp, root = parts[1], parts[2]
        run("mkfs.fat", "-F", "32", "-n", "EFI", esp)
    else:
        if disk["pttype"] != "gpt" or not disk["esp"]:
            raise InstallError("이 방식으로 설치하려면 GPT 디스크에 EFI 파티션이 있어야 해요")
        # Changing the boot order can make Windows ask for the BitLocker recovery
        # key; without it the Windows files cannot be opened again
        if disk["bitlocker"] and plan.get("bitlocker_key_saved") is not True:
            raise InstallError("윈도우 드라이브가 BitLocker로 잠겨 있어요. 복구 키를 따로 적어 둔 뒤 다시 설치해요")
        if plan["mode"] == "partition":
            # Into a partition that exists: one made in Disk Management, or an
            # earlier RobinOS one. It must be one `disks` offers, checked again now
            chosen = next((p for p in disk["partitions"] if p["path"] == plan["partition"]), None)
            if chosen is None:
                raise InstallError(f"고른 파티션을 찾지 못했어요: {plan['partition']}")
            if not chosen["usable"]:
                raise InstallError(f"{chosen['path']}에는 설치할 수 없어요: {chosen['reason']}")
            # Named and typed like the ones robin-install makes, so a next install
            # finds it as RobinOS's own
            number = str(chosen["number"])
            run("sgdisk", "-t", f"{number}:8300", "-c", f"{number}:{ROBINOS_LABEL}", disk["path"])
            settle(disk["path"])
            esp, root = disk["esp"], chosen["path"]
        else:
            if disk["free"] < MIN_SIZE:
                raise InstallError("빈 공간이 40GB보다 적어요")
            size = plan.get("size_gb")
            if size is not None and size * GIB > disk["free"]:
                raise InstallError(f"빈 공간({disk['free'] // GIB}GB)보다 크게 정할 수 없어요")
            # 0 = to the end of the largest free block; leaving under 1 GB over is
            # no use, and the block's end isn't a whole number of GB anyway
            end = "0" if size is None or disk["free"] - size * GIB < GIB else f"+{size}G"
            before = set(partitions(disk["path"]).values())
            # 0:0:... = next number, from the start of the largest free block
            run("sgdisk", "-n", f"0:0:{end}", "-t", "0:8300", "-c", f"0:{ROBINOS_LABEL}", disk["path"])
            settle(disk["path"])
            new = set(partitions(disk["path"]).values()) - before
            if len(new) != 1:
                raise InstallError("새 파티션을 찾지 못했어요")
            esp, root = disk["esp"], new.pop()
    run("mkfs.btrfs", "-f", "-L", "RobinOS", root)
    return esp, root


def mount_target(esp, root):
    progress(8, "Btrfs 하위 볼륨")
    run("mount", root, TARGET)
    for name, _ in SUBVOLUMES:
        run("btrfs", "subvolume", "create", f"{TARGET}/{name}")
    run("umount", TARGET)
    for name, path in SUBVOLUMES:
        where = os.path.join(TARGET, path) if path else TARGET
        os.makedirs(where, exist_ok=True)
        run("mount", "-o", f"{MOUNT_OPTIONS},subvol=/{name}", root, where)
    os.makedirs(f"{TARGET}/efi", exist_ok=True)
    run("mount", esp, f"{TARGET}/efi")


def guest_tools():
    """([packages], [services]) for the VM we run in; nothing on real hardware."""
    try:
        virt = output("systemd-detect-virt", "--vm").strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return [], []
    # QEMU on Windows (WHPX) also says "vmware", and VMware's tools then fail at
    # every boot; vmware-checkvm (open-vm-tools, on the live ISO) asks VMware itself
    if virt == "vmware" and not is_vmware():
        return [], []
    return GUEST_TOOLS.get(virt, ([], []))


def is_vmware():
    try:
        return subprocess.run(["vmware-checkvm"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


def nvidia_gpus(devices=PCI_DEVICES):
    """PCI device ids of the NVIDIA display controllers (VGA or 3D, as on laptops)."""
    found = []
    for name in sorted(os.listdir(devices)) if os.path.isdir(devices) else []:
        try:
            with open(os.path.join(devices, name, "vendor")) as f:
                vendor = int(f.read(), 16)
            with open(os.path.join(devices, name, "class")) as f:
                pci_class = int(f.read(), 16)
            with open(os.path.join(devices, name, "device")) as f:
                device = int(f.read(), 16)
        except (OSError, ValueError):
            continue
        if vendor == NVIDIA_VENDOR and pci_class >> 16 == 0x03:
            found.append(device)
    return found


def gpu_drivers(devices=PCI_DEVICES):
    """Driver packages for the graphics cards in this PC."""
    gpus = nvidia_gpus(devices)
    if any(device >= NVIDIA_OPEN_FIRST_DEVICE for device in gpus):
        say("# NVIDIA 그래픽 카드(GTX 16, RTX 20 이후): nvidia-open을 설치해요")
        return ["nvidia-open"]
    if gpus:
        say("# 오래된 NVIDIA 그래픽 카드: 기본 드라이버(nouveau)를 써요")
    return []


class PacmanProgress:
    """Turns pacman's lines into progress: downloading takes 12-42%, installing
    42-70%. Piped, pacman has no progress bars and no "(3/987)" counters (those
    are for a terminal), so the packages are counted from these lines:

      Packages (987) a-1.0-1 b-2.0-1 ...      the transaction's size
       linux-6.17.1.arch1-1-x86_64 downloading...
      installing a...
    Database downloads (" core downloading...") come before the package list
    and don't count. The lines are pacman's English ones: pacstrap runs with
    LC_ALL=C.UTF-8, as the live session is Korean."""

    TOTAL = re.compile(r"^Packages \((\d+)\)")
    DOWNLOAD = re.compile(r"^ \S+ downloading\.\.\.$")
    INSTALL = re.compile(r"^installing \S+\.\.\.$")
    # On a terminal pacman does print the counter; take it as it is
    COUNTED = re.compile(r"\(\s*(\d+)/(\d+)\) installing ")

    def __init__(self):
        self.total = 0
        self.downloaded = 0
        self.installed = 0

    def feed(self, line):
        """(percent, message) to show for this line, or None."""
        match = self.TOTAL.match(line)
        if match:
            self.total = int(match.group(1))
            return 12, f"패키지 내려받기 (0/{self.total})"
        if self.total and self.DOWNLOAD.match(line):
            self.downloaded = min(self.downloaded + 1, self.total)
            if self.downloaded % 10 == 0 or self.downloaded == self.total:
                return (12 + 30 * self.downloaded // self.total,
                        f"패키지 내려받기 ({self.downloaded}/{self.total})")
            return None
        match = self.COUNTED.search(line)
        if match:
            done, total = int(match.group(1)), int(match.group(2))
        elif self.total and self.INSTALL.match(line):
            self.installed = min(self.installed + 1, self.total)
            done, total = self.installed, self.total
        else:
            return None
        if done % 10 == 0 or done == total:
            return 42 + 28 * done // total, f"패키지 설치 ({done}/{total})"
        return None


def install_packages():
    progress(12, "패키지 목록 받기")
    guest_packages, guest_services = guest_tools()
    packages = (package_list("core") + package_list("desktop") + package_list("apps")
                + ["amd-ucode", "intel-ucode"] + gpu_drivers() + guest_packages)
    pacman = PacmanProgress()

    def on_line(line):
        shown = pacman.feed(line)
        if shown:
            progress(*shown)

    run("pacstrap", "-K", TARGET, *packages, on_line=on_line,
        env={**os.environ, "LC_ALL": "C.UTF-8"})
    for service in guest_services:
        chroot("systemctl", "enable", service)
    fstab = without_subvolid(output("genfstab", "-U", TARGET))
    with open(f"{TARGET}/etc/fstab", "a") as f:
        f.write(fstab)
    say("# /etc/fstab 작성")


def without_subvolid(fstab):
    """Drops subvolid= from Btrfs lines. A rollback replaces @ with a copy of a
    snapshot, which has another id, so mounts go by subvolume name only."""
    lines = []
    for line in fstab.splitlines():
        fields = line.split()
        if len(fields) >= 4 and fields[2] == "btrfs":
            options = ",".join(o for o in fields[3].split(",") if not o.startswith("subvolid="))
            line = line.replace(fields[3], options, 1)
        lines.append(line)
    return "\n".join(lines) + "\n"


def initramfs_hooks(nvidia):
    """mkinitcpio hooks. With nvidia-open the kms hook goes, as the Arch wiki says:
    it would put nouveau in the initramfs; the NVIDIA driver loads after it."""
    hooks = UDEV_HOOKS.split()
    if nvidia:
        hooks.remove("kms")
    return " ".join(hooks)


def configure_system(plan):
    progress(72, "시스템 설정")
    chroot("ln", "-sf", f"/usr/share/zoneinfo/{plan['timezone']}", "/etc/localtime")
    # Windows keeps the hardware clock in local time; agree with it when sharing the PC
    chroot("hwclock", "--systohc", "--localtime" if plan["dual_boot"] else "--utc")

    with open(f"{TARGET}/etc/locale.gen") as f:
        locale_gen = f.read()
    for locale in ("ko_KR.UTF-8 UTF-8", "en_US.UTF-8 UTF-8"):
        locale_gen = locale_gen.replace(f"#{locale}", locale)
    write("/etc/locale.gen", locale_gen)
    chroot("locale-gen")
    write("/etc/locale.conf", "LANG=ko_KR.UTF-8\n")
    write("/etc/vconsole.conf", "KEYMAP=us\n")

    # A udev initramfs like archinstall's instead of Arch's systemd default: the
    # grub-btrfs-overlayfs hook that robinctl snapshot setup adds (and builds the
    # images with) only works there, and it makes a snapshot booted from the GRUB
    # menu writable in memory, so the desktop starts too (docs/recovery.md)
    hooks = initramfs_hooks(os.path.exists(f"{TARGET}/usr/lib/modprobe.d/nvidia-utils.conf"))
    with open(f"{TARGET}/etc/mkinitcpio.conf") as f:
        mkinitcpio, count = re.subn(r"(?m)^HOOKS=\(.*\)$", f"HOOKS=({hooks})", f.read())
    if count == 0:
        mkinitcpio += f"\nHOOKS=({hooks})\n"
    write("/etc/mkinitcpio.conf", mkinitcpio)

    write("/etc/hostname", plan["hostname"] + "\n")
    write("/etc/hosts", f"127.0.0.1 localhost\n::1 localhost\n127.0.1.1 {plan['hostname']}\n")

    chroot("useradd", "-m", "-G", "wheel", "-s", "/bin/bash", plan["user"])
    say(f"$ chpasswd ({plan['user']})")
    subprocess.run(["arch-chroot", TARGET, "chpasswd"], input=f"{plan['user']}:{plan['password']}\n",
                   text=True, check=True, capture_output=True)
    chroot("passwd", "-l", "root")
    write("/etc/sudoers.d/10-robinos-wheel", "%wheel ALL=(ALL:ALL) ALL\n", 0o440)


def install_robinos(plan):
    progress(76, "RobinOS 파일")
    run("cp", "-a", ROBINOS, f"{TARGET}/opt/")
    # Fetched when the ISO was built; saves post-install.sh a download
    if os.path.isdir("/usr/share/fonts/robinos"):
        run("cp", "-a", "/usr/share/fonts/robinos", f"{TARGET}/usr/share/fonts/")

    progress(80, "부트로더 (GRUB)")
    if plan["dual_boot"]:
        write("/etc/default/grub.d/20-robinos-dual-boot.cfg", "# Windows in the GRUB menu\nGRUB_DISABLE_OS_PROBER=false\n")
    chroot("grub-install", "--target=x86_64-efi", "--efi-directory=/efi", "--boot-directory=/boot",
           "--bootloader-id=RobinOS")
    if plan["mode"] == "whole":
        # Fallback path for firmware that forgets boot entries; the disk is ours
        chroot("grub-install", "--target=x86_64-efi", "--efi-directory=/efi", "--boot-directory=/boot",
               "--removable")
    # LC_ALL=C: GRUB's Korean messages break its os-prober script (see
    # config/grub/10-robinos-theme.cfg, which post-install.sh installs later)
    chroot("env", "LC_ALL=C", "grub-mkconfig", "-o", "/boot/grub/grub.cfg")

    progress(85, "RobinOS 데스크톱과 스냅샷")
    chroot("env", f"SUDO_USER={plan['user']}", f"{ROBINOS}/scripts/post-install.sh", "--yes")

    if plan["dual_boot"]:
        progress(95, "부팅 메뉴에 윈도우 넣기")
        grub_mkconfig_with_udev()


def grub_mkconfig_with_udev():
    """Writes grub.cfg once more from a chroot that sees the live system's /run.
    os-prober asks udev which partition is the EFI system partition, and
    arch-chroot gives the target an empty /run, so every grub-mkconfig above
    (and post-install.sh's) left Windows out of the menu."""
    mounted = []
    try:
        for name in ("proc", "sys", "dev", "run"):
            run("mount", "--rbind", f"/{name}", f"{TARGET}/{name}")
            mounted.append(name)
            run("mount", "--make-rslave", f"{TARGET}/{name}")
        run("chroot", TARGET, "env", "LC_ALL=C", "grub-mkconfig", "-o", "/boot/grub/grub.cfg")
    finally:
        for name in reversed(mounted):
            subprocess.run(["umount", "-R", f"{TARGET}/{name}"], capture_output=True)


def stop_keyring_agent():
    """pacstrap -K runs pacman-key on the new system's keyring, which can leave a
    gpg-agent running there; it keeps the target busy and umount fails."""
    subprocess.run(["gpgconf", "--homedir", f"{TARGET}/etc/pacman.d/gnupg", "--kill", "all"],
                   capture_output=True)


def install(plan_path):
    if os.geteuid() != 0:
        raise InstallError("관리자 권한이 필요해요: sudo robin-install run <계획 파일>")
    if not os.path.isdir("/sys/firmware/efi"):
        raise InstallError("UEFI 모드로 부팅한 컴퓨터에만 설치할 수 있어요")

    plan = read_plan(plan_path)
    disks = list_disks()
    disk = next((d for d in disks if d["path"] == plan["disk"]), None)
    if disk is None:
        raise InstallError(f"설치할 수 없는 디스크예요: {plan['disk']}")
    plan["dual_boot"] = (plan["mode"] != "whole" and disk["windows"]) or windows_elsewhere(disks, disk["path"])
    say(f"# RobinOS 설치: {disk['path']} ({disk['model'] or '이름 없음'}), 방식 {plan['mode']}"
        + (", 윈도우와 함께 부팅" if plan["dual_boot"] else ""))

    subprocess.run(["umount", "-R", TARGET], capture_output=True)
    esp, root = prepare_disk(plan, disk)
    mount_target(esp, root)
    install_packages()
    configure_system(plan)
    install_robinos(plan)

    progress(97, "마무리")
    stop_keyring_agent()
    run("sync")
    run("umount", "-R", TARGET)
    progress(100, "설치가 끝났어요")


def guide():
    print("""RobinOS 설치기

라이브 화면의 런처(Win+Space)에서 "RobinOS 설치"를 골라 시작하세요.

명령으로 쓰려면:
  robin-install disks                설치할 수 있는 디스크 보기
  sudo robin-install run 계획.json    계획 파일대로 설치

이미 Arch Linux를 설치했다면 그 시스템에서 이렇게 해도 돼요:
  sudo /opt/robinos/scripts/post-install.sh""")


def main():
    global log_file
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "disks":
        print(json.dumps(list_disks(), ensure_ascii=False, indent=2))
        return 0
    if command == "run" and len(sys.argv) == 3:
        try:
            log_file = open(LOG_FILE, "a") if os.geteuid() == 0 else None
            install(sys.argv[2])
            return 0
        except (InstallError, subprocess.CalledProcessError, OSError, KeyError, ValueError) as error:
            say(f"@@ error {error}")
            stop_keyring_agent()
            subprocess.run(["umount", "-R", TARGET], capture_output=True)
            return 1
    guide()
    return 0 if command in ("", "help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main())
