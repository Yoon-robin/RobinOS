#!/usr/bin/env bash
# RobinOS 데스크톱 세션 런처 (tty1 자동 로그인에서 호출).
#
# - 하드웨어 GPU 가속으로 먼저 시작한다 (실기기 + VMware/가상 GPU 3D 가속 모두).
#   Hyprland가 곧바로 실패하면(가속 없음) 소프트웨어 렌더링으로 자동 재시도한다.
#   → VM에서도 가능하면 실기기와 같은 가속 렌더링으로 뜬다.
# - Hyprland가 죽어도 크래시 루프(깜빡임) 대신 셸로 떨어진다.

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland

# root로 도는 경우만 Hyprland의 root 실행 거부를 우회 (일반 사용자는 불필요)
hypr_args=()
if [ "$(id -u)" -eq 0 ]; then
    hypr_args+=(--i-am-really-stupid)
fi

RAN_FOR=0
run_hyprland() {
    local t0 t1 rc
    t0=$(date +%s)
    Hyprland "${hypr_args[@]}" >>"${HOME}/hyprland.log" 2>&1
    rc=$?
    t1=$(date +%s)
    RAN_FOR=$((t1 - t0))
    return $rc
}

: > "${HOME}/hyprland.log"

# 1차: 하드웨어 가속으로 시도
run_hyprland
status=$?

# 6초 안에 끝났다 = 시작 실패(가속 없음 등) → 소프트웨어 렌더링으로 재시도
if [ "${RAN_FOR}" -lt 6 ]; then
    echo "── 하드웨어 렌더링 시작 실패 — 소프트웨어 렌더링으로 재시도 ──" | tee -a "${HOME}/hyprland.log"
    export LIBGL_ALWAYS_SOFTWARE=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    export WLR_NO_HARDWARE_CURSORS=1
    export AQ_NO_ATOMIC=1
    run_hyprland
    status=$?
fi

# 여기 도달 = Hyprland 종료. 크래시 루프 대신 진단 후 셸.
echo
echo "── Hyprland 가 종료됐다 (code ${status}) ──"
echo "로그: ${HOME}/hyprland.log  (마지막 줄)"
tail -n 25 "${HOME}/hyprland.log" 2>/dev/null
echo
echo "다시 시도하려면:  robinos-session"
