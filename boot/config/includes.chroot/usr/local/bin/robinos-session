#!/bin/sh
# RobinOS 세션 — cage(Wayland 키오스크)로 RobinOS 셸을 풀스크린 실행.
# robinos-kiosk.service 가 부팅 시 이 스크립트를 호출.
set -e

echo "ROBINOS-SESSION: start" >&2

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# GPU 없는 환경(QEMU 소프트웨어 에뮬·가상 GPU)에서도 cage(wlroots)+Flutter가
# 렌더되도록 소프트웨어 GL(llvmpipe) 강제. 실기기에선 무시되고 진짜 GPU 사용.
# WLR_RENDERER_ALLOW_SOFTWARE 가 없으면 wlroots가 소프트웨어 GL을 거부함.
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export WLR_RENDERER_ALLOW_SOFTWARE=1

# (선택) 내장 모델: Ollama가 있으면 백그라운드로 띄움 → Robin이 Qwen2.5로 동작
if command -v ollama >/dev/null 2>&1; then
  ollama serve >/var/log/ollama.log 2>&1 &
fi

echo "ROBINOS-SESSION: launching cage + /opt/robinos/robinos_native" >&2
# cage 로 RobinOS 바이너리만 풀스크린.
exec cage -- /opt/robinos/robinos_native
