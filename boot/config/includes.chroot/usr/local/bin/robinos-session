#!/bin/sh
# RobinOS 세션 — cage(Wayland 키오스크)로 RobinOS 셸을 풀스크린 실행.
# robinos-kiosk.service 가 부팅 시 이 스크립트를 호출.
set -e

echo "ROBINOS-SESSION: start" >&2

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# Flutter(GTK)가 XWayland(X11)로 떨어지지 않고 네이티브 Wayland를 쓰게 →
# cage가 타이틀바 없이 풀스크린으로 렌더(이전엔 1024x721 창 + 타이틀바였음).
export GDK_BACKEND=wayland

# 렌더링: 기본은 진짜 GPU(하드웨어 EGL/GL). 단, 부팅테스트(QEMU·GPU 없음)는
# 커널 cmdline에 'robinos.softrender' 를 넣어 소프트웨어 렌더로 전환:
#   cage 컴포지터 = pixman(EGL 불필요), Flutter = llvmpipe 소프트웨어 GL.
# 실기기에는 이 마커가 없으므로 진짜 GPU 가속을 그대로 사용(성능 보존).
if grep -q robinos.softrender /proc/cmdline 2>/dev/null; then
  echo "ROBINOS-SESSION: software rendering (pixman + llvmpipe)" >&2
  export WLR_RENDERER=pixman
  export WLR_RENDERER_ALLOW_SOFTWARE=1
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  export MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
fi

# (선택) 내장 모델: Ollama가 있으면 백그라운드로 띄움 → Robin이 Qwen2.5로 동작
if command -v ollama >/dev/null 2>&1; then
  ollama serve >/var/log/ollama.log 2>&1 &
fi

echo "ROBINOS-SESSION: launching cage + /opt/robinos/robinos_native" >&2
# cage 로 RobinOS 바이너리만 풀스크린.
exec cage -- /opt/robinos/robinos_native
