# RobinOS sway 설정.
# RobinOS 셸(app_id=os.robinos.shell)은 layer-shell 'background' 표면 → 데스크톱 배경 레이어.
# 실제 앱은 그 위에 타일링되고, 상/하단 gap이 메뉴바·독 영역을 비워 항상 노출시킨다.
# (gtk-layer-shell 미지원 시 셸은 maximize 창으로 폴백 — 아래 셸 전용 규칙이 전체화면 복원.)
# sway = bookworm 메인의 안정적 wlroots 컴포지터. softrender(pixman)는 robinos-session이 export.

set $mod Mod4

### RobinOS 셸 기동 (컴포지터 시작 직후 1회) ###
exec /opt/robinos/robinos_native
# polkit 인증 에이전트 — 소프트웨어 센터 설치(pkexec) 시 암호창을 띄움.
exec lxqt-policykit-agent
# (실사용 앱 실행은 런치패드/Robin/Spotlight. 창 배치는 아래 layer-shell 규칙 참고.)

### 창 규칙 (layer-shell) ###
# RobinOS 셸은 layer-shell 'background' 표면(창이 아님) → 데스크톱 배경 레이어에 그려진다.
# 실제 앱은 그 위에 '타일링'되며, 상단(메뉴바)·하단(독) 영역은 아래 gap으로 비워 둬
# 그 자리에 셸의 메뉴바·독이 항상 보이게 한다(아무 앱도 안 와서 안 가림).
# 개별 앱을 맥OS식 자유창으로 쓰고 싶으면 Super+Space로 floating 토글.
# 폴백 전용(gtk-layer-shell 미지원 → 셸이 maximize '창'일 때만 매칭): 무테 + 전역 gap을
# 0으로 되돌려 셸을 전체화면 백드롭으로 복원. 정상(layer-shell) 경로에선 셸이 창이 아니라
# (namespace=robinos-shell 레이어 표면) 이 규칙이 안 걸려 위 gap 예약이 그대로 유지된다.
for_window [app_id="os.robinos.shell"] floating disable, border none, gaps inner current set 0, gaps top current set 0, gaps bottom current set 0, gaps left current set 0, gaps right current set 0

### 모양 ###
default_border pixel 2
default_floating_border normal 2
font pango:sans 10
titlebar_padding 8 4
# 메뉴바(~32px)·독(~84px) 영역을 비워 항상 보이게 + 가장자리/창간 여백으로 데스크톱 노출.
gaps inner 10
gaps top 34
gaps bottom 96
gaps left 10
gaps right 10
# 마우스: Super+드래그로 floating 창 이동/리사이즈
floating_modifier $mod normal

### 키바인드 ###
bindsym Alt+Tab focus next
bindsym $mod+Tab focus next
bindsym Alt+F4 kill
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
# 터미널(foot) — 일반 단축키 + boottest가 앱 창을 띄워 독 가림을 검증하는 수단.
bindsym $mod+t exec foot
# RobinOS 셸이 닫혔을 때 다시 띄우기
bindsym $mod+Return exec /opt/robinos/robinos_native

### 입력(기본) ###
input * {
    xkb_layout "us"
}
