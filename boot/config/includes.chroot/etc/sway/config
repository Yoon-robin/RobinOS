# RobinOS sway 설정.
# RobinOS 셸(app_id=os.robinos.shell)은 타일링으로 화면을 꽉 채운 백드롭,
# 실제 리눅스 앱은 그 위에 floating(맥OS식 자유창)으로 띄운다.
# sway = bookworm 메인의 안정적 wlroots 컴포지터. softrender(pixman)는 robinos-session이 export.

set $mod Mod4

### RobinOS 셸 기동 (컴포지터 시작 직후 1회) ###
exec /opt/robinos/robinos_native
# polkit 인증 에이전트 — 소프트웨어 센터 설치(pkexec) 시 암호창을 띄움.
exec lxqt-policykit-agent
# (실제 앱은 아래 규칙으로 70% 중앙 floating → RobinOS 독·메뉴바가 가장자리에 노출.
#  멀티앱 독접근 검증 완료 2026-06-13. 실사용은 런치패드/Robin/Spotlight로 앱 실행.)

### 창 규칙 ###
# 실제 앱: floating(맥OS식 자유창) + 화면의 70% 크기로 중앙 배치 →
# RobinOS 독(하단)·메뉴바(상단)가 가장자리에 항상 노출돼 멀티앱 전환이 가능.
# (layer-shell로 독을 별도 패널로 올리는 건 RobinOS 단일앱 구조상 큰 작업이라 이 방식이 실용적.)
for_window [app_id=".*"] floating enable, resize set width 70 ppt height 70 ppt, move position center
for_window [class=".*"] floating enable, resize set width 70 ppt height 70 ppt, move position center
# 단, RobinOS 셸은 타일링(꽉 찬 백드롭)·무테로 되돌린다(위 규칙도 매칭되나 floating 해제).
for_window [app_id="os.robinos.shell"] floating disable, border none

### 모양 ###
default_border normal 2
default_floating_border normal 2
font pango:sans 10
titlebar_padding 8 4
gaps inner 0
gaps outer 0
# 마우스: Super+드래그로 floating 창 이동/리사이즈
floating_modifier $mod normal

### 키바인드 ###
bindsym Alt+Tab focus next
bindsym $mod+Tab focus next
bindsym Alt+F4 kill
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
# RobinOS 셸이 닫혔을 때 다시 띄우기
bindsym $mod+Return exec /opt/robinos/robinos_native

### 입력(기본) ###
input * {
    xkb_layout "us"
}
