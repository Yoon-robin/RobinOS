#!/bin/sh
# live-build chroot 훅 — 이미지 빌드 중 1회 실행.
# robin 유저 생성 + RobinOS 키오스크 서비스 활성화 (+ 선택: Qwen2.5 내장).
set -e

# 1) robin 사용자 (자동 로그인 키오스크용, 비번 없음)
if ! id robin >/dev/null 2>&1; then
  useradd -m -s /bin/bash robin
  passwd -d robin || true
fi

# 그래픽/시트/입력 접근 그룹 — 없으면 생성하고 robin을 각각 추가.
# (한 그룹이라도 없으면 'usermod -aG a,b,c'가 통째 실패 → cage가 DRM/seat 접근 불가.)
for g in video render input audio seat _seatd; do
  groupadd -f "$g" 2>/dev/null || true
  usermod -aG "$g" robin 2>/dev/null || true
done

# 2) seatd + RobinOS 키오스크 서비스 활성화, 그래픽 타깃으로 부팅
systemctl enable seatd.service || true
systemctl enable robinos-kiosk.service || true
systemctl set-default graphical.target || true

# 3) (선택) AI 모델 내장 — build-iso 워크플로 embed_ai=true 로 빌드하면 아래 'AI:' 줄들이
#    sed로 활성화되어 Ollama + 모델이 ISO에 포함됨(오프라인 Robin). 단 ISO가 크게 늘어남.
#    기본 빌드는 비활성(ISO 가볍게). 모델은 워크플로 ai_model 입력으로 지정(__AI_MODEL__ 치환).
# AI: curl -fsSL https://ollama.com/install.sh | sh
# AI: (OLLAMA_HOST=127.0.0.1:11434 ollama serve &) ; sleep 8
# AI: ollama pull __AI_MODEL__ || true
# AI: pkill ollama 2>/dev/null || true

echo "RobinOS chroot 훅 완료."
