#!/usr/bin/env bash
set -euo pipefail

readonly ROBINOS_NAME="RobinOS"
readonly ROBINOS_VERSION="0.2.0-dev"
readonly CONFIG_FILE="/etc/robinos/config.toml"
readonly SHELL_DIR="/usr/share/robinos/shell"
readonly SESSION_FILE="/usr/share/wayland-sessions/robinos.desktop"
readonly SDDM_THEME_DIR="/usr/share/sddm/themes/robinos"
readonly GRUB_THEME_FILE="/usr/share/grub/themes/robinos/theme.txt"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
if [[ -d /opt/robinos ]]; then
  PROJECT_ROOT="/opt/robinos"
fi

CORE_PACKAGES="${PROJECT_ROOT}/packages/core.txt"
SECURITY_PACKAGES="${PROJECT_ROOT}/packages/security-baseline.txt"
OPTIONAL_PACKAGES="${PROJECT_ROOT}/packages/security-optional.txt"

if [[ -t 1 ]]; then
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'
  C_RED=$'\033[31m'
  C_YELLOW=$'\033[33m'
  C_RESET=$'\033[0m'
else
  C_BOLD="" C_DIM="" C_GREEN="" C_RED="" C_YELLOW="" C_RESET=""
fi

usage() {
  cat <<'EOF'
robinctl - RobinOS 관리 도구

사용법:
  robinctl version                      버전 보기
  robinctl doctor                       시스템 점검
  robinctl audit                        보안 점검 (윈도우 보안처럼: 열린 포트, 원격 접속, 권한, 암호화)
  robinctl app remove <앱 ID> [--dry-run]  앱 제거 (런처에서 Shift+Delete, RobinOS 기본 앱은 막아요)
  robinctl update [--dry-run]           스냅샷을 만든 뒤 시스템 업데이트 (앱 스토어 앱도)
  robinctl snapshot create [이름]       스냅샷 만들기
  robinctl snapshot list                스냅샷 목록
  robinctl snapshot setup [--dry-run]   스냅샷 설정 (Btrfs 루트, 처음 한 번)
  robinctl snapshot rollback <번호>     그 스냅샷으로 시스템 되돌리기
  robinctl profile list                 보안 실습 프로필 보기 (network, web, ...)
  robinctl profile <이름> [--dry-run]   그 프로필의 도구 설치 (security는 전부)
  robinctl packages core                기본 패키지 목록
  robinctl packages <프로필>            보안 실습 프로필의 패키지 목록
  robinctl packages optional            선택 패키지 목록
  robinctl learn                        학습 미션(리눅스·네트워크·포렌식·리버싱·웹·셸·시스템·보안)과 진행도
  robinctl learn show [번호]            미션 설명 보기
  robinctl learn check [번호]           미션 결과 확인
  robinctl learn reset                  미션 진행도 초기화
  robinctl ctf                          입문 CTF 문제 10개와 푼 것
  robinctl ctf show <번호>              CTF 문제 보기
  robinctl ctf submit <번호> <플래그>   플래그 확인
  robinctl ctf reset                    CTF 기록 지우기 (문제 파일은 그대로)
  robinctl lab list                     실습 랩 목록
  robinctl lab info <web|net>           랩 안내 (web: 웹 보안, net: 네트워크 스캔)
  robinctl lab status <web|net>         랩 상태
  robinctl lab start <web|net>          랩 시작
  robinctl lab stop <web|net>           랩 중지

RobinOS는 허가받은 환경에서 보안을 배우는 시스템이에요.
실습은 내 컴퓨터 안의 랩과 허락받은 대상에서만 하세요.
EOF
}

die() {
  printf '오류: %s\n' "$*" >&2
  exit 1
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    die "관리자 권한이 필요해요. 앞에 sudo를 붙여 실행하세요."
  fi
}

package_file() {
  local file="$1"
  [[ -f "${file}" ]] || die "패키지 목록이 없어요: ${file}"
  grep -Ev '^\s*(#|$)' "${file}"
}

print_version() {
  printf '%s %s\n' "${ROBINOS_NAME}" "${ROBINOS_VERSION}"
}

# Prints one doctor line: "  <label>: 정상" or "  <label>: 없음[ (<hint>)]".
# ---- Security check (robinctl audit), like Windows Security's overview ----
#
# Read-only and without root: each line says what was found, why it matters and how
# to change it. It teaches as much as it checks, so it explains the "good" results too.

AUDIT_WARNINGS=0

audit_ok() {
  printf '  %s✓%s %s\n' "${C_GREEN}" "${C_RESET}" "$1"
  [[ -z "${2:-}" ]] || printf '    %s%s%s\n' "${C_DIM}" "$2" "${C_RESET}"
}

audit_warn() {
  AUDIT_WARNINGS=$((AUDIT_WARNINGS + 1))
  printf '  %s!%s %s\n' "${C_YELLOW}" "${C_RESET}" "$1"
  [[ -z "${2:-}" ]] || printf '    %s%s%s\n' "${C_DIM}" "$2" "${C_RESET}"
}

audit_section() {
  printf '\n%s%s%s\n' "${C_BOLD}" "$1" "${C_RESET}"
}

audit() {
  local listeners outside mode key keys=0 bad_keys=() fw="" crypt unit
  AUDIT_WARNINGS=0
  printf '%sRobinOS 보안 점검%s  %s바꾸는 것 없이 살펴보기만 해요%s\n' "${C_BOLD}" "${C_RESET}" "${C_DIM}" "${C_RESET}"

  audit_section "밖에서 닿는 서비스"
  if command -v ss >/dev/null 2>&1; then
    listeners="$(ss -Htuln 2>/dev/null | awk '{print $1 " " $5}' | sort -u)"
    # Loopback (127.0.0.1, ::1, systemd-resolved's 127.0.0.53%lo) is this computer only;
    # mDNS (Avahi, 5353/udp) finds printers; 68 and 546/udp are the DHCP client
    outside="$(printf '%s\n' "${listeners}" | grep -v -E ' (127\.[0-9.]+|\[::1\]|::1)(%[a-z0-9]+)?:[0-9]+$' \
      | grep -v -E '^udp .*:(5353|68|546)$' | grep -v '^$' || true)"
    if [[ -z "${outside}" ]]; then
      audit_ok "다른 컴퓨터가 접속할 수 있는 서비스가 없어요" "확인: ss -tuln (127.0.0.1은 이 컴퓨터 안에서만 닿아요)"
    else
      audit_warn "다른 컴퓨터가 접속할 수 있는 포트가 있어요: $(printf '%s' "${outside}" | awk '{print $2}' | tr '\n' ' ')" \
        "무엇인지 보기: sudo ss -tulnp. 모르는 서비스면 systemctl로 꺼요 (미션 9, 34)"
    fi
  else
    audit_warn "ss가 없어서 열린 포트를 못 봤어요" "sudo pacman -S iproute2"
  fi

  audit_section "원격 접속"
  if systemctl is-active --quiet sshd.service 2>/dev/null; then
    audit_warn "SSH 서버(sshd)가 켜져 있어요. 같은 네트워크에서 이 컴퓨터에 로그인을 시도할 수 있어요" \
      "쓰지 않으면: sudo systemctl disable --now sshd"
  else
    audit_ok "SSH 서버(sshd)는 꺼져 있어요" "다른 컴퓨터에 접속하는 ssh 명령은 그대로 쓸 수 있어요"
  fi

  audit_section "내 파일 권한"
  mode="$(stat -c %a "${HOME}" 2>/dev/null || true)"
  if [[ "${mode}" == "700" ]]; then
    audit_ok "홈 폴더는 나만 열 수 있어요 (700)"
  elif [[ -n "${mode}" ]]; then
    audit_warn "홈 폴더 권한이 ${mode}이에요. 다른 사용자가 안을 볼 수 있어요" "chmod 700 ~ (미션 37)"
  fi
  for key in "${HOME}"/.ssh/id_*; do
    [[ -f "${key}" && "${key}" != *.pub ]] || continue
    keys=$((keys + 1))
    [[ "$(stat -c %a "${key}")" == "600" ]] || bad_keys+=("${key##*/}")
  done
  if ((keys == 0)); then
    audit_ok "SSH 개인 열쇠가 없어요" "만들려면: ssh-keygen -t ed25519 (미션 38)"
  elif ((${#bad_keys[@]} == 0)); then
    audit_ok "SSH 개인 열쇠 ${keys}개는 나만 읽을 수 있어요 (600)"
  else
    audit_warn "SSH 개인 열쇠를 다른 사람도 읽을 수 있어요: ${bad_keys[*]}" "chmod 600 ~/.ssh/${bad_keys[0]}"
  fi

  audit_section "되돌리기와 업데이트"
  if [[ -d /run/archiso ]]; then
    audit_ok "라이브 세션이라 스냅샷은 없어요" "설치하면 업데이트 전마다 스냅샷이 생겨요"
  elif [[ -f /etc/snapper/configs/root ]]; then
    audit_ok "업데이트 전마다 스냅샷을 만들어요" "되돌리기: robinctl snapshot list, robinctl snapshot rollback <번호>"
  else
    audit_warn "스냅샷이 설정돼 있지 않아요. 업데이트가 잘못되면 되돌리기 어려워요" "sudo robinctl snapshot setup"
  fi
  audit_ok "업데이트는 빠른 설정의 \"업데이트\" 단추나 sudo robinctl update로 해요" "보안 고침은 대부분 업데이트로 와요"

  audit_section "방화벽과 디스크"
  for unit in nftables firewalld ufw; do
    if systemctl is-active --quiet "${unit}.service" 2>/dev/null; then
      fw="${unit}"
      break
    fi
  done
  if [[ -n "${fw}" ]]; then
    audit_ok "방화벽(${fw})이 켜져 있어요"
  else
    audit_ok "방화벽은 켜져 있지 않아요" "밖에서 닿는 서비스가 없으면(위) 괜찮아요. 공용 Wi-Fi에서 서비스를 켤 때는 방화벽을 생각해요"
  fi
  crypt="$(lsblk -nr -o TYPE 2>/dev/null | grep -c '^crypt$' || true)"
  if [[ "${crypt:-0}" -gt 0 ]]; then
    audit_ok "디스크가 암호화돼 있어요 (LUKS)"
  else
    audit_warn "디스크가 암호화돼 있지 않아요. 노트북을 잃어버리면 디스크를 떼어 내 파일을 읽을 수 있어요" \
      "암호화는 설치할 때 정해요. 중요한 파일만이라도 gpg -c로 잠가요 (미션 40)"
  fi

  printf '\n'
  if ((AUDIT_WARNINGS == 0)); then
    printf '%s살펴볼 것이 없어요.%s\n' "${C_GREEN}" "${C_RESET}"
  else
    printf '살펴볼 것 %s개. %s!%s 줄 아래의 방법을 참고해요.\n' "${AUDIT_WARNINGS}" "${C_YELLOW}" "${C_RESET}"
  fi
}

# ---- App removal (robinctl app remove), like the Start menu's "제거" ----
#
# Takes a desktop entry id (org.gnome.Calculator), finds the Flatpak or the pacman
# package behind it and removes that. Packages RobinOS needs (packages/core.txt and
# desktop.txt: the terminal, files, browser, the shell itself) are refused, so a
# learner can't uninstall their desktop by accident.
# Test hooks: ROBINOS_APP_DIRS (where .desktop files are), ROBINOS_APP_OWNER (the
# package to pretend owns the file), ROBINOS_NO_FLATPAK.

app_desktop_file() {
  local id="$1" dir
  local dirs="${ROBINOS_APP_DIRS:-${HOME:-/root}/.local/share/applications:/usr/local/share/applications:/usr/share/applications}"
  local IFS=:
  for dir in ${dirs}; do
    if [[ -f "${dir}/${id}.desktop" ]]; then
      printf '%s' "${dir}/${id}.desktop"
      return 0
    fi
  done
  return 1
}

app_owner() {
  if [[ -n "${ROBINOS_APP_OWNER:-}" ]]; then
    printf '%s' "${ROBINOS_APP_OWNER}"
  else
    pacman -Qqo "$1" 2>/dev/null
  fi
}

app_remove() {
  local id="${1:-}" dry="${2:-}" file pkg list
  [[ "${id}" =~ ^[A-Za-z0-9._-]+$ ]] || die "사용법: robinctl app remove <앱 ID> [--dry-run] (예: org.gnome.Calculator)"
  if [[ -z "${ROBINOS_NO_FLATPAK:-}" ]] && have_cmd flatpak && flatpak info "${id}" >/dev/null 2>&1; then
    printf '앱 스토어(Flathub)로 설치한 앱이에요: %s\n' "${id}"
    printf '실행: flatpak uninstall %s\n' "${id}"
    [[ "${dry}" == "--dry-run" ]] && return 0
    flatpak uninstall "${id}"
    return
  fi
  file="$(app_desktop_file "${id}")" || die "${id} 앱을 찾지 못했어요"
  pkg="$(app_owner "${file}")" || die "패키지로 설치한 앱이 아니에요: ${file} (직접 지워도 돼요)"
  [[ -n "${pkg}" ]] || die "패키지로 설치한 앱이 아니에요: ${file}"
  for list in "${PROJECT_ROOT}/packages/core.txt" "${PROJECT_ROOT}/packages/desktop.txt"; do
    if [[ -f "${list}" ]] && package_file "${list}" | grep -qx -- "${pkg}"; then
      die "${pkg}는 RobinOS 기본 구성에 들어 있는 앱이라 지우지 않아요 (packages/core.txt, desktop.txt)"
    fi
  done
  printf '%s 앱은 %s 패키지예요. 같이 깔린 것 중 다른 데서 안 쓰는 것도 함께 지워요.\n' "${id}" "${pkg}"
  printf '실행: sudo pacman -Rns %s\n' "${pkg}"
  [[ "${dry}" == "--dry-run" ]] && return 0
  sudo pacman -Rns "${pkg}"
}

app() {
  case "${1:-}" in
    remove)
      app_remove "${2:-}" "${3:-}"
      ;;
    *)
      die "사용법: robinctl app remove <앱 ID> [--dry-run]"
      ;;
  esac
}

check_line() {
  local label="$1"
  local found="$2"
  local hint="${3:-}"

  if [[ "${found}" == "true" ]]; then
    printf '  %s: 정상\n' "${label}"
  elif [[ -n "${hint}" ]]; then
    printf '  %s: 없음 (%s)\n' "${label}" "${hint}"
  else
    printf '  %s: 없음\n' "${label}"
  fi
}

cmd_found() {
  if have_cmd "$1"; then printf 'true'; else printf 'false'; fi
}

path_found() {
  if [[ -e "$1" ]]; then printf 'true'; else printf 'false'; fi
}

# NVIDIA display controllers (vendor 0x10de, class 0x03xxxx), the way
# installer/robin-install finds them. Prints how the driver is doing, or
# nothing without such a card. ROBINOS_PCI_DEVICES and ROBINOS_NVIDIA_MODULE
# point elsewhere in tests.
nvidia_gpu_state() {
  local dir="${ROBINOS_PCI_DEVICES:-/sys/bus/pci/devices}" dev newest=-1
  for dev in "${dir}"/*; do
    [[ -r "${dev}/vendor" && -r "${dev}/class" && -r "${dev}/device" ]] || continue
    [[ "$(<"${dev}/vendor")" == "0x10de" && "$(<"${dev}/class")" == 0x03* ]] || continue
    if (($(<"${dev}/device") > newest)); then
      newest=$(($(<"${dev}/device")))
    fi
  done
  if ((newest < 0)); then
    return 0
  elif ((newest < 0x1e00)); then
    printf '오래된 카드라 기본 드라이버(nouveau)를 써요'
  elif [[ -d "${ROBINOS_NVIDIA_MODULE:-/sys/module/nvidia}" ]]; then
    printf 'NVIDIA 드라이버(nvidia-open)를 쓰고 있어요'
  elif pkg_installed nvidia-open; then
    printf '드라이버가 설치됐지만 떠 있지 않아요 (재부팅해 보고, 그래도 안 되면 journalctl -b | grep -i nvidia)'
  else
    printf '드라이버가 없어요 (sudo pacman -S nvidia-open 뒤 재부팅)'
  fi
}

doctor() {
  print_version
  printf '\n시스템 점검:\n'

  local os_name="알 수 없음"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_name="${PRETTY_NAME:-${NAME:-알 수 없음}}"
    # Arch's wiki and forums answer most questions, so say what RobinOS is built on
    if [[ "${ID:-}" != "arch" && " ${ID_LIKE:-} " == *" arch "* ]]; then
      os_name="${os_name} (Arch Linux 기반)"
    fi
  fi
  printf '  OS: %s\n' "${os_name}"

  check_line "pacman" "$(cmd_found pacman)"
  check_line "systemd" "$(cmd_found systemctl)"
  check_line "snapper" "$(cmd_found snapper)"
  check_line "docker" "$(cmd_found docker)"

  local compose="false"
  if have_cmd docker && docker compose version >/dev/null 2>&1; then
    compose="true"
  fi
  check_line "docker compose" "${compose}"

  check_line "fcitx5 (한글 입력)" "$(cmd_found fcitx5)"

  local korean="false"
  if have_cmd locale && locale -a 2>/dev/null | grep -qi '^ko_kr\.utf'; then
    korean="true"
  fi
  check_line "한국어 로캘" "${korean}"

  check_line "설정 파일" "$(path_found "${CONFIG_FILE}")" "${CONFIG_FILE}"
  check_line "Hyprland" "$(cmd_found Hyprland)"
  check_line "Quickshell" "$(cmd_found qs)"

  local shell_ok="false"
  if [[ -f "${SHELL_DIR}/shell.qml" && -f "${SESSION_FILE}" ]]; then
    shell_ok="true"
  fi
  check_line "RobinOS 셸" "${shell_ok}" "scripts/install-desktop.sh를 실행하세요"

  if [[ -n "${ROBINOS_RENDER:-}" ]]; then
    printf '  렌더링: %s\n' "${ROBINOS_RENDER}"
  fi

  local gpu
  gpu="$(nvidia_gpu_state)"
  if [[ -n "${gpu}" ]]; then
    printf '  NVIDIA 그래픽 카드: %s\n' "${gpu}"
  fi

  # Printing comes with the installed system (packages/apps.txt)
  if have_cmd lpstat; then
    local cups="false"
    if systemctl is-enabled --quiet cups.socket 2>/dev/null; then cups="true"; fi
    check_line "인쇄 서비스 (CUPS)" "${cups}" "sudo systemctl enable --now cups.socket"
  fi

  check_line "로그인 화면 테마 (SDDM)" "$(path_found "${SDDM_THEME_DIR}")"
  check_line "부팅 메뉴 테마 (GRUB)" "$(path_found "${GRUB_THEME_FILE}")"

  local fstype
  fstype="$(root_fstype)"
  if [[ "${fstype}" == "btrfs" ]]; then
    printf '  루트 파일 시스템: btrfs\n'
    check_line "스냅샷 설정 (snapper)" "$(path_found "${SNAPPER_CONFIG}")" "sudo robinctl snapshot setup"
    local snap_pac="false" grub_btrfs="false"
    if pkg_installed snap-pac; then snap_pac="true"; fi
    if systemctl is-enabled --quiet grub-btrfsd.service 2>/dev/null; then grub_btrfs="true"; fi
    check_line "업데이트 자동 스냅샷 (snap-pac)" "${snap_pac}" "sudo robinctl snapshot setup"
    check_line "부팅 메뉴 스냅샷 (grub-btrfs)" "${grub_btrfs}" "sudo robinctl snapshot setup"
  elif [[ "${fstype}" == "overlay" ]] && root_on_btrfs; then
    printf '  루트 파일 시스템: 스냅샷으로 부팅한 상태예요. 바꾼 내용은 재부팅하면 사라져요.\n'
    printf '    이 상태로 되돌리려면: sudo robinctl snapshot rollback <번호>\n'
  else
    printf '  루트 파일 시스템: %s (스냅샷은 Btrfs 설치에서만 써요)\n' "${fstype}"
  fi
}

update_system() {
  local dry_run="false"
  [[ "${1:-}" == "--dry-run" ]] && dry_run="true"

  have_cmd pacman || die "pacman이 필요해요"

  # snap-pac takes pre/post snapshots around every pacman transaction once the
  # root config exists; otherwise take one ourselves when we can.
  local mode="none"
  if snapshot_ready && pkg_installed snap-pac; then
    mode="snap-pac"
  elif snapshot_ready; then
    mode="manual"
  fi

  if [[ "${dry_run}" == "true" ]]; then
    case "${mode}" in
      snap-pac) printf '업데이트 전후 스냅샷은 snap-pac이 자동으로 만들어요.\n' ;;
      manual) printf '업데이트 전에 스냅샷을 만들어요.\n' ;;
      none) printf '스냅샷이 설정되지 않아서 업데이트 전 스냅샷을 만들지 않아요 (설정: sudo robinctl snapshot setup).\n' ;;
    esac
    printf '실행할 명령: pacman -Syu\n'
    if have_cmd flatpak; then
      printf '앱 스토어(Flatpak) 앱이 있으면 이어서: flatpak update --system\n'
    fi
    return
  fi

  need_root
  case "${mode}" in
    manual)
      snapper --no-dbus -c root create --description "RobinOS before update" --cleanup-algorithm number
      ;;
    none)
      printf '%s알림:%s 스냅샷이 설정되지 않아서 업데이트 전 스냅샷 없이 진행해요. 설정: sudo robinctl snapshot setup\n' \
        "${C_YELLOW}" "${C_RESET}" >&2
      ;;
  esac
  pacman -Syu

  # Apps from the app store (Flathub) live outside pacman and its snapshots
  if have_cmd flatpak && [[ -n "$(flatpak list --system --app --columns=application 2>/dev/null)" ]]; then
    printf '\n앱 스토어(Flatpak) 앱을 업데이트해요.\n'
    flatpak update --system
  fi
}

# ---- Snapshots: snapper + snap-pac + grub-btrfs on a Btrfs root ----
#
# Layout: the system is the @ subvolume, and snapshots live in a top-level
# @snapshots subvolume mounted on /.snapshots, so any snapshot can become the
# new @ (rollback) without being inside the old one. archinstall's default
# Btrfs layout (@, @home, @log, @pkg) has no @snapshots; `snapshot setup`
# creates it and adds it to fstab. Details for users: docs/recovery.md.
#
# Root runs snapper with --no-dbus so this also works from a chroot.

readonly SNAPPER_CONFIG="/etc/snapper/configs/root"
readonly SNAPSHOT_PACKAGES=(snapper snap-pac grub-btrfs inotify-tools rsync)
readonly BOOT_BACKUP_DIR="/.bootbackup"
ASSUME_YES="${ROBINOS_ASSUME_YES:-false}"

pkg_installed() {
  have_cmd pacman && pacman -Q "$1" >/dev/null 2>&1
}

root_fstype() {
  findmnt -no FSTYPE / 2>/dev/null || printf '알 수 없음'
}

# "/dev/vda2" from "/dev/vda2[/@]". After booting a snapshot from the GRUB menu
# with the grub-btrfs-overlayfs hook, / is an overlay in memory on top of the
# snapshot, so the device comes from the kernel's root= instead.
root_device() {
  if [[ "$(root_fstype)" == "overlay" ]]; then
    local root_arg
    root_arg="$(sed -E -n 's/(^|.* )root=([^ ]+).*/\2/p' /proc/cmdline)"
    findfs "${root_arg}" 2>/dev/null || printf '%s' "${root_arg}"
    return
  fi
  findmnt -no SOURCE / | sed 's/\[.*//'
}

# True when the system runs from Btrfs, also from a snapshot booted with an overlay
root_on_btrfs() {
  [[ "$(root_fstype)" == "btrfs" ]] ||
    [[ "$(lsblk -no FSTYPE "$(root_device)" 2>/dev/null)" == "btrfs" ]]
}

snapshot_ready() {
  [[ -f "${SNAPPER_CONFIG}" ]]
}

# Where grub.cfg lives: /boot/grub, or /efi/grub when the EFI partition is on /efi
grub_dir() {
  local dir
  for dir in /boot/grub /efi/grub /boot/efi/grub; do
    if [[ -f "${dir}/grub.cfg" ]]; then
      printf '%s' "${dir}"
      return
    fi
  done
}

# True when /boot is the EFI partition, which Btrfs snapshots don't include
boot_is_esp() {
  [[ "$(findmnt -no FSTYPE /boot 2>/dev/null)" == "vfat" ]]
}

# With /boot on the EFI partition, keep a copy of it in / around every kernel
# change so each snapshot carries its kernel (Arch wiki: Snapper, "Backup non-Btrfs
# boot partition"). 04- runs before snap-pac's pre snapshot, zy- after mkinitcpio
# and before snap-pac's post snapshot.
write_boot_backup_hooks() {
  local when name
  mkdir -p /etc/pacman.d/hooks
  for when in PreTransaction PostTransaction; do
    name="04-robinos-boot-backup.hook"
    [[ "${when}" == "PostTransaction" ]] && name="zy-robinos-boot-backup.hook"
    cat >"/etc/pacman.d/hooks/${name}" <<EOF
# RobinOS: copy the EFI /boot into ${BOOT_BACKUP_DIR} so snapshots include the
# kernel. Written by robinctl snapshot setup; restored by robinctl snapshot rollback.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = boot/*

[Action]
Description = Backing up /boot for snapshots...
When = ${when}
Exec = /usr/bin/rsync -a --delete --exclude=/grub /boot/ ${BOOT_BACKUP_DIR}/
EOF
  done
}

need_snapshots() {
  snapshot_ready || die "스냅샷이 아직 설정되지 않았어요. 먼저 실행하세요: sudo robinctl snapshot setup"
}

# Mounts the top level (subvolid=5) of the root filesystem and prints where.
mount_btrfs_top() {
  local dir
  dir="$(mktemp -d /tmp/robinos-btrfs.XXXXXX)"
  mount -o subvolid=5 "$(root_device)" "${dir}"
  printf '%s' "${dir}"
}

unmount_btrfs_top() {
  umount "$1" && rmdir "$1"
}

snapshot_create() {
  need_root
  need_snapshots

  # Descriptions show up in the GRUB snapshot menu, where grub-btrfs prints
  # snapper's XML escapes for non-ASCII text (&#xC2A4;...), so keep them ASCII
  local name="${1:-manual}"
  if [[ -n "$(printf '%s' "${name}" | LC_ALL=C tr -d '\040-\176')" ]]; then
    printf '%s알림:%s 부팅 메뉴에서는 영어만 제대로 보여서 스냅샷 이름을 "manual"로 바꿔 저장해요.\n' \
      "${C_YELLOW}" "${C_RESET}" >&2
    name="manual"
  fi
  snapper --no-dbus -c root create --description "RobinOS ${name}" --print-number
}

snapshot_list() {
  need_snapshots
  if [[ "${EUID}" -eq 0 ]]; then
    snapper --no-dbus -c root list
  else
    snapper -c root list
  fi
}

# Runs a setup step, or only prints it with --dry-run.
setup_step() {
  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '  %s\n' "$*"
  else
    "$@"
  fi
}

# Enables a unit, and starts it too unless we are in a chroot (robin-install).
setup_enable() {
  setup_step systemctl enable "$1"
  if [[ -d /run/systemd/system ]] && ! systemd-detect-virt --quiet --chroot 2>/dev/null; then
    setup_step systemctl start "$1"
  fi
}

# Creates the top-level @snapshots subvolume and its fstab line if missing.
setup_snapshot_subvolume() {
  if [[ "$(findmnt -no FSROOT /)" != "/@" ]]; then
    printf '  루트가 @ 하위 볼륨이 아니에요 (%s). 되돌리기는 @ 기준이라 직접 해야 할 수 있어요.\n' \
      "$(findmnt -no FSROOT /)"
  fi

  if findmnt --fstab -n /.snapshots >/dev/null 2>&1; then
    printf '  fstab에 /.snapshots가 이미 있어요\n'
    return
  fi

  # Same mount options as /, pointed at @snapshots
  local options line
  options="$(findmnt --fstab -no OPTIONS / | sed -E 's/(^|,)subvolid=[0-9]+//; s#subvol=[^,]*#subvol=/@snapshots#; s/^,//')"
  [[ "${options}" == *subvol=/@snapshots* ]] || options="${options:+${options},}subvol=/@snapshots"
  line="UUID=$(findmnt -no UUID /) /.snapshots btrfs ${options} 0 0"

  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '  btrfs subvolume create <Btrfs 최상위>/@snapshots\n'
    printf '  /etc/fstab에 추가: %s\n' "${line}"
    return
  fi

  local top
  top="$(mount_btrfs_top)"
  if [[ ! -d "${top}/@snapshots" ]]; then
    btrfs subvolume create "${top}/@snapshots"
  fi
  unmount_btrfs_top "${top}"

  printf '\n# Snapshots (robinctl snapshot setup)\n%s\n' "${line}" >>/etc/fstab
  systemctl daemon-reload 2>/dev/null || true
}

# snapper wants to create /.snapshots itself. Let it, then swap the nested
# subvolume it made for @snapshots from fstab (Arch wiki: Snapper).
setup_snapper_config() {
  if mountpoint -q /.snapshots; then
    setup_step umount /.snapshots
  fi
  if [[ -d /.snapshots ]]; then
    if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
      printf '  rmdir /.snapshots\n'
    else
      rmdir /.snapshots || die "/.snapshots 폴더가 비어 있지 않아요. 안의 파일을 옮긴 뒤 다시 실행하세요."
    fi
  fi

  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '  snapper --no-dbus -c root create-config /\n'
  elif ! snapper --no-dbus -c root create-config /; then
    # Leave fstab's mount point usable, or the next boot stops at it
    mkdir -p /.snapshots
    mount /.snapshots || true
    die "snapper 설정을 만들지 못했어요. /.snapshots는 원래대로 돌려놨어요."
  fi

  setup_step btrfs subvolume delete /.snapshots
  setup_step mkdir /.snapshots
  setup_step mount /.snapshots
}

snapshot_setup() {
  SETUP_DRY_RUN="false"
  [[ "${1:-}" == "--dry-run" ]] && SETUP_DRY_RUN="true"

  local fstype
  fstype="$(root_fstype)"
  [[ "${fstype}" == "btrfs" ]] ||
    die "루트(/)가 Btrfs가 아니에요 (지금: ${fstype}). 스냅샷은 Btrfs로 설치한 시스템에서만 써요."

  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '실행할 명령:\n'
  else
    need_root
  fi

  local pacman_args=(-S --needed)
  [[ "${ASSUME_YES}" == "true" ]] && pacman_args+=(--noconfirm)

  printf '%s1. 필요한 패키지%s\n' "${C_BOLD}" "${C_RESET}"
  setup_step pacman "${pacman_args[@]}" "${SNAPSHOT_PACKAGES[@]}"

  printf '%s2. 스냅샷 저장 공간과 설정%s\n' "${C_BOLD}" "${C_RESET}"
  if snapshot_ready; then
    printf '  이미 설정돼 있어요 (%s)\n' "${SNAPPER_CONFIG}"
  else
    setup_snapshot_subvolume
    setup_snapper_config
  fi
  setup_step chmod 750 /.snapshots
  setup_step snapper --no-dbus -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 \
    ALLOW_GROUPS=wheel SYNC_ACL=yes
  setup_enable snapper-cleanup.timer

  if boot_is_esp; then
    printf '  /boot가 EFI 파티션이라 커널을 %s에 복사해 스냅샷에 같이 남겨요\n' "${BOOT_BACKUP_DIR}"
    if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
      printf '  /etc/pacman.d/hooks/04-robinos-boot-backup.hook, zy-robinos-boot-backup.hook 쓰기\n'
    else
      write_boot_backup_hooks
    fi
    setup_step rsync -a --delete --exclude=/grub /boot/ "${BOOT_BACKUP_DIR}/"
  fi

  local grub
  grub="$(grub_dir)"

  printf '%s3. 부팅 메뉴의 스냅샷 항목 (grub-btrfs)%s\n' "${C_BOLD}" "${C_RESET}"
  if [[ -n "${grub}" ]] && have_cmd grub-mkconfig; then
    if [[ "${grub}" != "/boot/grub" ]]; then
      setup_step sed -i -E "s|^#?GRUB_BTRFS_GRUB_DIRNAME=.*|GRUB_BTRFS_GRUB_DIRNAME=\"${grub}\"|" \
        /etc/default/grub-btrfs/config
    fi
    # Without this grub-btrfs names the submenu after os-release ("Arch Linux snapshots")
    setup_step sed -i -E 's|^#?GRUB_BTRFS_SUBMENUNAME=.*|GRUB_BTRFS_SUBMENUNAME="RobinOS snapshots"|' \
      /etc/default/grub-btrfs/config
    setup_enable grub-btrfsd.service

    # Snapshots boot read-only; this initramfs hook gives them a writable
    # overlay in memory. It is a busybox runtime hook, so only for udev images.
    if grep -q 'grub-btrfs-overlayfs' /etc/mkinitcpio.conf; then
      printf '  읽기 전용 스냅샷 부팅 준비: 이미 돼 있어요\n'
    elif grep -Eq '^HOOKS=\(.*\budev\b' /etc/mkinitcpio.conf; then
      setup_step sed -i -E 's/^(HOOKS=\(.*)\)/\1 grub-btrfs-overlayfs)/' /etc/mkinitcpio.conf
      setup_step mkinitcpio -P
    else
      printf '  initramfs가 systemd 방식이라 grub-btrfs-overlayfs를 넣지 않았어요. 스냅샷은 읽기 전용으로 부팅돼요.\n'
    fi
  else
    printf '  GRUB을 찾지 못해서 건너뛰어요. 부팅 메뉴에서 스냅샷을 고르려면 GRUB으로 설치해야 해요.\n'
  fi

  printf '%s4. 첫 스냅샷%s\n' "${C_BOLD}" "${C_RESET}"
  setup_step snapper --no-dbus -c root create --description "RobinOS snapshot setup" --userdata important=yes

  # After the first snapshot, so the boot menu lists it right away
  if [[ -n "${grub}" ]] && have_cmd grub-mkconfig; then
    setup_step grub-mkconfig -o "${grub}/grub.cfg"
  fi

  if [[ "${SETUP_DRY_RUN}" != "true" ]]; then
    printf '\n스냅샷 준비가 끝났어요. 이제 pacman으로 설치하거나 업데이트할 때마다 전후 스냅샷이 생겨요.\n'
    printf '목록: robinctl snapshot list · 되돌리기: sudo robinctl snapshot rollback <번호>\n'
  fi
}

# Makes snapshot N the system: the current @ is kept as @.broken-<time> and a
# writable copy of the snapshot becomes @. Takes effect after a reboot. Works
# from the normal system or after booting the snapshot from the GRUB menu.
snapshot_rollback() {
  local number="${1:-}"
  [[ "${number}" =~ ^[0-9]+$ ]] ||
    die "사용법: sudo robinctl snapshot rollback <번호> (번호는 robinctl snapshot list에서 봐요)"
  [[ "${2:-}" == "--yes" ]] && ASSUME_YES="true"
  need_root
  root_on_btrfs || die "루트(/)가 Btrfs가 아니에요"

  local top source info description date stamp
  top="$(mount_btrfs_top)"
  source="${top}/@snapshots/${number}/snapshot"
  if [[ ! -d "${source}" ]]; then
    unmount_btrfs_top "${top}"
    die "스냅샷 ${number}번을 찾지 못했어요 (@snapshots/${number}). robinctl snapshot list로 번호를 확인하세요."
  fi
  if [[ ! -d "${top}/@" ]]; then
    unmount_btrfs_top "${top}"
    die "@ 하위 볼륨이 없어서 자동으로 되돌릴 수 없어요. docs/recovery.md를 보고 직접 되돌리세요."
  fi

  info="${top}/@snapshots/${number}/info.xml"
  description="$(sed -n 's:.*<description>\(.*\)</description>.*:\1:p' "${info}" 2>/dev/null)"
  date="$(sed -n 's:.*<date>\(.*\)</date>.*:\1:p' "${info}" 2>/dev/null)"
  printf '스냅샷 %s번: %s (%s UTC)\n' "${number}" "${description:-설명 없음}" "${date:-날짜 모름}"
  printf '지금 시스템은 @.broken-<시각>으로 남겨 두고, 이 스냅샷으로 시스템을 되돌려요. /home의 내 파일은 그대로예요.\n'

  if [[ "${ASSUME_YES}" != "true" ]]; then
    local answer
    printf '되돌릴까요? [y/N] '
    read -r answer || answer=""
    case "${answer}" in
      y|Y|yes|ㅛ) ;;
      *)
        unmount_btrfs_top "${top}"
        printf '그만뒀어요.\n'
        return
        ;;
    esac
  fi

  stamp="$(date +%Y%m%d-%H%M%S)"
  mv "${top}/@" "${top}/@.broken-${stamp}"
  if ! btrfs subvolume snapshot "${source}" "${top}/@"; then
    mv "${top}/@.broken-${stamp}" "${top}/@"
    unmount_btrfs_top "${top}"
    die "스냅샷을 복사하지 못해서 원래대로 뒀어요."
  fi
  # snap-pac takes "pre" snapshots while pacman holds its lock, so they carry
  # db.lck; left in place, pacman would refuse to run after the rollback
  rm -f "${top}/@/var/lib/pacman/db.lck"

  # The EFI /boot is not in the snapshot: put back the kernel it was taken with,
  # from the copy the boot backup hooks keep in /.bootbackup.
  local kernel_restored="false"
  if boot_is_esp && compgen -G "${top}/@${BOOT_BACKUP_DIR}/vmlinuz-*" >/dev/null; then
    cp -f "${top}/@${BOOT_BACKUP_DIR}"/vmlinuz-* /boot/
    cp -f "${top}/@${BOOT_BACKUP_DIR}"/initramfs-*.img /boot/ 2>/dev/null || true
    cp -f "${top}/@${BOOT_BACKUP_DIR}"/*-ucode.img /boot/ 2>/dev/null || true
    kernel_restored="true"
  fi
  unmount_btrfs_top "${top}"

  printf '\n%s되돌렸어요.%s 다시 시작하면 스냅샷 %s번 상태로 켜져요: sudo reboot\n' \
    "${C_GREEN}${C_BOLD}" "${C_RESET}" "${number}"
  if [[ "${kernel_restored}" == "true" ]]; then
    printf 'EFI 파티션의 커널도 그 시점의 것으로 바꿨어요.\n'
  elif boot_is_esp; then
    printf '%s알림:%s 이 스냅샷에는 커널 사본(%s)이 없어서 커널은 그대로예요. 재부팅 뒤 문제가 있으면 sudo pacman -S linux로 맞춰 주세요.\n' \
      "${C_YELLOW}" "${C_RESET}" "${BOOT_BACKUP_DIR}"
  fi
  printf '잘 되는 걸 확인한 뒤 이전 시스템(@.broken-%s)을 지우는 방법은 docs/recovery.md에 있어요.\n' "${stamp}"
}

# ---- Security learning profiles ----
#
# Security tools are installed a profile at a time as the learner gets there,
# so the everyday system stays light (docs/design.md). The profiles are the
# "# profile: <name>" sections of packages/security-baseline.txt; "security"
# is all of them.

readonly PROFILES=(network web forensics reversing passwords wireless vm)

profile_title() {
  case "$1" in
    network) printf '네트워크 분석' ;;
    web) printf '웹 보안 (로컬 웹 랩 포함)' ;;
    forensics) printf '포렌식' ;;
    reversing) printf '리버싱' ;;
    passwords) printf '비밀번호 크래킹' ;;
    wireless) printf '무선 보안' ;;
    vm) printf '가상 머신 실습' ;;
    security) printf '위 프로필 전부' ;;
  esac
}

profile_known() {
  local name
  [[ "$1" == "security" ]] && return 0
  for name in "${PROFILES[@]}"; do
    [[ "${name}" == "$1" ]] && return 0
  done
  return 1
}

# Packages of a profile, one per line
profile_packages() {
  [[ -f "${SECURITY_PACKAGES}" ]] || die "패키지 목록이 없어요: ${SECURITY_PACKAGES}"
  awk -v want="$1" '
    /^# profile: / { current = $3; next }
    /^[[:space:]]*(#|$)/ { next }
    want == "security" || current == want { print $1 }
  ' "${SECURITY_PACKAGES}"
}

profile_list() {
  local name
  printf '보안 실습 프로필 (배우는 순서):\n'
  for name in "${PROFILES[@]}" security; do
    printf '  %-10s %s\n' "${name}" "$(profile_title "${name}")"
    if [[ "${name}" != "security" ]]; then
      printf '             %s%s%s\n' "${C_DIM}" "$(profile_packages "${name}" | tr '\n' ' ')" "${C_RESET}"
    fi
  done
  printf '\n미리 보기: robinctl profile <이름> --dry-run\n'
  printf '설치:      sudo robinctl profile <이름>\n'
}

profile_install() {
  local name="$1" dry_run="false"
  [[ "${2:-}" == "--dry-run" ]] && dry_run="true"

  have_cmd pacman || die "pacman이 필요해요"
  local packages=()
  mapfile -t packages < <(profile_packages "${name}")
  [[ "${#packages[@]}" -gt 0 ]] || die "프로필 ${name}에 패키지가 없어요"

  if [[ "${dry_run}" == "true" ]]; then
    printf '%s 프로필(%s)로 설치할 패키지:\n' "${name}" "$(profile_title "${name}")"
    printf '  %s\n' "${packages[@]}"
    return
  fi

  need_root
  local pacman_args=(-S --needed)
  [[ "${ASSUME_YES}" == "true" ]] && pacman_args+=(--noconfirm)
  pacman "${pacman_args[@]}" "${packages[@]}"
  printf '\n%s 프로필을 설치했어요. 도구는 내 컴퓨터의 랩이나 허가받은 대상에서만 써요(docs/ethics.md).\n' "${name}"
}

packages_print() {
  case "${1:-}" in
    core)
      package_file "${CORE_PACKAGES}"
      ;;
    optional)
      package_file "${OPTIONAL_PACKAGES}"
      ;;
    *)
      if [[ -n "${1:-}" ]] && profile_known "$1"; then
        profile_packages "$1"
      else
        die "알 수 없는 패키지 묶음이에요: ${1:-} (core, optional, 보안 프로필 이름 중 하나: robinctl profile list)"
      fi
      ;;
  esac
}

# ---- Learning missions: Linux basics (1-5), network basics (6-10), forensics basics (11-15),
# reversing basics (16-20), web basics (21-25), shell basics (26-30), system basics (31-35),
# security basics (36-40) ----
#
# Missions are solved in a real terminal. `robinctl learn check N` looks at the
# result (files under ~/practice) and records progress in the user's state dir.
# The network missions work without the internet except mission 8, which
# installs the network profile. The forensics missions work on practice files
# robinctl makes under ~/practice/forensics; 13 and 14 need the forensics profile.
# The reversing missions work on small practice programs (practice/reversing/*.c)
# put in ~/practice/reversing; 18 and 19 need ltrace and strace (in the live ISO and
# the reversing profile, or pacman -S on their own). The web basics missions talk to a
# practice server (practice/web/server.py) that only listens on 127.0.0.1:8000.
# The shell basics missions need nothing but bash; their files go to ~/practice/shell.
# The system basics missions (processes, disk, services, logs) write to ~/practice/system.
# The security basics missions (users, permissions, SSH keys, checksums, encryption)
# work in ~/practice/security; 38 makes a key in ~/.ssh with the user's own ssh-keygen.
# The text missions (grep -c, sort | uniq -c, awk, sed, diff) work on ~/practice/text:
# a web server log, a config file and two user lists, made the first time one is shown.

readonly LEARN_COUNT=45
LEARN_DIR="${HOME:-/root}/practice"
LEARN_NET="${HOME:-/root}/practice/net"
LEARN_FOR="${HOME:-/root}/practice/forensics"
LEARN_REV="${HOME:-/root}/practice/reversing"
LEARN_WEB="${HOME:-/root}/practice/web"
LEARN_SHELL="${HOME:-/root}/practice/shell"
LEARN_SYSTEM="${HOME:-/root}/practice/system"
LEARN_SEC="${HOME:-/root}/practice/security"
LEARN_TEXT="${HOME:-/root}/practice/text"
LEARN_STATE="${XDG_STATE_HOME:-${HOME:-/root}/.local/state}/robinos/learn"
LEARN_FAILS=0

