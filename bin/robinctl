#!/usr/bin/env bash
set -euo pipefail

readonly ROBINOS_NAME="RobinOS"
readonly ROBINOS_VERSION="0.1.0-dev"
readonly CONFIG_FILE="/etc/robinos/config.toml"
readonly SHELL_DIR="/usr/share/robinos/shell"
readonly SESSION_FILE="/usr/share/wayland-sessions/robinos.desktop"
readonly SDDM_THEME_DIR="/usr/share/sddm/themes/robinos"
readonly GRUB_THEME_FILE="/usr/share/grub/themes/robinos/theme.txt"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
if [[ -d /opt/robinos ]]; then
  PROJECT_ROOT="/opt/robinos"
fi

CORE_PACKAGES="${PROJECT_ROOT}/packages/core.txt"
SECURITY_PACKAGES="${PROJECT_ROOT}/packages/security-baseline.txt"
OPTIONAL_PACKAGES="${PROJECT_ROOT}/packages/security-optional.txt"

if [[ -t 1 ]]; then
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'
  C_RED=$'\033[31m'
  C_YELLOW=$'\033[33m'
  C_RESET=$'\033[0m'
else
  C_BOLD="" C_DIM="" C_GREEN="" C_RED="" C_YELLOW="" C_RESET=""
fi

usage() {
  cat <<'EOF'
robinctl - RobinOS 관리 도구

사용법:
  robinctl version                      버전 보기
  robinctl doctor                       시스템 점검
  robinctl update [--dry-run]           스냅샷을 만든 뒤 시스템 업데이트 (앱 스토어 앱도)
  robinctl snapshot create [이름]       스냅샷 만들기
  robinctl snapshot list                스냅샷 목록
  robinctl snapshot setup [--dry-run]   스냅샷 설정 (Btrfs 루트, 처음 한 번)
  robinctl snapshot rollback <번호>     그 스냅샷으로 시스템 되돌리기
  robinctl profile list                 보안 실습 프로필 보기 (network, web, ...)
  robinctl profile <이름> [--dry-run]   그 프로필의 도구 설치 (security는 전부)
  robinctl packages core                기본 패키지 목록
  robinctl packages <프로필>            보안 실습 프로필의 패키지 목록
  robinctl packages optional            선택 패키지 목록
  robinctl learn                        학습 미션(리눅스·네트워크·포렌식·리버싱·웹)과 진행도
  robinctl learn show [번호]            미션 설명 보기
  robinctl learn check [번호]           미션 결과 확인
  robinctl learn reset                  미션 진행도 초기화
  robinctl lab list                     실습 랩 목록
  robinctl lab info web                 웹 보안 랩 안내
  robinctl lab status web               웹 보안 랩 상태
  robinctl lab start web                웹 보안 랩 시작
  robinctl lab stop web                 웹 보안 랩 중지

RobinOS는 허가받은 환경에서 보안을 배우는 시스템이에요.
실습은 내 컴퓨터 안의 랩과 허락받은 대상에서만 하세요.
EOF
}

die() {
  printf '오류: %s\n' "$*" >&2
  exit 1
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    die "관리자 권한이 필요해요. 앞에 sudo를 붙여 실행하세요."
  fi
}

package_file() {
  local file="$1"
  [[ -f "${file}" ]] || die "패키지 목록이 없어요: ${file}"
  grep -Ev '^\s*(#|$)' "${file}"
}

print_version() {
  printf '%s %s\n' "${ROBINOS_NAME}" "${ROBINOS_VERSION}"
}

# Prints one doctor line: "  <label>: 정상" or "  <label>: 없음[ (<hint>)]".
check_line() {
  local label="$1"
  local found="$2"
  local hint="${3:-}"

  if [[ "${found}" == "true" ]]; then
    printf '  %s: 정상\n' "${label}"
  elif [[ -n "${hint}" ]]; then
    printf '  %s: 없음 (%s)\n' "${label}" "${hint}"
  else
    printf '  %s: 없음\n' "${label}"
  fi
}

cmd_found() {
  if have_cmd "$1"; then printf 'true'; else printf 'false'; fi
}

path_found() {
  if [[ -e "$1" ]]; then printf 'true'; else printf 'false'; fi
}

# NVIDIA display controllers (vendor 0x10de, class 0x03xxxx), the way
# installer/robin-install finds them. Prints how the driver is doing, or
# nothing without such a card. ROBINOS_PCI_DEVICES and ROBINOS_NVIDIA_MODULE
# point elsewhere in tests.
nvidia_gpu_state() {
  local dir="${ROBINOS_PCI_DEVICES:-/sys/bus/pci/devices}" dev newest=-1
  for dev in "${dir}"/*; do
    [[ -r "${dev}/vendor" && -r "${dev}/class" && -r "${dev}/device" ]] || continue
    [[ "$(<"${dev}/vendor")" == "0x10de" && "$(<"${dev}/class")" == 0x03* ]] || continue
    if (($(<"${dev}/device") > newest)); then
      newest=$(($(<"${dev}/device")))
    fi
  done
  if ((newest < 0)); then
    return 0
  elif ((newest < 0x1e00)); then
    printf '오래된 카드라 기본 드라이버(nouveau)를 써요'
  elif [[ -d "${ROBINOS_NVIDIA_MODULE:-/sys/module/nvidia}" ]]; then
    printf 'NVIDIA 드라이버(nvidia-open)를 쓰고 있어요'
  elif pkg_installed nvidia-open; then
    printf '드라이버가 설치됐지만 떠 있지 않아요 (재부팅해 보고, 그래도 안 되면 journalctl -b | grep -i nvidia)'
  else
    printf '드라이버가 없어요 (sudo pacman -S nvidia-open 뒤 재부팅)'
  fi
}

doctor() {
  print_version
  printf '\n시스템 점검:\n'

  local os_name="알 수 없음"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_name="${PRETTY_NAME:-${NAME:-알 수 없음}}"
  fi
  printf '  OS: %s\n' "${os_name}"

  check_line "pacman" "$(cmd_found pacman)"
  check_line "systemd" "$(cmd_found systemctl)"
  check_line "snapper" "$(cmd_found snapper)"
  check_line "docker" "$(cmd_found docker)"

  local compose="false"
  if have_cmd docker && docker compose version >/dev/null 2>&1; then
    compose="true"
  fi
  check_line "docker compose" "${compose}"

  check_line "fcitx5 (한글 입력)" "$(cmd_found fcitx5)"

  local korean="false"
  if have_cmd locale && locale -a 2>/dev/null | grep -qi '^ko_kr\.utf'; then
    korean="true"
  fi
  check_line "한국어 로캘" "${korean}"

  check_line "설정 파일" "$(path_found "${CONFIG_FILE}")" "${CONFIG_FILE}"
  check_line "Hyprland" "$(cmd_found Hyprland)"
  check_line "Quickshell" "$(cmd_found qs)"

  local shell_ok="false"
  if [[ -f "${SHELL_DIR}/shell.qml" && -f "${SESSION_FILE}" ]]; then
    shell_ok="true"
  fi
  check_line "RobinOS 셸" "${shell_ok}" "scripts/install-desktop.sh를 실행하세요"

  if [[ -n "${ROBINOS_RENDER:-}" ]]; then
    printf '  렌더링: %s\n' "${ROBINOS_RENDER}"
  fi

  local gpu
  gpu="$(nvidia_gpu_state)"
  if [[ -n "${gpu}" ]]; then
    printf '  NVIDIA 그래픽 카드: %s\n' "${gpu}"
  fi

  # Printing comes with the installed system (packages/apps.txt)
  if have_cmd lpstat; then
    local cups="false"
    if systemctl is-enabled --quiet cups.socket 2>/dev/null; then cups="true"; fi
    check_line "인쇄 서비스 (CUPS)" "${cups}" "sudo systemctl enable --now cups.socket"
  fi

  check_line "로그인 화면 테마 (SDDM)" "$(path_found "${SDDM_THEME_DIR}")"
  check_line "부팅 메뉴 테마 (GRUB)" "$(path_found "${GRUB_THEME_FILE}")"

  local fstype
  fstype="$(root_fstype)"
  if [[ "${fstype}" == "btrfs" ]]; then
    printf '  루트 파일 시스템: btrfs\n'
    check_line "스냅샷 설정 (snapper)" "$(path_found "${SNAPPER_CONFIG}")" "sudo robinctl snapshot setup"
    local snap_pac="false" grub_btrfs="false"
    if pkg_installed snap-pac; then snap_pac="true"; fi
    if systemctl is-enabled --quiet grub-btrfsd.service 2>/dev/null; then grub_btrfs="true"; fi
    check_line "업데이트 자동 스냅샷 (snap-pac)" "${snap_pac}" "sudo robinctl snapshot setup"
    check_line "부팅 메뉴 스냅샷 (grub-btrfs)" "${grub_btrfs}" "sudo robinctl snapshot setup"
  elif [[ "${fstype}" == "overlay" ]] && root_on_btrfs; then
    printf '  루트 파일 시스템: 스냅샷으로 부팅한 상태예요. 바꾼 내용은 재부팅하면 사라져요.\n'
    printf '    이 상태로 되돌리려면: sudo robinctl snapshot rollback <번호>\n'
  else
    printf '  루트 파일 시스템: %s (스냅샷은 Btrfs 설치에서만 써요)\n' "${fstype}"
  fi
}

update_system() {
  local dry_run="false"
  [[ "${1:-}" == "--dry-run" ]] && dry_run="true"

  have_cmd pacman || die "pacman이 필요해요"

  # snap-pac takes pre/post snapshots around every pacman transaction once the
  # root config exists; otherwise take one ourselves when we can.
  local mode="none"
  if snapshot_ready && pkg_installed snap-pac; then
    mode="snap-pac"
  elif snapshot_ready; then
    mode="manual"
  fi

  if [[ "${dry_run}" == "true" ]]; then
    case "${mode}" in
      snap-pac) printf '업데이트 전후 스냅샷은 snap-pac이 자동으로 만들어요.\n' ;;
      manual) printf '업데이트 전에 스냅샷을 만들어요.\n' ;;
      none) printf '스냅샷이 설정되지 않아서 업데이트 전 스냅샷을 만들지 않아요 (설정: sudo robinctl snapshot setup).\n' ;;
    esac
    printf '실행할 명령: pacman -Syu\n'
    if have_cmd flatpak; then
      printf '앱 스토어(Flatpak) 앱이 있으면 이어서: flatpak update --system\n'
    fi
    return
  fi

  need_root
  case "${mode}" in
    manual)
      snapper --no-dbus -c root create --description "RobinOS before update" --cleanup-algorithm number
      ;;
    none)
      printf '%s알림:%s 스냅샷이 설정되지 않아서 업데이트 전 스냅샷 없이 진행해요. 설정: sudo robinctl snapshot setup\n' \
        "${C_YELLOW}" "${C_RESET}" >&2
      ;;
  esac
  pacman -Syu

  # Apps from the app store (Flathub) live outside pacman and its snapshots
  if have_cmd flatpak && [[ -n "$(flatpak list --system --app --columns=application 2>/dev/null)" ]]; then
    printf '\n앱 스토어(Flatpak) 앱을 업데이트해요.\n'
    flatpak update --system
  fi
}

# ---- Snapshots: snapper + snap-pac + grub-btrfs on a Btrfs root ----
#
# Layout: the system is the @ subvolume, and snapshots live in a top-level
# @snapshots subvolume mounted on /.snapshots, so any snapshot can become the
# new @ (rollback) without being inside the old one. archinstall's default
# Btrfs layout (@, @home, @log, @pkg) has no @snapshots; `snapshot setup`
# creates it and adds it to fstab. Details for users: docs/recovery.md.
#
# Root runs snapper with --no-dbus so this also works from a chroot.

readonly SNAPPER_CONFIG="/etc/snapper/configs/root"
readonly SNAPSHOT_PACKAGES=(snapper snap-pac grub-btrfs inotify-tools rsync)
readonly BOOT_BACKUP_DIR="/.bootbackup"
ASSUME_YES="${ROBINOS_ASSUME_YES:-false}"

pkg_installed() {
  have_cmd pacman && pacman -Q "$1" >/dev/null 2>&1
}

root_fstype() {
  findmnt -no FSTYPE / 2>/dev/null || printf '알 수 없음'
}

# "/dev/vda2" from "/dev/vda2[/@]". After booting a snapshot from the GRUB menu
# with the grub-btrfs-overlayfs hook, / is an overlay in memory on top of the
# snapshot, so the device comes from the kernel's root= instead.
root_device() {
  if [[ "$(root_fstype)" == "overlay" ]]; then
    local root_arg
    root_arg="$(sed -E -n 's/(^|.* )root=([^ ]+).*/\2/p' /proc/cmdline)"
    findfs "${root_arg}" 2>/dev/null || printf '%s' "${root_arg}"
    return
  fi
  findmnt -no SOURCE / | sed 's/\[.*//'
}

# True when the system runs from Btrfs, also from a snapshot booted with an overlay
root_on_btrfs() {
  [[ "$(root_fstype)" == "btrfs" ]] ||
    [[ "$(lsblk -no FSTYPE "$(root_device)" 2>/dev/null)" == "btrfs" ]]
}

snapshot_ready() {
  [[ -f "${SNAPPER_CONFIG}" ]]
}

# Where grub.cfg lives: /boot/grub, or /efi/grub when the EFI partition is on /efi
grub_dir() {
  local dir
  for dir in /boot/grub /efi/grub /boot/efi/grub; do
    if [[ -f "${dir}/grub.cfg" ]]; then
      printf '%s' "${dir}"
      return
    fi
  done
}

# True when /boot is the EFI partition, which Btrfs snapshots don't include
boot_is_esp() {
  [[ "$(findmnt -no FSTYPE /boot 2>/dev/null)" == "vfat" ]]
}

# With /boot on the EFI partition, keep a copy of it in / around every kernel
# change so each snapshot carries its kernel (Arch wiki: Snapper, "Backup non-Btrfs
# boot partition"). 04- runs before snap-pac's pre snapshot, zy- after mkinitcpio
# and before snap-pac's post snapshot.
write_boot_backup_hooks() {
  local when name
  mkdir -p /etc/pacman.d/hooks
  for when in PreTransaction PostTransaction; do
    name="04-robinos-boot-backup.hook"
    [[ "${when}" == "PostTransaction" ]] && name="zy-robinos-boot-backup.hook"
    cat >"/etc/pacman.d/hooks/${name}" <<EOF
# RobinOS: copy the EFI /boot into ${BOOT_BACKUP_DIR} so snapshots include the
# kernel. Written by robinctl snapshot setup; restored by robinctl snapshot rollback.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = boot/*

[Action]
Description = Backing up /boot for snapshots...
When = ${when}
Exec = /usr/bin/rsync -a --delete --exclude=/grub /boot/ ${BOOT_BACKUP_DIR}/
EOF
  done
}

need_snapshots() {
  snapshot_ready || die "스냅샷이 아직 설정되지 않았어요. 먼저 실행하세요: sudo robinctl snapshot setup"
}

# Mounts the top level (subvolid=5) of the root filesystem and prints where.
mount_btrfs_top() {
  local dir
  dir="$(mktemp -d /tmp/robinos-btrfs.XXXXXX)"
  mount -o subvolid=5 "$(root_device)" "${dir}"
  printf '%s' "${dir}"
}

unmount_btrfs_top() {
  umount "$1" && rmdir "$1"
}

snapshot_create() {
  need_root
  need_snapshots

  # Descriptions show up in the GRUB snapshot menu, where grub-btrfs prints
  # snapper's XML escapes for non-ASCII text (&#xC2A4;...), so keep them ASCII
  local name="${1:-manual}"
  if [[ -n "$(printf '%s' "${name}" | LC_ALL=C tr -d '\040-\176')" ]]; then
    printf '%s알림:%s 부팅 메뉴에서는 영어만 제대로 보여서 스냅샷 이름을 "manual"로 바꿔 저장해요.\n' \
      "${C_YELLOW}" "${C_RESET}" >&2
    name="manual"
  fi
  snapper --no-dbus -c root create --description "RobinOS ${name}" --print-number
}

snapshot_list() {
  need_snapshots
  if [[ "${EUID}" -eq 0 ]]; then
    snapper --no-dbus -c root list
  else
    snapper -c root list
  fi
}

# Runs a setup step, or only prints it with --dry-run.
setup_step() {
  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '  %s\n' "$*"
  else
    "$@"
  fi
}

# Enables a unit, and starts it too unless we are in a chroot (robin-install).
setup_enable() {
  setup_step systemctl enable "$1"
  if [[ -d /run/systemd/system ]] && ! systemd-detect-virt --quiet --chroot 2>/dev/null; then
    setup_step systemctl start "$1"
  fi
}

# Creates the top-level @snapshots subvolume and its fstab line if missing.
setup_snapshot_subvolume() {
  if [[ "$(findmnt -no FSROOT /)" != "/@" ]]; then
    printf '  루트가 @ 하위 볼륨이 아니에요 (%s). 되돌리기는 @ 기준이라 직접 해야 할 수 있어요.\n' \
      "$(findmnt -no FSROOT /)"
  fi

  if findmnt --fstab -n /.snapshots >/dev/null 2>&1; then
    printf '  fstab에 /.snapshots가 이미 있어요\n'
    return
  fi

  # Same mount options as /, pointed at @snapshots
  local options line
  options="$(findmnt --fstab -no OPTIONS / | sed -E 's/(^|,)subvolid=[0-9]+//; s#subvol=[^,]*#subvol=/@snapshots#; s/^,//')"
  [[ "${options}" == *subvol=/@snapshots* ]] || options="${options:+${options},}subvol=/@snapshots"
  line="UUID=$(findmnt -no UUID /) /.snapshots btrfs ${options} 0 0"

  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '  btrfs subvolume create <Btrfs 최상위>/@snapshots\n'
    printf '  /etc/fstab에 추가: %s\n' "${line}"
    return
  fi

  local top
  top="$(mount_btrfs_top)"
  if [[ ! -d "${top}/@snapshots" ]]; then
    btrfs subvolume create "${top}/@snapshots"
  fi
  unmount_btrfs_top "${top}"

  printf '\n# Snapshots (robinctl snapshot setup)\n%s\n' "${line}" >>/etc/fstab
  systemctl daemon-reload 2>/dev/null || true
}

# snapper wants to create /.snapshots itself. Let it, then swap the nested
# subvolume it made for @snapshots from fstab (Arch wiki: Snapper).
setup_snapper_config() {
  if mountpoint -q /.snapshots; then
    setup_step umount /.snapshots
  fi
  if [[ -d /.snapshots ]]; then
    if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
      printf '  rmdir /.snapshots\n'
    else
      rmdir /.snapshots || die "/.snapshots 폴더가 비어 있지 않아요. 안의 파일을 옮긴 뒤 다시 실행하세요."
    fi
  fi

  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '  snapper --no-dbus -c root create-config /\n'
  elif ! snapper --no-dbus -c root create-config /; then
    # Leave fstab's mount point usable, or the next boot stops at it
    mkdir -p /.snapshots
    mount /.snapshots || true
    die "snapper 설정을 만들지 못했어요. /.snapshots는 원래대로 돌려놨어요."
  fi

  setup_step btrfs subvolume delete /.snapshots
  setup_step mkdir /.snapshots
  setup_step mount /.snapshots
}

snapshot_setup() {
  SETUP_DRY_RUN="false"
  [[ "${1:-}" == "--dry-run" ]] && SETUP_DRY_RUN="true"

  local fstype
  fstype="$(root_fstype)"
  [[ "${fstype}" == "btrfs" ]] ||
    die "루트(/)가 Btrfs가 아니에요 (지금: ${fstype}). 스냅샷은 Btrfs로 설치한 시스템에서만 써요."

  if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
    printf '실행할 명령:\n'
  else
    need_root
  fi

  local pacman_args=(-S --needed)
  [[ "${ASSUME_YES}" == "true" ]] && pacman_args+=(--noconfirm)

  printf '%s1. 필요한 패키지%s\n' "${C_BOLD}" "${C_RESET}"
  setup_step pacman "${pacman_args[@]}" "${SNAPSHOT_PACKAGES[@]}"

  printf '%s2. 스냅샷 저장 공간과 설정%s\n' "${C_BOLD}" "${C_RESET}"
  if snapshot_ready; then
    printf '  이미 설정돼 있어요 (%s)\n' "${SNAPPER_CONFIG}"
  else
    setup_snapshot_subvolume
    setup_snapper_config
  fi
  setup_step chmod 750 /.snapshots
  setup_step snapper --no-dbus -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 \
    ALLOW_GROUPS=wheel SYNC_ACL=yes
  setup_enable snapper-cleanup.timer

  if boot_is_esp; then
    printf '  /boot가 EFI 파티션이라 커널을 %s에 복사해 스냅샷에 같이 남겨요\n' "${BOOT_BACKUP_DIR}"
    if [[ "${SETUP_DRY_RUN}" == "true" ]]; then
      printf '  /etc/pacman.d/hooks/04-robinos-boot-backup.hook, zy-robinos-boot-backup.hook 쓰기\n'
    else
      write_boot_backup_hooks
    fi
    setup_step rsync -a --delete --exclude=/grub /boot/ "${BOOT_BACKUP_DIR}/"
  fi

  local grub
  grub="$(grub_dir)"

  printf '%s3. 부팅 메뉴의 스냅샷 항목 (grub-btrfs)%s\n' "${C_BOLD}" "${C_RESET}"
  if [[ -n "${grub}" ]] && have_cmd grub-mkconfig; then
    if [[ "${grub}" != "/boot/grub" ]]; then
      setup_step sed -i -E "s|^#?GRUB_BTRFS_GRUB_DIRNAME=.*|GRUB_BTRFS_GRUB_DIRNAME=\"${grub}\"|" \
        /etc/default/grub-btrfs/config
    fi
    # Without this grub-btrfs names the submenu after os-release ("Arch Linux snapshots")
    setup_step sed -i -E 's|^#?GRUB_BTRFS_SUBMENUNAME=.*|GRUB_BTRFS_SUBMENUNAME="RobinOS snapshots"|' \
      /etc/default/grub-btrfs/config
    setup_enable grub-btrfsd.service

    # Snapshots boot read-only; this initramfs hook gives them a writable
    # overlay in memory. It is a busybox runtime hook, so only for udev images.
    if grep -q 'grub-btrfs-overlayfs' /etc/mkinitcpio.conf; then
      printf '  읽기 전용 스냅샷 부팅 준비: 이미 돼 있어요\n'
    elif grep -Eq '^HOOKS=\(.*\budev\b' /etc/mkinitcpio.conf; then
      setup_step sed -i -E 's/^(HOOKS=\(.*)\)/\1 grub-btrfs-overlayfs)/' /etc/mkinitcpio.conf
      setup_step mkinitcpio -P
    else
      printf '  initramfs가 systemd 방식이라 grub-btrfs-overlayfs를 넣지 않았어요. 스냅샷은 읽기 전용으로 부팅돼요.\n'
    fi
  else
    printf '  GRUB을 찾지 못해서 건너뛰어요. 부팅 메뉴에서 스냅샷을 고르려면 GRUB으로 설치해야 해요.\n'
  fi

  printf '%s4. 첫 스냅샷%s\n' "${C_BOLD}" "${C_RESET}"
  setup_step snapper --no-dbus -c root create --description "RobinOS snapshot setup" --userdata important=yes

  # After the first snapshot, so the boot menu lists it right away
  if [[ -n "${grub}" ]] && have_cmd grub-mkconfig; then
    setup_step grub-mkconfig -o "${grub}/grub.cfg"
  fi

  if [[ "${SETUP_DRY_RUN}" != "true" ]]; then
    printf '\n스냅샷 준비가 끝났어요. 이제 pacman으로 설치하거나 업데이트할 때마다 전후 스냅샷이 생겨요.\n'
    printf '목록: robinctl snapshot list · 되돌리기: sudo robinctl snapshot rollback <번호>\n'
  fi
}

# Makes snapshot N the system: the current @ is kept as @.broken-<time> and a
# writable copy of the snapshot becomes @. Takes effect after a reboot. Works
# from the normal system or after booting the snapshot from the GRUB menu.
snapshot_rollback() {
  local number="${1:-}"
  [[ "${number}" =~ ^[0-9]+$ ]] ||
    die "사용법: sudo robinctl snapshot rollback <번호> (번호는 robinctl snapshot list에서 봐요)"
  [[ "${2:-}" == "--yes" ]] && ASSUME_YES="true"
  need_root
  root_on_btrfs || die "루트(/)가 Btrfs가 아니에요"

  local top source info description date stamp
  top="$(mount_btrfs_top)"
  source="${top}/@snapshots/${number}/snapshot"
  if [[ ! -d "${source}" ]]; then
    unmount_btrfs_top "${top}"
    die "스냅샷 ${number}번을 찾지 못했어요 (@snapshots/${number}). robinctl snapshot list로 번호를 확인하세요."
  fi
  if [[ ! -d "${top}/@" ]]; then
    unmount_btrfs_top "${top}"
    die "@ 하위 볼륨이 없어서 자동으로 되돌릴 수 없어요. docs/recovery.md를 보고 직접 되돌리세요."
  fi

  info="${top}/@snapshots/${number}/info.xml"
  description="$(sed -n 's:.*<description>\(.*\)</description>.*:\1:p' "${info}" 2>/dev/null)"
  date="$(sed -n 's:.*<date>\(.*\)</date>.*:\1:p' "${info}" 2>/dev/null)"
  printf '스냅샷 %s번: %s (%s UTC)\n' "${number}" "${description:-설명 없음}" "${date:-날짜 모름}"
  printf '지금 시스템은 @.broken-<시각>으로 남겨 두고, 이 스냅샷으로 시스템을 되돌려요. /home의 내 파일은 그대로예요.\n'

  if [[ "${ASSUME_YES}" != "true" ]]; then
    local answer
    printf '되돌릴까요? [y/N] '
    read -r answer || answer=""
    case "${answer}" in
      y|Y|yes|ㅛ) ;;
      *)
        unmount_btrfs_top "${top}"
        printf '그만뒀어요.\n'
        return
        ;;
    esac
  fi

  stamp="$(date +%Y%m%d-%H%M%S)"
  mv "${top}/@" "${top}/@.broken-${stamp}"
  if ! btrfs subvolume snapshot "${source}" "${top}/@"; then
    mv "${top}/@.broken-${stamp}" "${top}/@"
    unmount_btrfs_top "${top}"
    die "스냅샷을 복사하지 못해서 원래대로 뒀어요."
  fi
  # snap-pac takes "pre" snapshots while pacman holds its lock, so they carry
  # db.lck; left in place, pacman would refuse to run after the rollback
  rm -f "${top}/@/var/lib/pacman/db.lck"

  # The EFI /boot is not in the snapshot: put back the kernel it was taken with,
  # from the copy the boot backup hooks keep in /.bootbackup.
  local kernel_restored="false"
  if boot_is_esp && compgen -G "${top}/@${BOOT_BACKUP_DIR}/vmlinuz-*" >/dev/null; then
    cp -f "${top}/@${BOOT_BACKUP_DIR}"/vmlinuz-* /boot/
    cp -f "${top}/@${BOOT_BACKUP_DIR}"/initramfs-*.img /boot/ 2>/dev/null || true
    cp -f "${top}/@${BOOT_BACKUP_DIR}"/*-ucode.img /boot/ 2>/dev/null || true
    kernel_restored="true"
  fi
  unmount_btrfs_top "${top}"

  printf '\n%s되돌렸어요.%s 다시 시작하면 스냅샷 %s번 상태로 켜져요: sudo reboot\n' \
    "${C_GREEN}${C_BOLD}" "${C_RESET}" "${number}"
  if [[ "${kernel_restored}" == "true" ]]; then
    printf 'EFI 파티션의 커널도 그 시점의 것으로 바꿨어요.\n'
  elif boot_is_esp; then
    printf '%s알림:%s 이 스냅샷에는 커널 사본(%s)이 없어서 커널은 그대로예요. 재부팅 뒤 문제가 있으면 sudo pacman -S linux로 맞춰 주세요.\n' \
      "${C_YELLOW}" "${C_RESET}" "${BOOT_BACKUP_DIR}"
  fi
  printf '잘 되는 걸 확인한 뒤 이전 시스템(@.broken-%s)을 지우는 방법은 docs/recovery.md에 있어요.\n' "${stamp}"
}

# ---- Security learning profiles ----
#
# Security tools are installed a profile at a time as the learner gets there,
# so the everyday system stays light (docs/design.md). The profiles are the
# "# profile: <name>" sections of packages/security-baseline.txt; "security"
# is all of them.

readonly PROFILES=(network web forensics reversing passwords wireless vm)

profile_title() {
  case "$1" in
    network) printf '네트워크 분석' ;;
    web) printf '웹 보안 (로컬 웹 랩 포함)' ;;
    forensics) printf '포렌식' ;;
    reversing) printf '리버싱' ;;
    passwords) printf '비밀번호 크래킹' ;;
    wireless) printf '무선 보안' ;;
    vm) printf '가상 머신 실습' ;;
    security) printf '위 프로필 전부' ;;
  esac
}

profile_known() {
  local name
  [[ "$1" == "security" ]] && return 0
  for name in "${PROFILES[@]}"; do
    [[ "${name}" == "$1" ]] && return 0
  done
  return 1
}

# Packages of a profile, one per line
profile_packages() {
  [[ -f "${SECURITY_PACKAGES}" ]] || die "패키지 목록이 없어요: ${SECURITY_PACKAGES}"
  awk -v want="$1" '
    /^# profile: / { current = $3; next }
    /^[[:space:]]*(#|$)/ { next }
    want == "security" || current == want { print $1 }
  ' "${SECURITY_PACKAGES}"
}

profile_list() {
  local name
  printf '보안 실습 프로필 (배우는 순서):\n'
  for name in "${PROFILES[@]}" security; do
    printf '  %-10s %s\n' "${name}" "$(profile_title "${name}")"
    if [[ "${name}" != "security" ]]; then
      printf '             %s%s%s\n' "${C_DIM}" "$(profile_packages "${name}" | tr '\n' ' ')" "${C_RESET}"
    fi
  done
  printf '\n미리 보기: robinctl profile <이름> --dry-run\n'
  printf '설치:      sudo robinctl profile <이름>\n'
}

profile_install() {
  local name="$1" dry_run="false"
  [[ "${2:-}" == "--dry-run" ]] && dry_run="true"

  have_cmd pacman || die "pacman이 필요해요"
  local packages=()
  mapfile -t packages < <(profile_packages "${name}")
  [[ "${#packages[@]}" -gt 0 ]] || die "프로필 ${name}에 패키지가 없어요"

  if [[ "${dry_run}" == "true" ]]; then
    printf '%s 프로필(%s)로 설치할 패키지:\n' "${name}" "$(profile_title "${name}")"
    printf '  %s\n' "${packages[@]}"
    return
  fi

  need_root
  local pacman_args=(-S --needed)
  [[ "${ASSUME_YES}" == "true" ]] && pacman_args+=(--noconfirm)
  pacman "${pacman_args[@]}" "${packages[@]}"
  printf '\n%s 프로필을 설치했어요. 도구는 내 컴퓨터의 랩이나 허가받은 대상에서만 써요(docs/ethics.md).\n' "${name}"
}

packages_print() {
  case "${1:-}" in
    core)
      package_file "${CORE_PACKAGES}"
      ;;
    optional)
      package_file "${OPTIONAL_PACKAGES}"
      ;;
    *)
      if [[ -n "${1:-}" ]] && profile_known "$1"; then
        profile_packages "$1"
      else
        die "알 수 없는 패키지 묶음이에요: ${1:-} (core, optional, 보안 프로필 이름 중 하나: robinctl profile list)"
      fi
      ;;
  esac
}

# ---- Learning missions: Linux basics (1-5), network basics (6-10), forensics basics (11-15),
# reversing basics (16-20), web basics (21-25) ----
#
# Missions are solved in a real terminal. `robinctl learn check N` looks at the
# result (files under ~/practice) and records progress in the user's state dir.
# The network missions work without the internet except mission 8, which
# installs the network profile. The forensics missions work on practice files
# robinctl makes under ~/practice/forensics; 13 and 14 need the forensics profile.
# The reversing missions work on small practice programs (practice/reversing/*.c)
# put in ~/practice/reversing; 18 and 19 need ltrace and strace (in the live ISO and
# the reversing profile, or pacman -S on their own). The web basics missions talk to a
# practice server (practice/web/server.py) that only listens on 127.0.0.1:8000.

readonly LEARN_COUNT=25
LEARN_DIR="${HOME:-/root}/practice"
LEARN_NET="${HOME:-/root}/practice/net"
LEARN_FOR="${HOME:-/root}/practice/forensics"
LEARN_REV="${HOME:-/root}/practice/reversing"
LEARN_WEB="${HOME:-/root}/practice/web"
LEARN_STATE="${XDG_STATE_HOME:-${HOME:-/root}/.local/state}/robinos/learn"
LEARN_FAILS=0

learn_title() {
  case "$1" in
    1) printf '폴더 만들고 이동하기' ;;
    2) printf '파일 만들고 읽기' ;;
    3) printf '복사, 이동, 삭제' ;;
    4) printf '실행 권한 주기' ;;
    5) printf '찾기와 파이프' ;;
    6) printf '내 IP 주소 보기' ;;
    7) printf '이름으로 주소 찾기' ;;
    8) printf '네트워크 도구 설치하기' ;;
    9) printf '포트 열고 확인하기' ;;
    10) printf '내 컴퓨터 스캔하기' ;;
    11) printf '파일의 진짜 종류 알아내기' ;;
    12) printf '해시로 같은 파일 찾기' ;;
    13) printf '사진 속 정보 읽기' ;;
    14) printf '파일 속에 숨은 파일 찾기' ;;
    15) printf '로그에서 수상한 접속 찾기' ;;
    16) printf '실행 파일 살펴보기' ;;
    17) printf '프로그램 속 글자 찾기' ;;
    18) printf '라이브러리 호출 엿보기' ;;
    19) printf '시스템 호출 엿보기' ;;
    20) printf '기계어 읽어 보기' ;;
    21) printf '웹 서버 켜고 접속하기' ;;
    22) printf '응답 헤더 읽기' ;;
    23) printf 'robots.txt 읽기' ;;
    24) printf '쿠키 주고받기' ;;
    25) printf '상태 코드와 리다이렉트' ;;
  esac
}

# Mission groups, for the list
learn_group() {
  case "$1" in
    1) printf '리눅스 기초' ;;
    6) printf '네트워크 기초' ;;
    11) printf '포렌식 기초' ;;
    16) printf '리버싱 기초' ;;
    21) printf '웹 기초' ;;
  esac
}

learn_tools() {
  case "$1" in
    1) printf 'pwd ls cd mkdir' ;;
    2) printf 'echo cat > >> nano' ;;
    3) printf 'cp mv rm' ;;
    4) printf 'ls -l chmod ./' ;;
    5) printf 'grep | wc >' ;;
    6) printf 'ip a' ;;
    7) printf 'getent hosts /etc/hosts' ;;
    8) printf 'robinctl profile' ;;
    9) printf 'nc -l ss -tln' ;;
    10) printf 'nmap' ;;
    11) printf 'file xxd' ;;
    12) printf 'sha256sum' ;;
    13) printf 'exiftool' ;;
    14) printf 'binwalk strings' ;;
    15) printf 'grep sort uniq -c' ;;
    16) printf 'file readelf' ;;
    17) printf 'strings' ;;
    18) printf 'ltrace' ;;
    19) printf 'strace' ;;
    20) printf 'objdump' ;;
    21) printf 'python3 curl' ;;
    22) printf 'curl -I' ;;
    23) printf 'robots.txt' ;;
    24) printf 'curl -c -b' ;;
    25) printf 'curl -i -L' ;;
  esac
}

learn_is_done() {
  [[ -f "${LEARN_STATE}/done" ]] && grep -qx "$1" "${LEARN_STATE}/done"
}

learn_mark_done() {
  mkdir -p "${LEARN_STATE}"
  if ! learn_is_done "$1"; then
    printf '%s\n' "$1" >>"${LEARN_STATE}/done"
  fi
}

learn_done_count() {
  local count=0 i
  for ((i = 1; i <= LEARN_COUNT; i++)); do
    if learn_is_done "${i}"; then
      count=$((count + 1))
    fi
  done
  printf '%s' "${count}"
}

# First mission that is not done yet, or nothing when all are done.
learn_next() {
  local i
  for ((i = 1; i <= LEARN_COUNT; i++)); do
    if ! learn_is_done "${i}"; then
      printf '%s' "${i}"
      return
    fi
  done
}

learn_mission_arg() {
  local n="${1:-}"
  if [[ -z "${n}" ]]; then
    n="$(learn_next)"
    [[ -n "${n}" ]] || n="${LEARN_COUNT}"
  fi
  [[ "${n}" =~ ^([1-9]|1[0-9]|2[0-5])$ ]] || die "미션 번호는 1부터 ${LEARN_COUNT}까지예요"
  printf '%s' "${n}"
}

learn_list() {
  local finished next i mark
  finished="$(learn_done_count)"
  next="$(learn_next)"

  printf '%sRobinOS 학습 미션%s  %s%s/%s 완료%s\n' \
    "${C_BOLD}" "${C_RESET}" "${C_DIM}" "${finished}" "${LEARN_COUNT}" "${C_RESET}"

  for ((i = 1; i <= LEARN_COUNT; i++)); do
    if [[ -n "$(learn_group "${i}")" ]]; then
      printf '\n%s%s%s\n' "${C_BOLD}" "$(learn_group "${i}")" "${C_RESET}"
    fi
    if learn_is_done "${i}"; then
      mark="${C_GREEN}✓${C_RESET}"
    elif [[ "${i}" == "${next}" ]]; then
      mark="${C_YELLOW}→${C_RESET}"
    else
      mark=" "
    fi
    printf '  %s %2s. %s  %s%s%s\n' "${mark}" "${i}" "$(learn_title "${i}")" \
      "${C_DIM}" "$(learn_tools "${i}")" "${C_RESET}"
  done

  printf '\n'
  if [[ -n "${next}" ]]; then
    printf '미션 보기: %srobinctl learn show %s%s\n' "${C_BOLD}" "${next}" "${C_RESET}"
  else
    printf '학습 미션을 모두 끝냈어요. 다음은 웹 보안 랩이에요: %srobinctl lab info web%s\n' \
      "${C_BOLD}" "${C_RESET}"
  fi
}

learn_heading() {
  printf '%s미션 %s · %s%s\n\n' "${C_BOLD}" "$1" "$(learn_title "$1")" "${C_RESET}"
}

learn_section() {
  printf '\n%s%s%s\n' "${C_BOLD}" "$1" "${C_RESET}"
}

learn_show_1() {
  cat <<'EOF'
윈도우에서는 탐색기에서 "새 폴더"를 만들고 더블클릭해서 들어가요.
리눅스 터미널에서는 mkdir로 폴더를 만들고 cd로 들어가요.
지금 어느 폴더에 있는지는 pwd, 폴더 안에 뭐가 있는지는 ls로 봐요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  홈 폴더에 practice 폴더를 만들고, 그 안에 notes 폴더를 만드세요.
  완성되면 ~/practice/notes 폴더가 생겨요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  pwd                지금 있는 폴더 보기
  ls                 폴더 안의 목록 보기 (윈도우의 dir)
  mkdir practice     practice 폴더 만들기
  cd practice        practice 폴더로 들어가기
  mkdir notes        notes 폴더 만들기
  cd ..              한 단계 위로 나가기 (cd와 .. 사이를 띄어 써요)

  ~는 내 홈 폴더예요. 윈도우의 C:\Users\내이름과 같은 곳이에요.
EOF
}

learn_show_2() {
  cat <<'EOF'
윈도우에서는 메모장을 열어 글을 쓰고 저장해요.
리눅스에서는 명령 한 줄로도 파일에 글을 쓸 수 있어요.
  echo 글 > 파일     파일을 새로 만들고 글을 써요 (원래 내용은 지워져요)
  echo 글 >> 파일    파일 끝에 한 줄을 덧붙여요
  cat 파일           파일 내용을 보여 줘요
  nano 파일          터미널 안의 메모장이에요 (Ctrl+O 저장, Ctrl+X 나가기)
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/notes/hello.txt 파일을 만드세요.
  첫 줄은 hello linux로 쓰고, 그 아래에 아무 글이나 한 줄 이상 덧붙이세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/notes
  echo "hello linux" > hello.txt
  echo "리눅스 첫날" >> hello.txt
  cat hello.txt

  한글은 오른쪽 Alt(한/영 키)로 바꿔서 쓸 수 있어요.
EOF
}

learn_show_3() {
  cat <<'EOF'
윈도우에서는 Ctrl+C, Ctrl+V로 복사하고, 끌어다 놓아 옮기고, Delete로 지워요.
리눅스에서는 cp로 복사하고, mv로 옮기거나 이름을 바꾸고, rm으로 지워요.
rm으로 지운 파일은 휴지통을 거치지 않고 바로 사라지니 조심하세요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  1. 미션 2에서 만든 hello.txt를 ~/practice/backup 폴더에 복사하세요.
  2. ~/practice/notes/hello.txt의 이름을 memo.txt로 바꾸세요.
  3. 연습용 파일 ~/practice/old.txt를 지우세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  mkdir ~/practice/backup
  cp ~/practice/notes/hello.txt ~/practice/backup/
  mv ~/practice/notes/hello.txt ~/practice/notes/memo.txt
  rm ~/practice/old.txt
  ls ~/practice ~/practice/notes ~/practice/backup
EOF
}

learn_show_4() {
  cat <<'EOF'
윈도우에서는 .exe나 .bat 같은 확장자를 보고 실행 파일을 알아봐요.
리눅스에서는 확장자가 아니라 실행 권한(x)이 있어야 실행돼요.
ls -l로 보면 맨 앞의 -rwxr-xr-x 같은 글자에서 x가 실행 권한이에요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/hello.sh 스크립트를 만들고 실행 권한을 주세요.
  실행하면 hello가 들어간 글이 나와야 해요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice
  nano hello.sh           아래 두 줄을 쓰고 Ctrl+O, Enter, Ctrl+X
      #!/bin/bash
      echo "hello robinos"
  ls -l hello.sh          권한 보기 (아직 x가 없어요)
  chmod +x hello.sh       실행 권한 주기
  ./hello.sh              실행하기 (./는 "지금 폴더에 있는"이라는 뜻이에요)
EOF
}

learn_show_5() {
  cat <<'EOF'
윈도우에서는 findstr이나 Ctrl+F로 글자를 찾아요.
리눅스에서는 grep으로 찾고, |(파이프)로 앞 명령의 결과를 다음 명령에 넘겨요.
>를 쓰면 화면에 나올 결과를 파일에 저장해요.

/etc/passwd에는 이 컴퓨터의 사용자 목록이 있어요. 한 줄이 사용자 한 명이고,
줄 끝에는 그 사용자가 쓰는 셸이 적혀 있어요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  /etc/passwd에서 bash가 들어간 줄만 골라 ~/practice/bash-users.txt에 저장하세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cat /etc/passwd                     전체 보기
  grep bash /etc/passwd               bash가 들어간 줄만 보기
  grep bash /etc/passwd | wc -l       몇 줄인지 세기
  grep bash /etc/passwd > ~/practice/bash-users.txt
  cat ~/practice/bash-users.txt
EOF
}

learn_show_6() {
  cat <<'EOF'
윈도우에서는 ipconfig로 IP 주소를 봐요.
리눅스에서는 ip a(ip address)로 봐요. 장치마다 inet 뒤에 IPv4 주소가 나와요.
lo는 컴퓨터 자기 자신(127.0.0.1)이고, enp...나 wlan... 같은 것이 실제 네트워크 장치예요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  실제 네트워크 장치의 IPv4 주소를 ~/practice/net/my-ip.txt에 적으세요.
  주소만 적으면 돼요(예: 192.168.0.12). 네트워크에 연결돼 있지 않으면 127.0.0.1을 적어요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  ip a                    모든 장치와 주소
  ip -4 addr              IPv4 주소만
  ip -brief addr          장치마다 한 줄로 짧게
  mkdir -p ~/practice/net
  echo 192.168.0.12 > ~/practice/net/my-ip.txt    (내 주소로 바꿔서)
EOF
}

learn_show_7() {
  cat <<'EOF'
윈도우에서는 nslookup이나 ping으로 이름이 어떤 주소인지 봐요.
리눅스에서는 getent hosts 이름으로 봐요. 인터넷의 이름은 DNS 서버에 묻고,
이 컴퓨터 안에서 정한 이름은 /etc/hosts 파일에 적혀 있어요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  localhost라는 이름이 어떤 주소로 풀리는지 ~/practice/net/localhost.txt에 저장하세요.
  getent의 결과를 그대로 저장하면 돼요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cat /etc/hosts                    이 컴퓨터가 직접 정한 이름
  getent hosts localhost            localhost의 주소
  getent hosts localhost > ~/practice/net/localhost.txt
EOF
}

learn_show_8() {
  cat <<'EOF'
윈도우에서는 설치 파일을 내려받아 설치하지만, 리눅스에서는 패키지 관리자(pacman)로 설치해요.
RobinOS의 보안 실습 도구는 배우는 단계에 맞춰 묶음(프로필)으로 나뉘어 있어요.
이번에는 network 프로필을 설치해요. 인터넷 연결이 필요해요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  network 프로필을 설치하세요. nmap, dig, nc 명령이 생기면 돼요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  robinctl profile list                 프로필 목록
  robinctl profile network --dry-run    설치할 패키지 미리 보기
  sudo robinctl profile network         설치하기 (비밀번호를 물어요)
  nmap --version                        설치됐는지 확인
EOF
}

learn_show_9() {
  cat <<'EOF'
프로그램은 포트를 열고 연결을 기다려요(웹 서버는 보통 80번이나 443번).
윈도우에서는 netstat -an으로 보고, 리눅스에서는 ss로 봐요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  터미널 두 개로 해요.
  1. 첫 번째 터미널에서 nc -l 127.0.0.1 9000 을 실행해 9000번 포트를 열어 두세요.
  2. 두 번째 터미널(Win+Enter)에서 열린 포트 중 9000번 줄을 ~/practice/net/listen.txt에 저장하세요.
  3. 첫 번째 터미널은 Ctrl+C로 닫아요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  nc -l 127.0.0.1 9000                  (첫 번째 터미널) 9000번 포트 열기
  ss -tln                               열린 TCP 포트 (t: TCP, l: 기다리는 것, n: 숫자로)
  ss -tln | grep 9000 > ~/practice/net/listen.txt
EOF
}

learn_show_10() {
  cat <<'EOF'
포트 스캔은 어떤 포트가 열려 있는지 바깥에서 확인하는 거예요.
허가 없이 남의 컴퓨터를 스캔하면 안 돼요. 연습은 내 컴퓨터(127.0.0.1)와 RobinOS 랩에서만 해요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  9000번 포트를 다시 열어 둔 채로 내 컴퓨터를 스캔하고, 결과를 ~/practice/net/scan.txt에 저장하세요.
  결과에서 9000번이 open으로 나와야 해요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  nc -lk 127.0.0.1 9000                 (첫 번째 터미널) -k는 연결이 끝나도 계속 기다려요
  nmap -p 1-10000 127.0.0.1             1번부터 10000번 포트 스캔
  nmap -p 1-10000 127.0.0.1 -oN ~/practice/net/scan.txt

  허가받은 곳에서만 쓰는 이유는 docs/ethics.md에 있어요.
EOF
}

learn_show_11() {
  cat <<'EOF'
윈도우는 확장자(.txt, .png)를 보고 파일 종류를 정해요. 하지만 확장자는 이름일 뿐이라 얼마든지 바꿀 수 있어요.
리눅스의 file 명령은 파일 맨 앞의 표시(매직 바이트)를 읽어서 진짜 종류를 알려 줘요.
낯선 파일을 받으면 포렌식에서 가장 먼저 하는 일이에요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/forensics/report.txt의 진짜 종류를 알아내서
  ~/practice/forensics/report-type.txt에 한 단어로 적으세요(예: PDF).
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/forensics
  file report.txt                   진짜 종류 보기
  xxd report.txt | head -n 2        맨 앞 바이트를 16진수로 보기
  echo PDF > report-type.txt        (알아낸 종류로 바꿔서)
EOF
}

learn_show_12() {
  cat <<'EOF'
해시는 파일의 지문이에요. 내용이 한 글자만 달라도 해시가 완전히 달라져요.
그래서 파일이 똑같은지, 누가 몰래 바꿨는지 해시로 확인해요. 윈도우에서는 Get-FileHash로 봐요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/forensics/hash 폴더의 파일 다섯 개 중 내용이 똑같은 두 개를 찾아서
  그 이름을 ~/practice/forensics/same.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/forensics/hash
  cat memo*.txt                     눈으로 보면 비슷해 보여요
  sha256sum memo*.txt               파일마다 해시 보기
  sha256sum memo*.txt | sort        같은 해시끼리 나란히
  echo "memoA.txt memoB.txt" > ../same.txt   (찾은 이름으로 바꿔서)
EOF
}

learn_show_13() {
  cat <<'EOF'
사진 파일에는 찍은 사람, 카메라, 시간 같은 정보(메타데이터, EXIF)가 들어 있어요.
윈도우에서는 파일 속성의 "자세히" 탭에서 봐요. 사진을 인터넷에 올리기 전에 이 정보를 지우는 게 좋은 이유예요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/forensics/photo.jpg를 찍은 사람(Artist)의 이름을
  ~/practice/forensics/photographer.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/forensics
  exiftool photo.jpg                모든 정보 보기
  exiftool -Artist photo.jpg        찍은 사람만 보기

  exiftool이 없다고 나오면: sudo robinctl profile forensics
EOF
}

learn_show_14() {
  cat <<'EOF'
파일 뒤에 다른 파일을 몰래 붙여 숨길 수 있어요. 그림은 그대로 열리지만 안에 압축 파일이 들어 있을 수 있어요.
binwalk는 파일 안에서 다른 파일이 시작하는 표시를 찾아 줘요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/forensics/logo.png 안에 숨은 파일을 찾고,
  그 안에 적힌 암호를 ~/practice/forensics/found.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/forensics
  binwalk logo.png                  어떤 파일이 어디에 들어 있는지
  binwalk -e logo.png               숨은 파일 꺼내기 (extractions 폴더에 생겨요)
  bsdtar -xvf logo.png              뒤에 붙은 압축 파일만 바로 풀기
  strings logo.png                  파일 속 글자만 골라 보기

  binwalk가 없다고 나오면: sudo robinctl profile forensics
EOF
}

learn_show_15() {
  cat <<'EOF'
서버는 로그인 시도를 로그에 남겨요. 같은 주소에서 실패가 줄줄이 있으면
비밀번호를 마구 넣어 보는 공격(무차별 대입)일 수 있어요. 윈도우에서는 이벤트 뷰어로 봐요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/forensics/auth.log에서 로그인에 가장 많이 실패한 IP 주소를 찾아
  ~/practice/forensics/attacker.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/forensics
  grep "Failed password" auth.log                      실패한 줄만
  grep "Failed password" auth.log | grep -oE "from [0-9.]+" | sort | uniq -c | sort -n
                                                       주소별로 세어서 많은 순서로
  echo 주소 > attacker.txt                             (찾은 주소로 바꿔서)
EOF
}

# Practice files for missions 11-15, made the first time one of them is shown.
# The pictures are a few hundred bytes, kept here as base64.
LEARN_REPORT_B64="iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEUlEQVR42mN46uGLFTEMLQkAEvNegd9WNU8AAAAASUVORK5CYII="
LEARN_PHOTO_B64=""
LEARN_HIDDEN_B64="iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEUlEQVR42mMwWJKDFTEMLQkAM5lQAa0bO7kAAAAASUVORK5CYIJQSwMEFAAAAAAA9KJIXeBPjw8PAAAADwAAAAoAAABzZWNyZXQudHh0Uk9CSU4tRk9VTkQtSVQKUEsBAhQDFAAAAAAA9KJIXeBPjw8PAAAADwAAAAoAAAAAAAAAAAAAAIABAAAAAHNlY3JldC50eHRQSwUGAAAAAAEAAQA4AAAANwAAAAAA"

learn_prepare_forensics() {
  if [[ -f "${LEARN_STATE}/prepared-forensics" ]]; then
    return
  fi
  mkdir -p "${LEARN_FOR}/hash" "${LEARN_STATE}"
  printf '%s' "${LEARN_REPORT_B64}" | base64 -d >"${LEARN_FOR}/report.txt"
  printf '%s' "${LEARN_PHOTO_B64}" | base64 -d >"${LEARN_FOR}/photo.jpg"
  printf '%s' "${LEARN_HIDDEN_B64}" | base64 -d >"${LEARN_FOR}/logo.png"
  # Mission 12: memo2 and memo5 are the same; memo3 only looks the same (a space at the end)
  printf '3월 회의록: 예산 검토\n' >"${LEARN_FOR}/hash/memo1.txt"
  printf '3월 회의록: 일정 확정\n' >"${LEARN_FOR}/hash/memo2.txt"
  printf '3월 회의록: 일정 확정 \n' >"${LEARN_FOR}/hash/memo3.txt"
  printf '4월 회의록: 일정 확정\n' >"${LEARN_FOR}/hash/memo4.txt"
  printf '3월 회의록: 일정 확정\n' >"${LEARN_FOR}/hash/memo5.txt"
  learn_auth_log >"${LEARN_FOR}/auth.log"
  : >"${LEARN_STATE}/prepared-forensics"
  printf '\n%s연습용 파일을 ~/practice/forensics에 만들어 뒀어요.%s\n' "${C_DIM}" "${C_RESET}"
}

# Mission 15: a made-up sshd log. 203.0.113.45 fails the most (documentation
# addresses only, RFC 5737), 198.51.100.7 a few times, the user once.
learn_auth_log() {
  local i user port=40100
  printf 'Oct  8 09:12:01 robinos sshd[1201]: Failed password for robin from 192.168.0.23 port 51230 ssh2\n'
  printf 'Oct  8 09:12:09 robinos sshd[1201]: Accepted password for robin from 192.168.0.23 port 51230 ssh2\n'
  for i in 1 2 3; do
    printf 'Oct  8 10:0%s:17 robinos sshd[13%s0]: Failed password for root from 198.51.100.7 port %s ssh2\n' "${i}" "${i}" "$((port + i))"
  done
  i=0
  for user in root admin root test root oracle root admin root guest root root; do
    i=$((i + 1))
    printf 'Oct  8 11:%02d:4%s robinos sshd[2%03d]: Failed password for %s from 203.0.113.45 port %s ssh2\n' \
      "${i}" "$((i % 10))" "${i}" "${user}" "$((port + 50 + i))"
  done
  printf 'Oct  8 12:30:02 robinos sshd[3101]: Accepted password for robin from 192.168.0.23 port 51544 ssh2\n'
}

learn_show_16() {
  cat <<'EOF'
윈도우 프로그램이 .exe라면 리눅스 프로그램은 ELF라는 형식이에요. 프로그램은 혼자 돌지 않고
공유 라이브러리(윈도우의 .dll)를 빌려 써요. 리버싱은 낯선 프로그램을 실행하기 전에 살펴보는 데서 시작해요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/reversing/hello가 쓰는 공유 라이브러리 이름을
  ~/practice/reversing/library.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/reversing
  file hello                        어떤 실행 파일인지 (64비트? 동적 링크?)
  readelf -h hello                  ELF 머리말: CPU 종류, 시작 주소
  readelf -d hello | grep NEEDED    필요한 공유 라이브러리
  echo 이름 > library.txt           (찾은 이름으로 바꿔서)

  ldd도 라이브러리를 보여 주지만 프로그램을 실제로 띄울 수도 있어서, 낯선 프로그램에는 readelf를 써요.
EOF
}

learn_show_17() {
  cat <<'EOF'
프로그램 안에는 화면에 나오는 문장, 파일 이름, 때로는 비밀번호까지 글자 그대로 들어 있어요.
strings는 파일에서 읽을 수 있는 글자만 골라 보여 줘요. 비밀번호를 프로그램에 그대로 넣으면 안 되는 이유예요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/reversing/vault의 비밀번호를 찾아 금고를 열고,
  나온 코드를 ~/practice/reversing/vault.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/reversing
  ./vault                           비밀번호를 물어요 (모르면 Ctrl+C)
  strings vault                     프로그램 속 글자 모두
  strings vault | less              길면 한 화면씩 (q로 나가요)
  ./vault                           찾은 비밀번호를 넣어요
  echo 코드 > vault.txt             (나온 코드로 바꿔서)
EOF
}

learn_show_18() {
  cat <<'EOF'
이번 열쇠는 프로그램이 실행되면서 한 글자씩 조립해서 strings로는 보이지 않아요.
하지만 입력과 비교하려면 결국 라이브러리 함수(strcmp)에 넘겨야 해요.
ltrace는 프로그램이 부르는 라이브러리 함수와 거기에 넘긴 값을 보여 줘요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/reversing/gate의 열쇠를 찾아 문을 열고,
  나온 코드를 ~/practice/reversing/gate.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/reversing
  ./gate 아무거나                   틀린 열쇠
  strings gate                      이번에는 열쇠가 안 보여요
  ltrace ./gate 아무거나            strcmp가 무엇과 비교하는지
  ./gate 찾은열쇠
  echo 코드 > gate.txt              (나온 코드로 바꿔서)

  ltrace가 없다고 나오면: sudo pacman -S ltrace  (Ghidra까지 든 묶음은 sudo robinctl profile reversing)
EOF
}

learn_show_19() {
  cat <<'EOF'
프로그램이 파일을 열고, 네트워크에 연결하고, 화면에 글을 쓰는 일은 모두 커널에 부탁해서 해요(시스템 호출).
strace는 그 부탁을 모두 보여 줘요. 프로그램이 "안 돼요"라고만 할 때 무엇을 찾다가 실패했는지 알아낼 수 있어요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/reversing/seeker가 찾는 열쇠 파일을 만들어 주고,
  나온 코드를 ~/practice/reversing/seeker.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/reversing
  ./seeker                          열쇠 파일을 못 찾았대요
  strace ./seeker                   시스템 호출 모두 (많아요)
  strace -e trace=openat ./seeker   파일을 여는 것만
  mkdir -p 폴더 && touch 파일       (strace에 나온 경로로 바꿔서)
  ./seeker
  echo 코드 > seeker.txt            (나온 코드로 바꿔서)

  strace가 없다고 나오면: sudo pacman -S strace  (Ghidra까지 든 묶음은 sudo robinctl profile reversing)
EOF
}

learn_show_20() {
  cat <<'EOF'
컴파일된 프로그램은 CPU가 읽는 기계어예요. objdump는 그걸 사람이 읽을 수 있는 어셈블리로 바꿔 보여 줘요(디스어셈블).
어셈블리에서 숫자는 보통 16진수(0x...)로 나와요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  ~/practice/reversing/count가 원하는 숫자를 check 함수에서 찾아 맞히고,
  그 숫자를 10진수로 ~/practice/reversing/number.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/reversing
  ./count 7                         틀렸대요
  objdump -d count --disassemble=check
                                    check 함수만 디스어셈블. cmp 줄의 $0x... 숫자를 봐요
  echo $((0x10))                    16진수를 10진수로 (0x10 → 16)
  ./count 숫자
  echo 숫자 > number.txt            (맞힌 숫자로 바꿔서)
EOF
}

learn_show_21() {
  cat <<'EOF'
웹 페이지는 서버가 보내 주는 글(HTML)이에요. 브라우저 대신 curl로 받으면 서버가 실제로 보낸 내용이 그대로 보여요.
연습 서버는 내 컴퓨터(127.0.0.1)에서만 열려서 다른 컴퓨터에서는 보이지 않아요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  연습 서버를 켜 두고, 첫 페이지에 적힌 코드를 ~/practice/web/hello.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  python3 ~/practice/web/server.py      (새 터미널 Win+Enter에서) 서버 켜기. 끄려면 Ctrl+C
  curl http://127.0.0.1:8000/           (이 터미널에서) 첫 페이지 받기
  firefox http://127.0.0.1:8000/        브라우저로도 열어 봐요
  echo 코드 > ~/practice/web/hello.txt  (나온 코드로 바꿔서)

  22~25번도 이 서버를 써요. 미션을 다 할 때까지 켜 두세요.
EOF
}

learn_show_22() {
  cat <<'EOF'
서버는 내용 앞에 헤더를 붙여 보내요. 내용 종류, 길이, 서버 이름, 쿠키 같은 정보예요.
브라우저에서는 개발자 도구(F12)의 "네트워크" 탭에서 볼 수 있어요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  첫 페이지의 응답 헤더 중 X-Robin-Code의 값을 ~/practice/web/header.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  curl -I http://127.0.0.1:8000/        헤더만 보기
  curl -i http://127.0.0.1:8000/        헤더와 내용을 함께
  echo 값 > ~/practice/web/header.txt   (찾은 값으로 바꿔서)
EOF
}

learn_show_23() {
  cat <<'EOF'
robots.txt는 검색 로봇에게 "여기는 보지 말아 주세요"라고 부탁하는 파일이에요.
막는 기능이 아니라서, 숨기고 싶은 주소를 적으면 오히려 알려 주는 셈이에요.
웹 점검에서 먼저 보는 파일이에요. 허가받은 곳에서만 해요(docs/ethics.md).
EOF
  learn_section "할 일"
  cat <<'EOF'
  연습 서버의 robots.txt가 감춘 주소를 열어 보고, 나온 코드를 ~/practice/web/notes.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  curl http://127.0.0.1:8000/robots.txt
  curl http://127.0.0.1:8000/주소/      (Disallow에 적힌 주소로 바꿔서)
  echo 코드 > ~/practice/web/notes.txt  (나온 코드로 바꿔서)
EOF
}

learn_show_24() {
  cat <<'EOF'
웹은 요청마다 따로라서, 서버는 로그인한 사람을 쿠키로 알아봐요. 서버가 Set-Cookie로 준 값을
브라우저가 다음 요청마다 Cookie로 돌려보내요. 쿠키를 훔치면 로그인을 가로챌 수 있어서
자바스크립트가 읽지 못하게 하는 HttpOnly 같은 보호를 붙여요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  /me 는 쿠키가 없으면 401을 돌려줘요. /login 에서 쿠키를 받아 /me 에 보내고,
  나온 코드를 ~/practice/web/cookie.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  cd ~/practice/web
  curl -i http://127.0.0.1:8000/me                 쿠키 없이 (401)
  curl -i -c jar.txt http://127.0.0.1:8000/login   받은 쿠키를 jar.txt에 저장
  cat jar.txt                                      받은 쿠키 보기
  curl -b jar.txt http://127.0.0.1:8000/me         쿠키 보내기
  echo 코드 > cookie.txt                           (나온 코드로 바꿔서)
EOF
}

learn_show_25() {
  cat <<'EOF'
응답의 첫 줄에는 상태 코드가 있어요. 200은 성공, 301은 주소가 옮겨졌다, 401은 로그인이 필요하다,
404는 없다는 뜻이에요. 301이면 Location 헤더가 새 주소를 알려 줘요. 브라우저는 알아서 따라가요.
EOF
  learn_section "할 일"
  cat <<'EOF'
  /old-page 의 상태 코드와 옮겨 간 주소를 확인하고, 따라가서 나온 코드를
  ~/practice/web/redirect.txt에 적으세요.
EOF
  learn_section "써 볼 명령"
  cat <<'EOF'
  curl -i http://127.0.0.1:8000/old-page     상태 코드와 Location 보기
  curl -L http://127.0.0.1:8000/old-page     리다이렉트 따라가기
  echo 코드 > ~/practice/web/redirect.txt    (나온 코드로 바꿔서)

  웹 기초를 마치면 진짜 취약한 앱으로 연습할 수 있어요: robinctl lab info web
EOF
}

# The practice web server for missions 21-25 (practice/web/server.py), kept here
# as gzip + base64 by practice/web/build.sh
LEARN_WEB_SERVER_B64=""

learn_prepare_web() {
  if [[ -f "${LEARN_STATE}/prepared-web" && -f "${LEARN_WEB}/server.py" ]]; then
    return
  fi
  mkdir -p "${LEARN_WEB}" "${LEARN_STATE}"
  printf '%s' "${LEARN_WEB_SERVER_B64}" | base64 -d | gzip -dc >"${LEARN_WEB}/server.py"
  chmod 755 "${LEARN_WEB}/server.py"
  : >"${LEARN_STATE}/prepared-web"
  printf '\n%s연습 서버를 ~/practice/web/server.py에 만들어 뒀어요.%s\n' "${C_DIM}" "${C_RESET}"
}

# Practice programs for missions 16-20, built from practice/reversing/*.c by
# practice/reversing/build.sh and kept here as gzip + base64 (a few KB each)
LEARN_REV_HELLO_B64=""
LEARN_REV_VAULT_B64=""
LEARN_REV_GATE_B64=""
LEARN_REV_SEEKER_B64=""
LEARN_REV_COUNT_B64=""

learn_prepare_reversing() {
  local name
  if [[ -f "${LEARN_STATE}/prepared-reversing" ]]; then
    return
  fi
  mkdir -p "${LEARN_REV}" "${LEARN_STATE}"
  for name in hello vault gate seeker count; do
    local var="LEARN_REV_${name^^}_B64"
    printf '%s' "${!var}" | base64 -d | gzip -dc >"${LEARN_REV}/${name}"
    chmod 755 "${LEARN_REV}/${name}"
  done
  : >"${LEARN_STATE}/prepared-reversing"
  printf '\n%s연습용 프로그램을 ~/practice/reversing에 만들어 뒀어요.%s\n' "${C_DIM}" "${C_RESET}"
}

# Mission 3 needs a file to delete. It is created the first time the mission is shown.
learn_prepare_3() {
  if [[ -f "${LEARN_STATE}/prepared-3" ]]; then
    return
  fi
  mkdir -p "${LEARN_DIR}" "${LEARN_STATE}"
  printf '미션 3에서 지워 볼 연습용 파일이에요.\n' >"${LEARN_DIR}/old.txt"
  : >"${LEARN_STATE}/prepared-3"
  printf '\n%s연습용 파일 ~/practice/old.txt를 만들어 뒀어요.%s\n' "${C_DIM}" "${C_RESET}"
}

learn_show() {
  local n
  n="$(learn_mission_arg "${1:-}")"
  learn_heading "${n}"
  "learn_show_${n}"
  if [[ "${n}" == "3" ]]; then
    learn_prepare_3
  elif ((n >= 21)); then
    learn_prepare_web
  elif ((n >= 16)); then
    learn_prepare_reversing
  elif ((n >= 11)); then
    learn_prepare_forensics
  fi
  printf '\n다 했으면 확인해요: %srobinctl learn check %s%s\n' "${C_BOLD}" "${n}" "${C_RESET}"
}

learn_ok() {
  printf '  %s✓%s %s\n' "${C_GREEN}" "${C_RESET}" "$1"
}

learn_bad() {
  printf '  %s✗%s %s\n' "${C_RED}" "${C_RESET}" "$1"
  if [[ -n "${2:-}" ]]; then
    printf '    %s%s%s\n' "${C_DIM}" "$2" "${C_RESET}"
  fi
  LEARN_FAILS=$((LEARN_FAILS + 1))
}

learn_check_1() {
  if [[ -d "${LEARN_DIR}" ]]; then
    learn_ok "~/practice 폴더가 있어요"
  else
    learn_bad "~/practice 폴더가 없어요" "mkdir ~/practice"
  fi

  if [[ -d "${LEARN_DIR}/notes" ]]; then
    learn_ok "~/practice/notes 폴더가 있어요"
  else
    learn_bad "~/practice/notes 폴더가 없어요" "cd ~/practice로 들어간 뒤 mkdir notes"
  fi
}

learn_check_2() {
  local file="${LEARN_DIR}/notes/hello.txt"

  if [[ ! -f "${file}" ]]; then
    learn_bad "~/practice/notes/hello.txt 파일이 없어요" 'echo "hello linux" > ~/practice/notes/hello.txt'
    return
  fi
  learn_ok "hello.txt 파일이 있어요"

  local first lines
  first="$(head -n 1 "${file}" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  if [[ "${first,,}" == "hello linux" ]]; then
    learn_ok "첫 줄이 hello linux예요"
  else
    learn_bad "첫 줄이 hello linux가 아니에요 (지금: '${first}')" '> 를 쓰면 새로 써요: echo "hello linux" > hello.txt'
  fi

  lines="$(grep -c '[^[:space:]]' "${file}" || true)"
  if ((lines >= 2)); then
    learn_ok "글이 ${lines}줄 있어요"
  else
    learn_bad "글이 ${lines}줄뿐이에요" '>> 로 한 줄 덧붙여 보세요: echo "리눅스 첫날" >> hello.txt'
  fi
}

learn_check_3() {
  local backup="${LEARN_DIR}/backup/hello.txt"
  local memo="${LEARN_DIR}/notes/memo.txt"

  if [[ -f "${backup}" ]]; then
    learn_ok "~/practice/backup/hello.txt로 복사했어요"
  else
    learn_bad "~/practice/backup/hello.txt가 없어요" "mkdir ~/practice/backup 후 cp로 복사해 보세요"
  fi

  if [[ ! -f "${memo}" ]]; then
    learn_bad "~/practice/notes/memo.txt가 없어요" "mv ~/practice/notes/hello.txt ~/practice/notes/memo.txt"
  elif [[ -e "${LEARN_DIR}/notes/hello.txt" ]]; then
    learn_bad "notes 폴더에 hello.txt가 아직 있어요" "cp는 복사라서 원래 파일이 남아요. 이름 바꾸기는 mv로 해요"
  else
    learn_ok "hello.txt의 이름을 memo.txt로 바꿨어요"
  fi

  if [[ -f "${backup}" && -f "${memo}" ]]; then
    # Not cmp: it comes with diffutils, which Arch's base doesn't include
    if [[ "$(<"${backup}")" == "$(<"${memo}")" ]]; then
      learn_ok "복사본과 memo.txt 내용이 같아요"
    else
      learn_bad "복사본과 memo.txt 내용이 달라요" "hello.txt를 복사한 뒤에 이름을 바꿨는지 확인해 보세요"
    fi
  fi

  if [[ ! -f "${LEARN_STATE}/prepared-3" ]]; then
    learn_bad "아직 연습용 파일을 만들지 않았어요" "robinctl learn show 3을 먼저 실행하세요"
  elif [[ -e "${LEARN_DIR}/old.txt" ]]; then
    learn_bad "~/practice/old.txt가 아직 있어요" "rm ~/practice/old.txt"
  else
    learn_ok "old.txt를 지웠어요"
  fi
}

learn_check_4() {
  local script="${LEARN_DIR}/hello.sh"

  if [[ ! -f "${script}" ]]; then
    learn_bad "~/practice/hello.sh 파일이 없어요" "cd ~/practice 후 nano hello.sh"
    return
  fi
  learn_ok "hello.sh 파일이 있어요"

  if [[ "$(head -c 2 "${script}")" == "#!" ]]; then
    learn_ok "첫 줄에 #!가 있어요"
  else
    learn_bad "첫 줄이 #!/bin/bash가 아니에요" "어떤 프로그램으로 실행할지 첫 줄에 적어야 해요"
  fi

  if [[ ! -x "${script}" ]]; then
    learn_bad "실행 권한(x)이 없어요" "chmod +x ~/practice/hello.sh"
    return
  fi
  learn_ok "실행 권한이 있어요"

  local output
  output="$(cd "${LEARN_DIR}" && timeout 5 ./hello.sh 2>&1 </dev/null || true)"
  if [[ "${output,,}" == *hello* ]]; then
    learn_ok "실행하면 '${output%%$'\n'*}'라고 나와요"
  else
    learn_bad "실행 결과에 hello가 없어요" 'echo "hello robinos" 줄이 있는지 확인해 보세요'
  fi
}

learn_check_5() {
  local file="${LEARN_DIR}/bash-users.txt"

  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/bash-users.txt가 없거나 비어 있어요" "grep bash /etc/passwd > ~/practice/bash-users.txt"
    return
  fi
  learn_ok "bash-users.txt 파일이 있어요"

  local expected actual
  expected="$(grep -c bash /etc/passwd || true)"
  actual="$(grep -c . "${file}" || true)"

  if grep -v bash "${file}" | grep -q . || grep -vxFf /etc/passwd "${file}" | grep -q .; then
    learn_bad "/etc/passwd에 없는 줄이나 bash가 없는 줄이 섞여 있어요" "직접 쓰지 말고 grep의 결과를 >로 저장해 보세요"
  else
    learn_ok "모든 줄이 /etc/passwd에서 bash가 들어간 줄이에요"
  fi

  if [[ "${actual}" == "${expected}" ]]; then
    learn_ok "bash를 쓰는 사용자 ${expected}명을 모두 찾았어요"
  else
    learn_bad "${expected}줄이어야 하는데 ${actual}줄이에요" "grep bash /etc/passwd | wc -l로 세어 보세요"
  fi
}

# The machine's IPv4 addresses, one per line
learn_my_addresses() {
  ip -4 -o addr show 2>/dev/null | awk '{ split($4, a, "/"); print a[1] }'
}

learn_check_6() {
  local file="${LEARN_NET}/my-ip.txt" written
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/net/my-ip.txt가 없거나 비어 있어요" "mkdir -p ~/practice/net 후 echo 주소 > ~/practice/net/my-ip.txt"
    return
  fi
  written="$(grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' "${file}" | head -n 1 || true)"
  if [[ -z "${written}" ]]; then
    learn_bad "IPv4 주소(숫자 네 개를 점으로 이은 것)가 없어요" "ip -4 addr에서 inet 뒤의 주소를 적어요 (/24 같은 뒷부분은 빼고)"
    return
  fi
  if ! learn_my_addresses | grep -qxF "${written}"; then
    learn_bad "이 컴퓨터의 주소가 아니에요: ${written}" "ip -4 addr로 다시 확인해 보세요"
  elif [[ "${written}" == 127.* ]] && learn_my_addresses | grep -qv '^127\.'; then
    learn_bad "컴퓨터 자기 자신을 가리키는 주소예요: ${written}" "ip a에서 lo가 아닌 장치의 inet을 찾아보세요"
  else
    learn_ok "이 컴퓨터의 주소예요: ${written}"
  fi
}

learn_check_7() {
  local file="${LEARN_NET}/localhost.txt" address
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/net/localhost.txt가 없거나 비어 있어요" "getent hosts localhost > ~/practice/net/localhost.txt"
    return
  fi
  local found="false"
  while read -r address _; do
    [[ -n "${address}" ]] && grep -qwF -- "${address}" "${file}" && found="true"
  done < <(getent hosts localhost 2>/dev/null; printf '127.0.0.1\n::1\n')
  if [[ "${found}" == "true" ]]; then
    learn_ok "localhost의 주소를 찾았어요"
  else
    learn_bad "localhost의 주소가 아니에요" "getent hosts localhost의 결과를 그대로 저장해 보세요"
  fi
}

learn_check_8() {
  local cmd
  for cmd in nmap dig nc; do
    if have_cmd "${cmd}"; then
      learn_ok "${cmd} 명령이 있어요"
    else
      learn_bad "${cmd} 명령이 없어요" "sudo robinctl profile network"
    fi
  done
}

learn_check_9() {
  local file="${LEARN_NET}/listen.txt"
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/net/listen.txt가 없거나 비어 있어요" "nc -l 127.0.0.1 9000 을 켜 둔 채 ss -tln | grep 9000 > ~/practice/net/listen.txt"
    return
  fi
  if grep -q 'LISTEN.*127\.0\.0\.1:9000\b' "${file}"; then
    learn_ok "127.0.0.1의 9000번 포트가 열려 있었어요"
  elif grep -q ':9000\b' "${file}"; then
    learn_bad "9000번은 보이지만 127.0.0.1에서 기다리는 줄이 아니에요" "nc -l 127.0.0.1 9000 처럼 주소까지 적어 열어 보세요"
  else
    learn_bad "9000번 포트가 없어요" "첫 번째 터미널에서 nc -l 127.0.0.1 9000 이 실행 중일 때 저장해야 해요"
  fi
}

learn_check_10() {
  local file="${LEARN_NET}/scan.txt"
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/net/scan.txt가 없거나 비어 있어요" "nmap -p 1-10000 127.0.0.1 -oN ~/practice/net/scan.txt"
    return
  fi
  if ! grep -q '^Nmap scan report for ' "${file}"; then
    learn_bad "nmap 결과가 아니에요" "-oN 파일 이름으로 nmap 결과를 저장해요"
    return
  fi
  if grep '^Nmap scan report for ' "${file}" | grep -qvE 'for (localhost|127\.0\.0\.1|::1)( |$)'; then
    learn_bad "내 컴퓨터가 아닌 대상을 스캔했어요" "이번 미션은 127.0.0.1만 스캔해요. 다른 대상은 허가를 받아야 해요(docs/ethics.md)"
    return
  fi
  learn_ok "내 컴퓨터(127.0.0.1)만 스캔했어요"
  if grep -qE '^9000/tcp[[:space:]]+open' "${file}"; then
    learn_ok "9000번 포트가 open으로 나왔어요"
  else
    learn_bad "9000번 포트가 open으로 나오지 않았어요" "nc -lk 127.0.0.1 9000 을 켜 둔 채 다시 스캔해 보세요"
  fi
}

# First line of an answer file, trimmed; nothing when the file is missing
learn_answer() {
  if [[ -s "$1" ]]; then
    head -n 1 "$1" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
  fi
}

learn_check_11() {
  local answer
  answer="$(learn_answer "${LEARN_FOR}/report-type.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/forensics/report-type.txt가 없거나 비어 있어요" "file report.txt로 종류를 보고 echo 종류 > report-type.txt"
  elif [[ "${answer,,}" == *png* ]]; then
    learn_ok "report.txt는 사실 PNG 그림이에요. 확장자만 .txt였어요"
  elif [[ "${answer,,}" == *text* || "${answer,,}" == *txt* ]]; then
    learn_bad "확장자는 .txt지만 진짜 종류는 달라요" "file report.txt의 결과를 다시 읽어 보세요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "file report.txt가 알려 주는 종류를 적어요"
  fi
}

learn_check_12() {
  local answer
  answer="$({ cat "${LEARN_FOR}/same.txt" 2>/dev/null || true; } | tr '\n' ' ')"
  if [[ -z "${answer// /}" ]]; then
    learn_bad "~/practice/forensics/same.txt가 없거나 비어 있어요" "sha256sum memo*.txt | sort 로 같은 해시를 찾아요"
    return
  fi
  if [[ "${answer}" == *memo2* && "${answer}" == *memo5* && "${answer}" != *memo1* && "${answer}" != *memo3* && "${answer}" != *memo4* ]]; then
    learn_ok "memo2.txt와 memo5.txt의 해시가 같아요"
  elif [[ "${answer}" == *memo3* ]]; then
    learn_bad "memo3.txt는 비슷해 보이지만 끝에 빈칸이 하나 더 있어서 해시가 달라요" "눈 대신 sha256sum을 믿어요"
  else
    learn_bad "똑같은 두 파일이 아니에요" "sha256sum memo*.txt | sort 에서 첫 칸이 같은 두 줄을 찾아요"
  fi
}

learn_check_13() {
  local answer
  answer="$(learn_answer "${LEARN_FOR}/photographer.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/forensics/photographer.txt가 없거나 비어 있어요" "exiftool -Artist photo.jpg"
  elif [[ "$(printf '%s' "${answer,,}" | tr -s ' ')" == *"kim haneul"* ]]; then
    learn_ok "photo.jpg는 Kim Haneul이 찍었다고 적혀 있어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "exiftool -Artist photo.jpg가 보여 주는 이름을 적어요"
  fi
  if ! have_cmd exiftool && [[ ! -x /usr/bin/vendor_perl/exiftool ]]; then
    printf '    %sexiftool이 없으면: sudo robinctl profile forensics%s\n' "${C_DIM}" "${C_RESET}"
  fi
}

learn_check_14() {
  local answer
  answer="$(learn_answer "${LEARN_FOR}/found.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/forensics/found.txt가 없거나 비어 있어요" "binwalk -e logo.png 나 bsdtar -xvf logo.png 로 숨은 파일을 꺼내요"
  elif [[ "${answer^^}" == *ROBIN-FOUND-IT* ]]; then
    learn_ok "logo.png 뒤에 붙은 압축 파일에서 암호를 찾았어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "꺼낸 압축 파일 안의 secret.txt를 cat으로 열어 보세요"
  fi
}

learn_check_15() {
  local answer addresses
  answer="$(cat "${LEARN_FOR}/attacker.txt" 2>/dev/null || true)"
  if [[ -z "${answer//[[:space:]]/}" ]]; then
    learn_bad "~/practice/forensics/attacker.txt가 없거나 비어 있어요" "grep \"Failed password\" auth.log | grep -oE \"from [0-9.]+\" | sort | uniq -c | sort -n"
    return
  fi
  addresses="$(printf '%s' "${answer}" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u || true)"
  if [[ "${addresses}" == "203.0.113.45" ]]; then
    learn_ok "203.0.113.45가 12번 실패했어요. 비밀번호를 마구 넣어 본 흔적이에요"
  elif [[ "${addresses}" == *203.0.113.45* ]]; then
    learn_bad "주소를 하나만 적어요" "가장 많이 실패한 주소 하나만 남겨요"
  else
    learn_bad "가장 많이 실패한 주소가 아니에요" "uniq -c 로 센 숫자가 가장 큰 줄을 찾아요"
  fi
}

learn_check_16() {
  local answer
  answer="$(learn_answer "${LEARN_REV}/library.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/reversing/library.txt가 없거나 비어 있어요" "readelf -d hello | grep NEEDED"
  elif [[ "${answer,,}" == *libc.so.6* ]]; then
    learn_ok "hello는 C 표준 라이브러리 libc.so.6을 빌려 써요"
  elif [[ "${answer,,}" == *libc* ]]; then
    learn_bad "거의 맞았어요. 파일 이름 그대로 적어요" "NEEDED 줄의 [ ] 안에 있는 이름 전체를 적어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "readelf -d hello | grep NEEDED 의 [ ] 안을 봐요"
  fi
}

learn_check_17() {
  local answer
  answer="$(learn_answer "${LEARN_REV}/vault.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/reversing/vault.txt가 없거나 비어 있어요" "strings vault 로 비밀번호를 찾고 ./vault 에 넣어요"
  elif [[ "${answer^^}" == *ROBIN-VAULT-OPEN* ]]; then
    learn_ok "strings로 찾은 비밀번호로 금고를 열었어요"
  elif [[ "${answer}" == *robin-sesame-2026* ]]; then
    learn_bad "그건 비밀번호예요" "./vault 에 비밀번호를 넣으면 나오는 코드를 적어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "금고를 열면 '코드:' 뒤에 나오는 글자를 적어요"
  fi
}

learn_check_18() {
  local answer
  answer="$(learn_answer "${LEARN_REV}/gate.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/reversing/gate.txt가 없거나 비어 있어요" "ltrace ./gate 아무거나 로 strcmp를 봐요"
  elif [[ "${answer^^}" == *ROBIN-GATE-PASS* ]]; then
    learn_ok "ltrace로 strcmp에 넘긴 열쇠를 봤어요"
  elif [[ "${answer}" == *open-sesame-7* ]]; then
    learn_bad "그건 열쇠예요" "./gate 열쇠 로 문을 열면 나오는 코드를 적어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "문을 열면 '코드:' 뒤에 나오는 글자를 적어요"
  fi
  if ! have_cmd ltrace; then
    printf '    %sltrace가 없으면: sudo pacman -S ltrace%s\n' "${C_DIM}" "${C_RESET}"
  fi
}

learn_check_19() {
  local answer
  if [[ -e "${LEARN_REV}/.hidden/seeker.key" ]]; then
    learn_ok "seeker가 찾던 열쇠 파일(~/practice/reversing/.hidden/seeker.key)이 있어요"
  else
    learn_bad "seeker가 찾는 열쇠 파일이 아직 없어요" "strace -e trace=openat ./seeker 에 나온 경로에 파일을 만들어요"
  fi
  answer="$(learn_answer "${LEARN_REV}/seeker.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/reversing/seeker.txt가 없거나 비어 있어요" "열쇠 파일을 만든 뒤 ./seeker 가 보여 주는 코드를 적어요"
  elif [[ "${answer^^}" == *ROBIN-SEEKER-FOUND* ]]; then
    learn_ok "strace로 찾은 경로에 열쇠를 두자 코드가 나왔어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "./seeker 가 '코드:' 뒤에 보여 주는 글자를 적어요"
  fi
  if ! have_cmd strace; then
    printf '    %sstrace가 없으면: sudo pacman -S strace%s\n' "${C_DIM}" "${C_RESET}"
  fi
}

learn_check_20() {
  local answer
  answer="$(learn_answer "${LEARN_REV}/number.txt")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/reversing/number.txt가 없거나 비어 있어요" "objdump -d count --disassemble=check 의 cmp 줄을 봐요"
  elif [[ "${answer}" == "1337" ]]; then
    learn_ok "check 함수의 cmp \$0x539는 10진수로 1337이에요"
  elif [[ "${answer,,}" == "0x539" || "${answer}" == "539" ]]; then
    learn_bad "16진수 그대로예요" "echo \$((0x539)) 로 10진수로 바꿔서 적어요"
  else
    learn_bad "'${answer}'이(가) 아니에요" "cmp 줄의 \$0x... 숫자를 10진수로 바꿔요"
  fi
}

# Missions 21-25: an answer file holds a code from the practice server
learn_check_web_code() {
  local file="$1" code="$2" ok="$3" hint="$4" answer
  answer="$(learn_answer "${LEARN_WEB}/${file}")"
  if [[ -z "${answer}" ]]; then
    learn_bad "~/practice/web/${file}가 없거나 비어 있어요" "${hint}"
  elif [[ "${answer^^}" == *"${code}"* ]]; then
    learn_ok "${ok}"
  else
    learn_bad "'${answer}'이(가) 아니에요" "${hint}"
  fi
}

learn_check_21() {
  if [[ -f "${LEARN_WEB}/server.py" ]]; then
    learn_ok "연습 서버(~/practice/web/server.py)가 있어요"
  else
    learn_bad "연습 서버가 없어요" "robinctl learn show 21 을 다시 실행하면 만들어요"
  fi
  learn_check_web_code hello.txt ROBIN-WEB-HELLO "curl로 첫 페이지를 받아 코드를 찾았어요" \
    "python3 ~/practice/web/server.py 를 켜 두고 curl http://127.0.0.1:8000/"
}

learn_check_22() {
  learn_check_web_code header.txt ROBIN-WEB-HEADER "응답 헤더 X-Robin-Code를 읽었어요" \
    "curl -I http://127.0.0.1:8000/ 의 X-Robin-Code 줄을 봐요"
}

learn_check_23() {
  learn_check_web_code notes.txt ROBIN-WEB-ROBOTS "robots.txt가 감춘 /secret-notes/ 를 열었어요. 숨기는 기능이 아니에요" \
    "curl http://127.0.0.1:8000/robots.txt 의 Disallow 주소를 열어요"
}

learn_check_24() {
  local answer
  answer="$(learn_answer "${LEARN_WEB}/cookie.txt")"
  if [[ "${answer}" == *robin-practice* ]]; then
    learn_bad "그건 쿠키 값이에요" "curl -b jar.txt http://127.0.0.1:8000/me 가 보여 주는 코드를 적어요"
    return
  fi
  learn_check_web_code cookie.txt ROBIN-WEB-COOKIE "쿠키를 돌려보내 서버가 누군지 알아보게 했어요" \
    "curl -c jar.txt 로 /login 쿠키를 받고 curl -b jar.txt 로 /me 에 보내요"
}

learn_check_25() {
  learn_check_web_code redirect.txt ROBIN-WEB-REDIRECT "301과 Location을 따라 /new-page 에 갔어요" \
    "curl -L http://127.0.0.1:8000/old-page"
}

learn_check() {
  local n next
  n="$(learn_mission_arg "${1:-}")"

  printf '%s미션 %s 확인%s · %s\n\n' "${C_BOLD}" "${n}" "${C_RESET}" "$(learn_title "${n}")"
  LEARN_FAILS=0
  "learn_check_${n}"
  printf '\n'

  if ((LEARN_FAILS > 0)); then
    printf '아직이에요. %s✗%s 항목을 고친 뒤 다시 확인해요: %srobinctl learn check %s%s\n' \
      "${C_RED}" "${C_RESET}" "${C_BOLD}" "${n}" "${C_RESET}"
    return 1
  fi

  learn_mark_done "${n}"
  printf '%s%s통과했어요!%s %s/%s 완료\n' "${C_GREEN}" "${C_BOLD}" "${C_RESET}" "$(learn_done_count)" "${LEARN_COUNT}"
  if [[ "${n}" == "5" ]]; then
    printf '리눅스 기초를 끝냈어요. 6번부터는 네트워크 기초예요.\n'
  elif [[ "${n}" == "10" ]]; then
    printf '네트워크 기초를 끝냈어요. 11번부터는 포렌식 기초예요.\n'
  elif [[ "${n}" == "15" ]]; then
    printf '포렌식 기초를 끝냈어요. 16번부터는 리버싱 기초예요.\n'
  elif [[ "${n}" == "20" ]]; then
    printf '리버싱 기초를 끝냈어요. 21번부터는 웹 기초예요.\n'
  fi
  next="$(learn_next)"
  if [[ -n "${next}" ]]; then
    printf '다음 미션: %srobinctl learn show %s%s\n' "${C_BOLD}" "${next}" "${C_RESET}"
  else
    printf '학습 미션을 모두 끝냈어요. 다음은 웹 보안 랩이에요: %srobinctl lab info web%s\n' \
      "${C_BOLD}" "${C_RESET}"
  fi
}

learn_reset() {
  rm -f "${LEARN_STATE}/done" "${LEARN_STATE}"/prepared-*
  printf '미션 진행도를 초기화했어요. ~/practice 폴더는 그대로 뒀어요.\n'
}

learn() {
  if [[ "${EUID}" -eq 0 ]]; then
    die "학습 미션은 sudo 없이 내 계정으로 실행하세요"
  fi

  case "${1:-list}" in
    list)
      learn_list
      ;;
    show)
      learn_show "${2:-}"
      ;;
    check)
      learn_check "${2:-}"
      ;;
    reset)
      learn_reset
      ;;
    *)
      die "사용법: robinctl learn [list|show|check|reset] [번호]"
      ;;
  esac
}

# ---- Labs ----

lab_list() {
  cat <<'EOF'
실습 랩:
  web  OWASP Juice Shop과 DVWA로 꾸린 로컬 웹 보안 랩
EOF
}

lab_compose_file() {
  local compose_file="${PROJECT_ROOT}/labs/web/docker-compose.yml"
  [[ -f "${compose_file}" ]] || die "랩 파일이 없어요: ${compose_file}"
  # Docker comes with the web profile (not in the live ISO or a fresh install)
  have_cmd docker || die "랩은 Docker로 돌아가요. web 프로필을 먼저 설치하세요: sudo robinctl profile web"
  printf '%s' "${compose_file}"
}

lab_info() {
  case "${1:-}" in
    web)
      cat <<'EOF'
RobinOS 웹 랩

실습 대상:
  OWASP Juice Shop  http://localhost:3000
  DVWA              http://localhost:8080

명령:
  robinctl lab start web     시작 (처음에는 이미지를 내려받아서 몇 분 걸려요)
  robinctl lab status web    상태
  robinctl lab stop web      중지 (다 쓰면 꼭 꺼 두세요)

DVWA 처음 쓸 때:
  1. http://localhost:8080/setup.php 에서 "Create / Reset Database"를 눌러요
  2. admin / password 로 로그인해요
  3. "DVWA Security"에서 난이도(low부터)를 골라요

두 대상 모두 내 컴퓨터 안에서만 열리는 학습용 환경이에요.
Docker가 필요해서 web 프로필이 있어야 해요: sudo robinctl profile web
EOF
      ;;
    *)
      die "알 수 없는 랩이에요: ${1:-}"
      ;;
  esac
}

lab_run() {
  local action="$1"
  local lab="${2:-}"
  local compose_file

  [[ "${lab}" == "web" ]] || die "알 수 없는 랩이에요: ${lab}"
  compose_file="$(lab_compose_file)"

  case "${action}" in
    status)
      lab_docker compose -f "${compose_file}" ps
      ;;
    start)
      if ! systemctl is-active --quiet docker.service 2>/dev/null; then
        printf 'Docker를 켜요.\n'
        lab_sudo systemctl start docker.service
      fi
      lab_docker compose -f "${compose_file}" up -d
      printf '\n다 쓴 뒤에는 꺼 두세요: robinctl lab stop web\n'
      ;;
    stop)
      lab_docker compose -f "${compose_file}" down
      ;;
  esac
}

# Docker needs root. RobinOS doesn't put users in the docker group, which would
# be root without a password for anything running as the user; labs ask for
# sudo instead when the Docker socket isn't writable.
LAB_SUDO_NOTED="false"
lab_sudo() {
  if [[ "${EUID}" -eq 0 || -w /var/run/docker.sock ]]; then
    "$@"
    return
  fi
  if [[ "${LAB_SUDO_NOTED}" != "true" ]]; then
    printf '%s랩은 Docker로 돌아가서 관리자 권한이 필요해요. 비밀번호를 물으면 입력하세요.%s\n' \
      "${C_DIM}" "${C_RESET}" >&2
    LAB_SUDO_NOTED="true"
  fi
  sudo "$@"
}

lab_docker() {
  lab_sudo docker "$@"
}

main() {
  case "${1:-}" in
    version)
      print_version
      ;;
    doctor)
      doctor
      ;;
    update)
      shift
      update_system "${1:-}"
      ;;
    snapshot)
      shift
      case "${1:-}" in
        create)
          snapshot_create "${2:-}"
          ;;
        list)
          snapshot_list
          ;;
        setup)
          snapshot_setup "${2:-}"
          ;;
        rollback)
          snapshot_rollback "${2:-}" "${3:-}"
          ;;
        *)
          die "사용법: robinctl snapshot create|list|setup|rollback"
          ;;
      esac
      ;;
    profile)
      shift
      case "${1:-}" in
        list|"")
          profile_list
          ;;
        *)
          profile_known "$1" || die "알 수 없는 프로필이에요: $1 (목록: robinctl profile list)"
          profile_install "$1" "${2:-}"
          ;;
      esac
      ;;
    packages)
      shift
      packages_print "${1:-}"
      ;;
    learn)
      shift
      learn "$@"
      ;;
    lab)
      shift
      case "${1:-}" in
        list)
          lab_list
          ;;
        info)
          shift
          lab_info "${1:-}"
          ;;
        status|start|stop)
          lab_run "$1" "${2:-}"
          ;;
        *)
          die "사용법: robinctl lab list|info|status|start|stop"
          ;;
      esac
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      die "알 수 없는 명령이에요: ${1} (robinctl help로 목록을 볼 수 있어요)"
      ;;
  esac
}

main "$@"
