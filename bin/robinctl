    return
  fi
  learn_check_web_code cookie.txt ROBIN-WEB-COOKIE "쿠키를 돌려보내 서버가 누군지 알아보게 했어요" \
    "curl -c jar.txt 로 /login 쿠키를 받고 curl -b jar.txt 로 /me 에 보내요"
}

learn_check_25() {
  learn_check_web_code redirect.txt ROBIN-WEB-REDIRECT "301과 Location을 따라 /new-page 에 갔어요" \
    "curl -L http://127.0.0.1:8000/old-page"
}

# ---- Shell basics (26-30) ----

learn_check_26() {
  local file="${LEARN_SHELL}/home.txt" first
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/shell/home.txt가 없거나 비어 있어요" 'mkdir -p ~/practice/shell 후 echo $HOME > ~/practice/shell/home.txt'
    return
  fi
  first="$(head -n 1 "${file}" | tr -d '\r')"
  if [[ "${first}" == "${HOME}" ]]; then
    learn_ok "첫 줄이 내 홈 폴더(${HOME})예요"
  else
    learn_bad "첫 줄이 내 홈 폴더가 아니에요 (지금: '${first}')" '직접 쓰지 말고 echo $HOME 의 결과를 > 로 저장해 보세요'
  fi
  if grep -qx "$(id -un)" "${file}"; then
    learn_ok "내 사용자 이름($(id -un))도 있어요"
  else
    learn_bad "내 사용자 이름이 한 줄로 들어 있지 않아요" 'echo $USER >> ~/practice/shell/home.txt'
  fi
}

learn_check_27() {
  local file="${LEARN_SHELL}/ls-path.txt" written real
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/shell/ls-path.txt가 없거나 비어 있어요" "which ls > ~/practice/shell/ls-path.txt"
    return
  fi
  written="$(head -n 1 "${file}" | tr -d '\r' | sed 's/[[:space:]]*$//')"
  real="$(command -v ls)"
  if [[ "${written}" != /* ]]; then
    learn_bad "전체 경로가 아니에요 (지금: '${written}')" "경로는 /로 시작해요. which ls가 알려 주는 그대로 저장해요"
  elif [[ -x "${written}" && "$(realpath "${written}" 2>/dev/null)" == "$(realpath "${real}")" ]]; then
    learn_ok "ls 명령은 ${written}에 있어요"
  else
    learn_bad "ls가 있는 곳이 아니에요 (지금: '${written}')" "which ls 를 다시 실행해 보세요"
  fi
}

learn_check_28() {
  local rc="${HOME}/.bashrc" line
  line="$(grep -E "^[[:space:]]*alias[[:space:]]+practice=" "${rc}" 2>/dev/null | tail -n 1 || true)"
  if [[ -z "${line}" ]]; then
    learn_bad "~/.bashrc에 practice 별명이 없어요" "echo \"alias practice='cd ~/practice'\" >> ~/.bashrc"
    return
  fi
  learn_ok "~/.bashrc에 practice 별명이 있어요"
  if [[ "${line}" == *cd* && "${line}" == *practice* ]]; then
    learn_ok "practice를 치면 연습 폴더로 가요"
  else
    learn_bad "별명이 연습 폴더로 가는 명령이 아니에요 (지금: ${line})" "alias practice='cd ~/practice' 처럼 써요"
  fi
}

learn_check_29() {
  local script="${LEARN_SHELL}/greet.sh" output
  if [[ ! -f "${script}" ]]; then
    learn_bad "~/practice/shell/greet.sh가 없어요" "cd ~/practice/shell 후 nano greet.sh"
    return
  fi
  if [[ ! -x "${script}" ]]; then
    learn_bad "실행 권한(x)이 없어요" "chmod +x ~/practice/shell/greet.sh"
    return
  fi
  learn_ok "greet.sh에 실행 권한이 있어요"
  output="$(cd "${LEARN_SHELL}" && timeout 5 ./greet.sh robin-check-29 2>&1 </dev/null || true)"
  if [[ "${output}" == *robin-check-29* ]]; then
    learn_ok "./greet.sh robin-check-29 를 실행하면 '${output%%$'\n'*}'라고 나와요"
  elif [[ "${output}" == *'$1'* ]]; then
    learn_bad "\$1이 글자 그대로 나와요" "작은따옴표(' ') 안에서는 변수가 바뀌지 않아요. 큰따옴표(\" \")로 감싸요"
  else
    learn_bad "넘긴 값이 출력에 없어요 (지금: '${output%%$'\n'*}')" 'echo "안녕, $1" 줄이 있는지 확인해 보세요'
  fi
}

learn_check_30() {
  local file="${LEARN_SHELL}/exit-codes.txt" first second
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/shell/exit-codes.txt가 없거나 비어 있어요" "robinctl learn show 30의 마지막 명령을 따라 해 보세요"
    return
  fi
  first="$(sed -n 1p "${file}" | tr -d '\r[:space:]')"
  second="$(sed -n 2p "${file}" | tr -d '\r[:space:]')"
  if [[ "${first}" == "0" ]]; then
    learn_ok "성공한 ls의 종료 코드는 0이에요"
  else
    learn_bad "첫 줄이 0이 아니에요 (지금: '${first}')" "성공한 명령 바로 뒤에 echo \$? 를 해요"
  fi
  if [[ "${second}" =~ ^[1-9][0-9]*$ ]]; then
    learn_ok "실패한 ls의 종료 코드는 ${second}예요 (0이 아니면 실패)"
  else
    learn_bad "둘째 줄이 0이 아닌 숫자가 아니에요 (지금: '${second}')" "없는 폴더를 ls 한 바로 뒤에 echo \$? 를 해요"
  fi
}

# ---- System basics (31-35) ----

# The PID written for mission 31, or nothing
learn_sleep_pid() {
  local pid
  pid="$(head -n 1 "${LEARN_SYSTEM}/sleep.pid" 2>/dev/null | tr -d '\r[:space:]')"
  [[ "${pid}" =~ ^[0-9]+$ ]] && printf '%s' "${pid}"
}

learn_check_31() {
  local pid
  pid="$(learn_sleep_pid)"
  if [[ -z "${pid}" ]]; then
    learn_bad "~/practice/system/sleep.pid에 PID(숫자)가 없어요" 'sleep 600 & 다음에 echo $! > ~/practice/system/sleep.pid'
    return
  fi
  if [[ ! -r "/proc/${pid}/comm" ]]; then
    learn_bad "PID ${pid}인 프로세스가 지금 없어요" "sleep 600 & 로 다시 실행하고 새 PID를 저장해요"
  elif [[ "$(<"/proc/${pid}/comm")" != "sleep" ]]; then
    learn_bad "PID ${pid}는 sleep이 아니라 $(<"/proc/${pid}/comm")이에요" "pgrep -a sleep 으로 sleep의 PID를 찾아요"
  else
    learn_ok "PID ${pid}가 실행 중인 sleep이에요"
  fi
}

learn_check_32() {
  local pid
  pid="$(learn_sleep_pid)"
  if [[ -z "${pid}" ]]; then
    learn_bad "~/practice/system/sleep.pid가 없어요" "미션 31을 먼저 해요: robinctl learn show 31"
  elif [[ -r "/proc/${pid}/comm" && "$(<"/proc/${pid}/comm")" == "sleep" ]]; then
    learn_bad "PID ${pid}인 sleep이 아직 돌고 있어요" "kill ${pid}"
  else
    learn_ok "PID ${pid}인 sleep을 끝냈어요"
  fi
}

learn_check_33() {
  local file="${LEARN_SYSTEM}/disk.txt" written actual
  written="$(grep -oE '[0-9]+' "${file}" 2>/dev/null | head -n 1 || true)"
  if [[ -z "${written}" ]]; then
    learn_bad "~/practice/system/disk.txt에 %가 없어요" "df --output=pcent / | tail -n 1 > ~/practice/system/disk.txt"
    return
  fi
  actual="$(df --output=pcent / | tail -n 1 | tr -dc '0-9')"
  # The disk keeps changing a little while you work
  if ((written >= actual - 2 && written <= actual + 2)); then
    learn_ok "/(루트)가 ${actual}% 차 있어요"
  else
    learn_bad "${written}%라고 적었는데 지금 /는 ${actual}%예요" "df -h / 의 Use% 칸을 봐요"
  fi
}

learn_check_34() {
  local file="${LEARN_SYSTEM}/service.txt" written actual
  written="$(head -n 1 "${file}" 2>/dev/null | tr -d '\r[:space:]' || true)"
  if [[ -z "${written}" ]]; then
    learn_bad "~/practice/system/service.txt가 없거나 비어 있어요" "systemctl is-active NetworkManager > ~/practice/system/service.txt"
    return
  fi
  actual="$(systemctl is-active NetworkManager 2>/dev/null || true)"
  if [[ "${written}" == "${actual}" ]]; then
    learn_ok "NetworkManager는 지금 ${actual}이에요"
  else
    learn_bad "'${written}'이라고 적었는데 지금은 '${actual}'이에요" "systemctl is-active NetworkManager 의 결과를 그대로 저장해요"
  fi
}

learn_check_35() {
  local file="${LEARN_SYSTEM}/kernel.txt"
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/system/kernel.txt가 없거나 비어 있어요" "journalctl -k -b | grep \"Linux version\" 또는 uname -r"
  elif grep -qF "$(uname -r)" "${file}"; then
    learn_ok "커널 버전 $(uname -r)을 찾았어요"
  else
    learn_bad "지금 커널 버전($(uname -r))이 들어 있지 않아요" "uname -r > ~/practice/system/kernel.txt"
  fi
}

# ---- Security basics (36-40) ----

learn_check_36() {
  local file="${LEARN_SEC}/groups.txt" group missing=()
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/security/groups.txt가 없거나 비어 있어요" "id -Gn > ~/practice/security/groups.txt"
    return
  fi
  for group in $(id -Gn); do
    grep -qw -- "${group}" "${file}" || missing+=("${group}")
  done
  if ((${#missing[@]} > 0)); then
    learn_bad "빠진 그룹이 있어요: ${missing[*]}" "id -Gn 이 보여 주는 그룹을 모두 저장해요"
  elif id -Gn | grep -qw wheel; then
    learn_ok "그룹 $(id -Gn | wc -w)개를 찾았어요. wheel에 들어 있어서 sudo를 쓸 수 있어요"
  else
    learn_ok "그룹 $(id -Gn | wc -w)개를 찾았어요. wheel이 없어서 이 계정은 sudo를 못 써요"
  fi
}

learn_check_37() {
  local file="${LEARN_SEC}/secret.txt" mode
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/security/secret.txt가 없거나 비어 있어요" "echo \"나만 보는 메모\" > ~/practice/security/secret.txt"
    return
  fi
  mode="$(stat -c %a "${file}")"
  if [[ "${mode}" == "600" ]]; then
    learn_ok "secret.txt는 나만 읽고 쓸 수 있어요 (600, -rw-------)"
  else
    learn_bad "secret.txt의 권한이 ${mode}이에요. 600이어야 해요" "chmod 600 ~/practice/security/secret.txt"
  fi
}

learn_check_38() {
  local key="${HOME:-/root}/.ssh/id_ed25519"
  if [[ ! -f "${key}.pub" || ! -f "${key}" ]]; then
    learn_bad "~/.ssh/id_ed25519와 id_ed25519.pub가 없어요" "ssh-keygen -t ed25519"
    return
  fi
  if grep -qE '^ssh-ed25519 [A-Za-z0-9+/=]+' "${key}.pub"; then
    learn_ok "공개 열쇠 id_ed25519.pub가 있어요 (남에게 줘도 돼요)"
  else
    learn_bad "id_ed25519.pub가 ed25519 공개 열쇠 모양이 아니에요" "ssh-keygen -t ed25519 로 다시 만들어요"
  fi
  if [[ "$(stat -c %a "${key}")" == "600" ]]; then
    learn_ok "개인 열쇠 id_ed25519는 나만 읽을 수 있어요 (600)"
  else
    learn_bad "개인 열쇠의 권한이 $(stat -c %a "${key}")이에요. 600이어야 해요" "chmod 600 ~/.ssh/id_ed25519"
  fi
}

learn_check_39() {
  local file="${LEARN_SEC}/tampered.txt" answer written
  answer="$(head -n 1 "${LEARN_STATE}/tampered-39" 2>/dev/null || true)"
  if [[ -z "${answer}" ]]; then
    learn_bad "연습용 파일이 아직 없어요" "robinctl learn show 39"
    return
  fi
  written="$(head -n 1 "${file}" 2>/dev/null | tr -d '\r[:space:]' || true)"
  written="${written##*/}"
  if [[ -z "${written}" ]]; then
    learn_bad "~/practice/security/tampered.txt가 없거나 비어 있어요" "sha256sum -c SHA256SUMS 에서 FAILED인 파일 이름을 저장해요"
  elif [[ "${written}" == "${answer}" ]]; then
    learn_ok "${answer}가 SHA256SUMS와 맞지 않아요. 이런 파일은 열지 말고 지워요"
  else
    learn_bad "${written}는 SHA256SUMS와 맞아요" "sha256sum -c SHA256SUMS 의 FAILED 줄을 봐요"
  fi
}

learn_check_40() {
  local file="${LEARN_SEC}/secret.txt.gpg" plain="${LEARN_SEC}/secret.txt" first
  if [[ ! -s "${file}" ]]; then
    learn_bad "~/practice/security/secret.txt.gpg가 없어요" "cd ~/practice/security && gpg -c secret.txt"
    return
  fi
  if ! file -b "${file}" | grep -q 'PGP symmetric key encrypted'; then
    learn_bad "secret.txt.gpg가 비밀번호로 암호화한 파일이 아니에요" "gpg -c secret.txt (gpg -e는 공개 열쇠 방식이에요)"
    return
  fi
  first="$(head -n 1 "${plain}" 2>/dev/null || true)"
  if [[ -n "${first}" ]] && grep -qF -- "${first}" "${file}"; then
    learn_bad "secret.txt.gpg 안에 원래 글이 그대로 보여요" "gpg -c secret.txt 로 다시 암호화해요"
  else
    learn_ok "secret.txt.gpg는 비밀번호로 잠근 파일이에요. 열 때는 gpg -d"
  fi
}

# The first mission of n's group, and the first of the next group (or one past the last)
learn_text_answer() {
  sed -n "s/^$1=//p" "${LEARN_STATE}/text-answers" 2>/dev/null | head -n 1
}

# The first word of a learner's answer file, without Windows line ends
learn_text_written() {
  head -n 1 "${LEARN_TEXT}/$1" 2>/dev/null | tr -d '\r' | awk '{print $1}' || true
}

learn_check_41() {
  local want written
  want="$(learn_text_answer 404)"
  if [[ -z "${want}" ]]; then
    learn_bad "연습 파일이 아직 없어요" "robinctl learn show 41"
    return
  fi
  written="$(learn_text_written 404.txt)"
  if [[ -z "${written}" ]]; then
    learn_bad "~/practice/text/404.txt가 없거나 비어 있어요" "grep -c ' 404 ' access.log > 404.txt"
  elif [[ "${written}" == "${want}" ]]; then
    learn_ok "404 응답이 ${want}번이에요. 없는 페이지를 자꾸 찾는 건 누가 사이트를 훑는다는 신호예요"
  else
    learn_bad "404 응답은 ${written}번이 아니에요" "grep ' 404 ' access.log | wc -l 로 다시 세 봐요"
  fi
}

learn_check_42() {
  local want written
  want="$(learn_text_answer top)"
  if [[ -z "${want}" ]]; then
    learn_bad "연습 파일이 아직 없어요" "robinctl learn show 42"
    return
  fi
  written="$(learn_text_written top-ip.txt)"
  if [[ -z "${written}" ]]; then
    learn_bad "~/practice/text/top-ip.txt가 없거나 비어 있어요" "cut -d' ' -f1 access.log | sort | uniq -c | sort -rn | head -n 3"
  elif [[ "${written}" == "${want}" ]]; then
    learn_ok "${want}가 가장 많이 왔어요. 다음 미션에서 무엇을 찾았는지 봐요"
  else
    learn_bad "${written}는 가장 많이 온 주소가 아니에요" "uniq -c 결과를 sort -rn으로 큰 순서로 줄 세워 봐요"
  fi
}

learn_check_43() {
  local want got
  want="$(sort -u "${LEARN_STATE}/text-paths" 2>/dev/null || true)"
  if [[ -z "${want}" ]]; then
    learn_bad "연습 파일이 아직 없어요" "robinctl learn show 43"
    return
  fi
  if [[ ! -s "${LEARN_TEXT}/paths.txt" ]]; then
    learn_bad "~/practice/text/paths.txt가 없거나 비어 있어요" "awk '\$1 == \"주소\" {print \$7}' access.log | sort -u > paths.txt"
    return
  fi
  got="$(tr -d '\r' <"${LEARN_TEXT}/paths.txt" | awk 'NF {print $1}' | sort -u)"
  if [[ "${got}" == "${want}" ]]; then
    learn_ok "관리자 페이지와 숨은 파일을 찾고 있었어요: $(printf '%s' "${want}" | tr '\n' ' ')"
  elif [[ "$(printf '%s\n' "${got}" | wc -l)" -gt "$(printf '%s\n' "${want}" | wc -l)" ]]; then
    learn_bad "다른 주소가 요청한 경로도 섞였어요" "awk에 \$1 == \"주소\" 조건을 붙여요"
  else
    learn_bad "그 주소가 요청한 경로가 빠졌거나 달라요" "awk '\$1 == \"주소\" {print \$7}' access.log | sort -u"
  fi
}

learn_check_44() {
  local out="${LEARN_TEXT}/masked.ini" password
  if [[ ! -f "${LEARN_STATE}/text-config.ini" ]]; then
    learn_bad "연습 파일이 아직 없어요" "robinctl learn show 44"
    return
  fi
  if [[ ! -s "${out}" ]]; then
    learn_bad "~/practice/text/masked.ini가 없어요" "sed 's/^password=.*/password=***/' config.ini > masked.ini"
    return
  fi
  while IFS= read -r password; do
    if [[ -n "${password}" ]] && grep -qF -- "${password}" "${out}"; then
      learn_bad "masked.ini에 비밀번호가 그대로 보여요" "sed 's/^password=.*/password=***/' config.ini > masked.ini"
      return
    fi
  done <"${LEARN_STATE}/text-passwords"
  # Compared in bash: diff (diffutils) isn't in Arch's base
  if [[ "$(sed 's/^password=.*/password=***/' "${LEARN_STATE}/text-config.ini")" == "$(tr -d '\r' <"${out}")" ]]; then
    learn_ok "비밀번호 세 개를 가렸고 나머지 줄은 그대로예요"
  else
    learn_bad "비밀번호 말고 다른 줄도 바뀌었거나 빠졌어요" "diff config.ini masked.ini 로 바뀐 줄을 봐요"
  fi
}

learn_check_45() {
  local want written
  want="$(learn_text_answer added)"
  if [[ -z "${want}" ]]; then
    learn_bad "연습 파일이 아직 없어요" "robinctl learn show 45"
    return
  fi
  # "> backup" straight from diff counts too
  written="$(head -n 1 "${LEARN_TEXT}/added.txt" 2>/dev/null | tr -d '\r' | sed 's/^[>[:space:]]*//' | awk '{print $1}' || true)"
  if [[ -z "${written}" ]]; then
    learn_bad "~/practice/text/added.txt가 없거나 비어 있어요" "diff users-old.txt users-new.txt"
  elif [[ "${written}" == "${want}" ]]; then
    learn_ok "${want} 계정이 새로 생겼어요. 내가 만든 게 아니면 누가 만들었는지 확인해야 해요"
  else
    learn_bad "${written}는 새로 생긴 이름이 아니에요" "diff 결과에서 > 로 시작하는 줄을 봐요"
  fi
}

learn_group_first() {
  local i="$1"
  while [[ -z "$(learn_group "${i}")" ]]; do
    i=$((i - 1))
  done
  printf '%s' "${i}"
}

learn_group_end() {
  local i=$(($1 + 1))
  while ((i <= LEARN_COUNT)) && [[ -z "$(learn_group "${i}")" ]]; do
    i=$((i + 1))
  done
  printf '%s' "${i}"
}

learn_group_complete() {
  local first end i
  first="$(learn_group_first "$1")"
  end="$(learn_group_end "${first}")"
  for ((i = first; i < end; i++)); do
    learn_is_done "${i}" || return 1
  done
}

# A desktop notification as well, when there is a desktop (the shell's toasts)
learn_notify() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=RobinOS "$1" "$2" >/dev/null 2>&1 || true
  fi
}

learn_check() {
  local n next was_done=0 first end title body
  n="$(learn_mission_arg "${1:-}")"

  printf '%s미션 %s 확인%s · %s\n\n' "${C_BOLD}" "${n}" "${C_RESET}" "$(learn_title "${n}")"
  LEARN_FAILS=0
  "learn_check_${n}"
  printf '\n'

  if ((LEARN_FAILS > 0)); then
    printf '아직이에요. %s✗%s 항목을 고친 뒤 다시 확인해요: %srobinctl learn check %s%s\n' \
      "${C_RED}" "${C_RESET}" "${C_BOLD}" "${n}" "${C_RESET}"
    return 1
  fi

  learn_is_done "${n}" && was_done=1
  learn_mark_done "${n}"
  printf '%s%s통과했어요!%s %s/%s 완료\n' "${C_GREEN}" "${C_BOLD}" "${C_RESET}" "$(learn_done_count)" "${LEARN_COUNT}"
  # The mission that finished a whole group, in whatever order it was solved
  if ((was_done == 0)) && learn_group_complete "${n}"; then
    first="$(learn_group_first "${n}")"
    end="$(learn_group_end "${first}")"
    title="$(learn_group "${first}")를 끝냈어요"
    if ((end <= LEARN_COUNT)); then
      body="다음은 $(learn_group "${end}")예요: robinctl learn show ${end}"
    else
      body="마지막 묶음이에요."
    fi
    printf '%s. %s\n' "${title}" "${body}"
    if [[ "$(learn_done_count)" == "${LEARN_COUNT}" ]]; then
      learn_notify "학습 미션 ${LEARN_COUNT}개를 모두 끝냈어요" "이제 입문 CTF에 도전해요: robinctl ctf"
    else
      learn_notify "${title}" "${body}"
    fi
  fi
  next="$(learn_next)"
  if [[ -n "${next}" ]]; then
    printf '다음 미션: %srobinctl learn show %s%s\n' "${C_BOLD}" "${next}" "${C_RESET}"
  else
    printf '학습 미션을 모두 끝냈어요. 이제 입문 CTF에 도전해요: %srobinctl ctf%s\n' \
      "${C_BOLD}" "${C_RESET}"
  fi
}

learn_reset() {
  rm -f "${LEARN_STATE}/done" "${LEARN_STATE}"/prepared-*
  printf '미션 진행도를 초기화했어요. ~/practice 폴더는 그대로 뒀어요.\n'
}

learn() {
  if [[ "${EUID}" -eq 0 ]]; then
    die "학습 미션은 sudo 없이 내 계정으로 실행하세요"
  fi

  case "${1:-list}" in
    list)
      learn_list
      ;;
    show)
      learn_show "${2:-}"
      ;;
    check)
      learn_check "${2:-}"
      ;;
    reset)
      learn_reset
      ;;
    tsv)
      learn_tsv
      ;;
    *)
      die "사용법: robinctl learn [list|show|check|reset] [번호]"
      ;;
  esac
}

# ---- Local CTF (robinctl ctf): ten beginner challenges that mix the missions' skills ----
#
# The files go to ~/practice/ctf. Flags look like ROBIN{...}; robinctl keeps only
# their SHA-256, so the answers aren't sitting in this script. Challenge 5 uses
# the web practice server (practice/web/server.py, /ctf and /ctf/admin). Challenge 9
# starts a small server that only listens on 127.0.0.1 (ctf_door), for an hour.

readonly CTF_COUNT=10
CTF_DIR="${HOME:-/root}/practice/ctf"
CTF_STATE="${XDG_STATE_HOME:-${HOME:-/root}/.local/state}/robinos/ctf"

ctf_title() {
  case "$1" in
    1) printf '숨은 파일' ;;
    2) printf '두 번 감싼 쪽지' ;;
    3) printf '로그 속 이상한 요청' ;;
    4) printf '네 자리 자물쇠' ;;
    5) printf '관리자 쿠키' ;;
    6) printf '바꿔치기된 파일' ;;
    7) printf '열리지 않는 금고' ;;
    8) printf '약한 비밀번호' ;;
    9) printf '포트 뒤의 목소리' ;;
    10) printf '사진 속 압축 파일' ;;
  esac
}

ctf_skill() {
  case "$1" in
    1) printf '리눅스' ;;
    2) printf '인코딩' ;;
    3) printf '포렌식' ;;
    4) printf '스크립트' ;;
    5) printf '웹' ;;
    6) printf '무결성' ;;
    7) printf '권한' ;;
    8) printf '암호화' ;;
    9) printf '네트워크' ;;
    10) printf '포렌식' ;;
  esac
}

ctf_flag_sha256() {
  case "$1" in
    1) printf '85778925b269d04dec30a117d5ae71afbc32de1ee2efd8ac83fa87f88cf3d056' ;;
    2) printf '2d6a047f7c9fe0a0569e6d58c314a0828cde16161f03b050621a898f2cc94c2c' ;;
    3) printf 'ce88290753a6557a0b8cb0e828e60ef2274dbc21169a4d8c1cafb3201f0f27d7' ;;
    4) printf '189d042558322f318e8321cda50e25abf721bd241091f077cea30226801904de' ;;
    5) printf 'fd1f7ca1df6a1102abeebc4787af77f199062f8260eebd1867f89077bb898bfd' ;;
    6) printf '0f8c1724cf81dc0dc4fb1e830c5f29c83256919887b681452acb0d1e5c243855' ;;
    7) printf '53fa755fd292e9d772fe9cba73b5fcf1bf13b7db34c646343b3313b6b9d351d7' ;;
    8) printf '31c1ea276ce937e4a3d16019136e0103f8da6bb3a53a419046f9fd05c2e2cf48' ;;
    9) printf '7200ea1f6def0fcbd2d3c55e50b3217834455f308872fba290f4d0873ce823dd' ;;
    10) printf 'a7241ea574c719ff5986782739d745a2bbb33182fbee2129c54e47a647b2f89f' ;;
  esac
}

ctf_is_solved() {
  [[ -f "${CTF_STATE}/solved" ]] && grep -qx "$1" "${CTF_STATE}/solved"
}

ctf_solved_count() {
  local count=0 i
  for ((i = 1; i <= CTF_COUNT; i++)); do
    if ctf_is_solved "${i}"; then
      count=$((count + 1))
    fi
  done
  printf '%s' "${count}"
}

# Text from hex bytes XOR-ed with 0x5a, so the flag isn't plain in this file
ctf_unxor() {
  local hex="$1" out="" i
  for ((i = 0; i < ${#hex}; i += 2)); do
    printf -v out '%s\\x%02x' "${out}" "$((0x${hex:i:2} ^ 0x5a))"
  done
  printf '%b' "${out}"
}

# Challenge 3: a made-up web server log; one request carries the flag in hex.
# Addresses are documentation ranges only (RFC 5737).
ctf_access_log() {
  local i path
  for i in $(seq 1 18); do
    case $((i % 6)) in
      0) path="/" ;;
      1) path="/about" ;;
      2) path="/images/logo.png" ;;
      3) path="/search?q=robinos" ;;
      4) path="/login" ;;
      5) path="/favicon.ico" ;;
    esac
    printf '198.51.100.%s - - [08/Oct/2026:14:%02d:%02d +0900] "GET %s HTTP/1.1" 200 %s "-" "Mozilla/5.0"\n' \
      "$((10 + i % 4))" "$((i / 2))" "$((i * 3 % 60))" "${path}" "$((512 + i * 37))"
    if ((i == 11)); then
      printf '203.0.113.77 - - [08/Oct/2026:14:05:42 +0900] "GET /search?q=524f42494e7b6865785f696e5f7468655f6c6f67737d HTTP/1.1" 404 153 "-" "curl/8.0"\n'
    fi
  done
}

# Challenge 4: a 4-digit lock; the PIN's SHA-256 is inside, which is the weakness
ctf_lock_py() {
  cat <<'EOF'
#!/usr/bin/env python3
"""RobinOS CTF 4: 네 자리 비밀번호(0000~9999)로 잠긴 상자예요."""
import hashlib
import sys

PIN_SHA256 = "a388f562e286fdf28986f9253579f4d096446e01dd0c771996a51ff11b390fa2"
LOCKED = bytes.fromhex("a2d44ec8b8cbb9d7e2ab39353146a7ebdd1ce1a170b6ad608f1377")

pin = sys.argv[1] if len(sys.argv) > 1 else input("비밀번호 네 자리: ").strip()
if hashlib.sha256(pin.encode()).hexdigest() != PIN_SHA256:
    print("틀렸어요.")
    sys.exit(1)
key = hashlib.sha256(("robinos-lock-" + pin).encode()).digest()
print("열렸어요! " + bytes(b ^ key[i % len(key)] for i, b in enumerate(LOCKED)).decode())
EOF
}

# Challenge 6: twelve downloads and their SHA256SUMS. Every file carries a flag-shaped
# decoy, so grep alone doesn't help; the one changed after the list has the real flag.
ctf_downloads() {
  local dir="${CTF_DIR}/6" i pick
  rm -rf "${dir}"
  mkdir -p "${dir}"
  for i in $(seq -w 1 12); do
    printf 'RobinOS 도구 %s\nROBIN{not_this_one_%s}\n' "${i}" "${i}" >"${dir}/tool-${i}.bin"
  done
  (cd "${dir}" && sha256sum tool-*.bin >SHA256SUMS)
  pick="$(printf '%02d' $((RANDOM % 12 + 1)))"
  { printf 'RobinOS 도구 %s\n' "${pick}"; ctf_unxor '0815181314212c3f28333c2305383f3c35283f0523352f05282f3427'; printf '\n'; } \
    >"${dir}/tool-${pick}.bin"
}

# Challenge 8: a note locked with a password from a list of common ones
ctf_weak_gpg() {
  local dir="${CTF_DIR}/8" home
  rm -rf "${dir}"
  mkdir -p "${dir}"
  printf '%s\n' 123456 password qwerty 111111 iloveyou dragon monkey letmein football baseball \
    abc123 admin welcome master sunshine princess shadow superman michael 1q2w3e4r \
    qwer1234 asdf1234 zxcvbnm passw0rd starwars whatever trustno1 hello123 freedom 000000 >"${dir}/passwords.txt"
  command -v gpg >/dev/null 2>&1 || return 0
  home="$(mktemp -d)"
  ctf_unxor '081518131421293235282e052a3b29292d35283e29053c3b3636053c3b292e27' \
    | GNUPGHOME="${home}" gpg --batch --quiet --pinentry-mode loopback --passphrase sunshine -c -o "${dir}/note.txt.gpg" 2>/dev/null || true
  gpgconf --homedir "${home}" --kill gpg-agent >/dev/null 2>&1 || true
  rm -rf "${home}"
}

# Challenge 10: a small PNG with a zip glued to its end; image viewers show the picture
ctf_photo() {
  local dir="${CTF_DIR}/10"
  rm -rf "${dir}"
  mkdir -p "${dir}"
  ctf_unxor '0815181314213c33363f2905333429333e3f053c33363f2927' | python3 -c '
import io, struct, sys, zipfile, zlib
flag, out = sys.stdin.read(), sys.argv[1]
def chunk(kind, data):
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
rows = b"".join(b"\x00" + bytes(c for x in range(64) for c in ((200, 40, 40) if (x // 8 + y // 8) % 2 else (250, 250, 250))) for y in range(64))
png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 64, 64, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b"")
buf = io.BytesIO()
with zipfile.ZipFile(buf, "w") as z:
    z.writestr("secret.txt", flag + "\n")
open(out, "wb").write(png + buf.getvalue())
' "${dir}/photo.png"
}

# Challenge 9: a small server on a random 127.0.0.1 port that tells whoever connects
# the flag. The flag goes in on stdin, so ps and /proc/PID/cmdline don't show it.
ctf_door() {
  local port pid
  if [[ -f "${CTF_STATE}/door" ]]; then
    read -r port pid <"${CTF_STATE}/door" || true
    if [[ -n "${pid:-}" && -r "/proc/${pid}/cmdline" ]] && grep -q ctf-door "/proc/${pid}/cmdline" 2>/dev/null; then
      return
    fi
  fi
  mkdir -p "${CTF_STATE}"
  cat >"${CTF_STATE}/ctf-door.py" <<'EOF'
import socket, sys, time
flag = sys.stdin.read().strip()
server = socket.socket()
server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
server.bind(("127.0.0.1", int(sys.argv[1])))
server.listen(5)
# An hour after it started, visitors or not (docs/ethics.md); the tests pass seconds
deadline = time.monotonic() + (int(sys.argv[2]) if len(sys.argv) > 2 else 3600)
while True:
    left = deadline - time.monotonic()
    if left <= 0:
        break
    server.settimeout(left)
    try:
        conn, _ = server.accept()
    except socket.timeout:
        break
    conn.sendall(("RobinOS CTF 9: 잘 찾아왔어요! " + flag + "\n").encode())
    conn.close()
EOF
  port=$((4000 + RANDOM % 1000))
  ctf_unxor '0815181314213633292e3f3433343d053534053635393b363235292e27' \
    | nohup python3 "${CTF_STATE}/ctf-door.py" "${port}" >/dev/null 2>&1 &
  printf '%s %s\n' "${port}" "$!" >"${CTF_STATE}/door"
  disown 2>/dev/null || true
}

ctf_prepare() {
  # Made again when any challenge file was deleted (solved ones stay solved)
  if [[ -f "${CTF_STATE}/prepared" && -f "${CTF_DIR}/1/.archive/.old/.flag" && -f "${CTF_DIR}/2/note.txt" \
    && -f "${CTF_DIR}/3/access.log" && -f "${CTF_DIR}/4/lock.py" && -f "${CTF_DIR}/6/SHA256SUMS" \
    && -e "${CTF_DIR}/7/vault.txt" && -f "${CTF_DIR}/8/passwords.txt" && -f "${CTF_DIR}/10/photo.png" ]]; then
    return
  fi
  mkdir -p "${CTF_DIR}/1/.archive/.old" "${CTF_DIR}/2" "${CTF_DIR}/3" "${CTF_DIR}/4" "${CTF_DIR}/7" "${CTF_STATE}"
  printf '여기에는 아무것도 없어 보여요. 정말 그럴까요?\n' >"${CTF_DIR}/1/readme.txt"
  ctf_unxor '08151813142132333e3e3f34053334052a363b33340529333d322e27' >"${CTF_DIR}/1/.archive/.old/.flag"
  printf '%s\n' 'VWs5Q1NVNTdZbUZ6WlRZMFgzUjNhV05sZlE9PQ==' >"${CTF_DIR}/2/note.txt"
  ctf_access_log >"${CTF_DIR}/3/access.log"
  ctf_lock_py >"${CTF_DIR}/4/lock.py"
  chmod 755 "${CTF_DIR}/4/lock.py"
  ctf_downloads
  # Challenge 7: the owner can't even read it until the permission bits change
  rm -f "${CTF_DIR}/7/vault.txt"
  ctf_unxor '0815181314212a3f283733292933353429053b283f05302f292e0538332e2927' >"${CTF_DIR}/7/vault.txt"
  printf '\n' >>"${CTF_DIR}/7/vault.txt"
  chmod 000 "${CTF_DIR}/7/vault.txt"
  ctf_weak_gpg
  ctf_photo
  : >"${CTF_STATE}/prepared"
  printf '%s문제 파일을 ~/practice/ctf에 만들어 뒀어요.%s\n\n' "${C_DIM}" "${C_RESET}"
}

ctf_list() {
  local i mark
  ctf_prepare
  printf '%sRobinOS 입문 CTF%s  %s%s/%s 풀었어요%s\n\n' \
    "${C_BOLD}" "${C_RESET}" "${C_DIM}" "$(ctf_solved_count)" "${CTF_COUNT}" "${C_RESET}"
  for ((i = 1; i <= CTF_COUNT; i++)); do
    if ctf_is_solved "${i}"; then mark="${C_GREEN}✓${C_RESET}"; else mark=" "; fi
    printf '  %s %s. %s  %s%s%s\n' "${mark}" "${i}" "$(ctf_title "${i}")" "${C_DIM}" "$(ctf_skill "${i}")" "${C_RESET}"
  done
  printf '\n문제 보기: %srobinctl ctf show 번호%s\n' "${C_BOLD}" "${C_RESET}"
  printf "플래그 내기: %srobinctl ctf submit 번호 'ROBIN{...}'%s\n" "${C_BOLD}" "${C_RESET}"
  printf '%s학습 미션과 달리 정해진 길이 없어요. 막히면 관련 미션을 다시 보세요(robinctl learn).%s\n' "${C_DIM}" "${C_RESET}"
}

ctf_show() {
  local n="${1:-}"
  [[ "${n}" =~ ^([1-9]|10)$ ]] || die "문제 번호는 1부터 ${CTF_COUNT}까지예요"
  ctf_prepare
  printf '%sCTF %s · %s%s  %s%s%s\n\n' "${C_BOLD}" "${n}" "$(ctf_title "${n}")" "${C_RESET}" "${C_DIM}" "$(ctf_skill "${n}")" "${C_RESET}"
  case "${n}" in
    1)
      cat <<'EOF'
~/practice/ctf/1 에 플래그가 숨어 있어요. ls 로는 아무것도 안 보여요.
힌트: 리눅스에서 이름이 점(.)으로 시작하면 숨은 파일이에요. ls -a, find 를 떠올려요 (미션 1, 5).
EOF
      ;;
    2)
      cat <<'EOF'
~/practice/ctf/2/note.txt 는 알아볼 수 없는 글자예요. 누가 같은 방법으로 두 번 감쌌대요.
힌트: 끝의 == 는 어떤 인코딩의 흔적이에요. base64 -d 를 두 번 (파이프로 이어서).
EOF
      ;;
    3)
      cat <<'EOF'
~/practice/ctf/3/access.log 는 웹 서버 기록이에요. 다른 요청과 다른 하나를 찾고, 그 안에 숨긴 것을 읽어요.
힌트: 주소와 상태 코드, User-Agent가 다른 줄을 grep 으로 찾아요(미션 15). 숫자와 a~f 만 있으면 16진수예요: xxd -r -p
EOF
      ;;
    4)
      cat <<'EOF'
~/practice/ctf/4/lock.py 는 네 자리 비밀번호(0000~9999)로 잠긴 상자예요. 비밀번호는 몰라요.
힌트: 코드를 읽어요(cat lock.py). 비밀번호의 해시가 들어 있어요. 네 자리면 경우가 만 개뿐이라
      하나씩 해시를 만들어 비교하면 금방 찾아요. 파이썬 반복문이나 bash의 for 와 seq -w 0 9999.
교훈: 해시로 감춰도 짧은 비밀번호는 쉽게 찾아요. 그래서 비밀번호는 길어야 해요.
EOF
      ;;
    5)
      cat <<'EOF'
웹 연습 서버(python3 ~/practice/web/server.py)의 /ctf/admin 은 관리자만 볼 수 있대요.
힌트: /ctf 에 들어가면 서버가 쿠키로 역할(role)을 정해 줘요(미션 24). 쿠키는 내 컴퓨터에 있으니
      내가 바꿀 수 있어요: curl -b 'role=...' http://127.0.0.1:8000/ctf/admin
교훈: 브라우저가 보내는 값은 믿으면 안 돼요. 권한은 서버가 직접 확인해야 해요.
EOF
      ;;
    6)
      cat <<'EOF'
~/practice/ctf/6 에는 내려받은 도구 12개와 SHA256SUMS가 있어요. 모든 파일에 플래그처럼 생긴
글자가 들어 있지만, 진짜는 SHA256SUMS와 맞지 않는(누가 바꿔치기한) 파일에만 있어요.
힌트: grep 만으로는 못 골라요. sha256sum -c 로 FAILED인 파일을 찾아요 (미션 39).
교훈: 받은 파일은 열기 전에 배포한 곳의 해시와 맞춰 봐요.
EOF
      ;;
    7)
      cat <<'EOF'
~/practice/ctf/7/vault.txt 는 내 파일인데 cat 하면 "허가 거부"가 나와요.
힌트: ls -l 로 권한을 봐요. ---------- 는 아무도 못 읽는다는 뜻이에요. 주인은 권한을 바꿀 수
      있어요: chmod (미션 4, 37).
교훈: 권한은 파일에 붙은 몇 비트일 뿐이에요. 주인이나 root는 언제든 바꿀 수 있어요.
EOF
      ;;
    8)
      cat <<'EOF'
~/practice/ctf/8/note.txt.gpg 는 비밀번호로 잠근 쪽지예요(미션 40). 비밀번호는 몰라요.
다만 이걸 잠근 사람은 passwords.txt 에 있는 흔한 비밀번호 중 하나를 썼대요.
힌트: 하나씩 넣어 보는 반복문을 만들어요(사전 공격).
  for p in $(cat passwords.txt); do
    gpg --batch --quiet --pinentry-mode loopback --passphrase "$p" -d note.txt.gpg 2>/dev/null && break
  done
교훈: 암호화가 튼튼해도 비밀번호가 흔하면 소용없어요. 목록에 없을 긴 비밀번호를 써요.
EOF
      ;;
    9)
      ctf_door
      cat <<'EOF'
지금 이 컴퓨터(127.0.0.1)의 어떤 포트에서 누군가 기다리고 있어요(1시간 동안). 찾아가서 말을 걸면
플래그를 알려 줘요. 포트 번호는 4000~4999 중 하나예요.
힌트: 듣고 있는 포트는 ss -tln 으로 봐요 (미션 9). 찾으면 nc 127.0.0.1 포트,
      nc가 없으면 bash만으로: cat < /dev/tcp/127.0.0.1/포트
교훈: ss는 내 컴퓨터에서 무엇이 연결을 기다리는지 보여 줘요. 모르는 포트가 열려 있으면 의심해요.
EOF
      ;;
    10)
      cat <<'EOF'
~/practice/ctf/10/photo.png 는 그냥 체크무늬 사진이에요. 그런데 파일 크기가 사진치고 조금 커요.
힌트: 파일 뒤에 다른 파일이 붙어 있을 수 있어요 (미션 14). binwalk 가 있으면 binwalk photo.png,
      없으면 파이썬으로 압축 목록을 봐요: python3 -m zipfile -l photo.png
      풀기는 python3 -m zipfile -e photo.png 풀린곳/
교훈: 파일의 겉모습(확장자, 미리보기)만으로는 속을 알 수 없어요.
EOF
      ;;
  esac
  printf "\n찾으면: %srobinctl ctf submit %s 'ROBIN{...}'%s\n" "${C_BOLD}" "${n}" "${C_RESET}"
}

ctf_submit() {
  local n="${1:-}" flag="${2:-}" given new=0
  [[ "${n}" =~ ^([1-9]|10)$ ]] || die "사용법: robinctl ctf submit 번호 'ROBIN{...}'"
  [[ -n "${flag}" ]] || die "플래그를 함께 적어요: robinctl ctf submit ${n} 'ROBIN{...}'"
  flag="$(printf '%s' "${flag}" | tr -d '\r\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  given="$(printf '%s' "${flag}" | sha256sum | cut -d' ' -f1)"
  if [[ "${given}" == "$(ctf_flag_sha256 "${n}")" ]]; then
    mkdir -p "${CTF_STATE}"
    if ! ctf_is_solved "${n}"; then
      printf '%s\n' "${n}" >>"${CTF_STATE}/solved"
      new=1
    fi
    printf '%s%s맞았어요!%s CTF %s · %s  %s/%s 풀었어요\n' "${C_GREEN}" "${C_BOLD}" "${C_RESET}" \
      "${n}" "$(ctf_title "${n}")" "$(ctf_solved_count)" "${CTF_COUNT}"
    if [[ "$(ctf_solved_count)" == "${CTF_COUNT}" ]]; then
      printf '입문 CTF를 다 풀었어요. 다음은 진짜 취약한 앱이에요: %srobinctl lab info web%s\n' "${C_BOLD}" "${C_RESET}"
      ((new == 0)) || learn_notify "입문 CTF ${CTF_COUNT}문제를 다 풀었어요" "다음은 진짜 취약한 앱이에요: robinctl lab info web"
    fi
  else
    if [[ "${flag}" != ROBIN\{*\} ]]; then
      printf '%s✗%s 플래그는 ROBIN{...} 모양이에요. 따옴표로 감싸서 내요.\n' "${C_RED}" "${C_RESET}"
    else
      printf '%s✗%s 아니에요. 다시 찾아봐요: robinctl ctf show %s\n' "${C_RED}" "${C_RESET}" "${n}"
    fi
    return 1
  fi
}

ctf() {
  case "${1:-}" in
    ""|list)
      ctf_list
      ;;
    show)
      ctf_show "${2:-}"
      ;;
    submit)
      ctf_submit "${2:-}" "${3:-}"
      ;;
    reset)
      rm -f "${CTF_STATE}/solved"
      printf 'CTF 기록을 지웠어요. 문제 파일(~/practice/ctf)은 그대로예요.\n'
      ;;
    *)
      die "사용법: robinctl ctf [list|show 번호|submit 번호 플래그|reset]"
      ;;
  esac
}

# ---- Labs ----

lab_list() {
  cat <<'EOF'
실습 랩:
  web  OWASP Juice Shop과 DVWA로 꾸린 로컬 웹 보안 랩
  net  내 컴퓨터 안의 작은 네트워크(172.30.66.0/24)로 하는 스캔 랩
EOF
}

lab_compose_file() {
  local compose_file="${PROJECT_ROOT}/labs/$1/docker-compose.yml"
  [[ -f "${compose_file}" ]] || die "랩 파일이 없어요: ${compose_file}"
  # Docker comes with the web profile (not in the live ISO or a fresh install)
  have_cmd docker || die "랩은 Docker로 돌아가요. web 프로필을 먼저 설치하세요: sudo robinctl profile web"
  printf '%s' "${compose_file}"
}

lab_info() {
  case "${1:-}" in
    web)
      cat <<'EOF'
RobinOS 웹 랩

실습 대상:
  OWASP Juice Shop  http://localhost:3000
  DVWA              http://localhost:8080

명령:
  robinctl lab start web     시작 (처음에는 이미지를 내려받아서 몇 분 걸려요)
  robinctl lab status web    상태
  robinctl lab stop web      중지 (다 쓰면 꼭 꺼 두세요)

DVWA 처음 쓸 때:
  1. http://localhost:8080/setup.php 에서 "Create / Reset Database"를 눌러요
  2. admin / password 로 로그인해요
  3. "DVWA Security"에서 난이도(low부터)를 골라요

두 대상 모두 내 컴퓨터 안에서만 열리는 학습용 환경이에요.
Docker가 필요해서 web 프로필이 있어야 해요: sudo robinctl profile web
EOF
      ;;
    net)
      cat <<'EOF'
RobinOS 네트워크 스캔 랩

내 컴퓨터 안에 작은 네트워크(172.30.66.0/24)를 만들고 컴퓨터 네 대를 띄워요.
호스트 포트로는 아무것도 열지 않아서 이 컴퓨터에서만 닿아요.
nmap(network 프로필)과 Docker(web 프로필)가 필요해요:
  sudo robinctl profile network
  sudo robinctl profile web

명령:
  robinctl lab start net     시작 (처음에는 작은 이미지 세 개를 내려받아요)
  robinctl lab status net    상태
  robinctl lab stop net      중지 (다 쓰면 꺼 두세요)

해 볼 것 (미션 6, 9, 10의 다음 단계예요):
  1. 내 컴퓨터에 생긴 랩 네트워크 보기     ip a   (br-로 시작하는 장치의 172.30.66.1)
  2. 살아 있는 컴퓨터 찾기                 nmap -sn 172.30.66.0/24
  3. 열린 포트 찾기 (흔한 1000개)          nmap 172.30.66.0/24
  4. 모든 포트 찾기 (한 대씩, 오래 걸려요) nmap -p- 172.30.66.30
     기본 스캔에 안 나오던 포트가 있어요. 컴퓨터는 찾았는데 포트가 없는 곳도 있어요.
  5. 어떤 서비스인지 알아내기              nmap -sV -p 80,6379 172.30.66.10,20
  6. 직접 말 걸어 보기                     curl http://172.30.66.10/
                                           nc 172.30.66.30 31337
     웹 페이지와 배너에 코드(ROBIN-NET-...)가 있어요.

스캔은 이 랩처럼 내 것이거나 허락받은 네트워크에서만 해요. 다른 네트워크를 스캔하면
허가 없는 접근 시도로 볼 수 있어요(docs/ethics.md).
EOF
      ;;
    *)
      die "알 수 없는 랩이에요: ${1:-}"
      ;;
  esac
}

lab_run() {
  local action="$1"
  local lab="${2:-}"
  local compose_file

  [[ "${lab}" == "web" || "${lab}" == "net" ]] || die "알 수 없는 랩이에요: ${lab} (목록: robinctl lab list)"
  compose_file="$(lab_compose_file "${lab}")"

  case "${action}" in
    status)
      lab_docker compose -f "${compose_file}" ps
      ;;
    start)
      if ! systemctl is-active --quiet docker.service 2>/dev/null; then
        printf 'Docker를 켜요.\n'
        lab_sudo systemctl start docker.service
      fi
      lab_docker compose -f "${compose_file}" up -d
      if [[ "${lab}" == "net" ]]; then
        printf '\n랩 네트워크: 172.30.66.0/24 (해 볼 것: robinctl lab info net)\n'
      fi
      printf '\n다 쓴 뒤에는 꺼 두세요: robinctl lab stop %s\n' "${lab}"
      ;;
    stop)
      lab_docker compose -f "${compose_file}" down
      ;;
  esac
}

# Docker needs root. RobinOS doesn't put users in the docker group, which would
# be root without a password for anything running as the user; labs ask for
# sudo instead when the Docker socket isn't writable.
LAB_SUDO_NOTED="false"
lab_sudo() {
  if [[ "${EUID}" -eq 0 || -w /var/run/docker.sock ]]; then
    "$@"
    return
  fi
  if [[ "${LAB_SUDO_NOTED}" != "true" ]]; then
    printf '%s랩은 Docker로 돌아가서 관리자 권한이 필요해요. 비밀번호를 물으면 입력하세요.%s\n' \
      "${C_DIM}" "${C_RESET}" >&2
    LAB_SUDO_NOTED="true"
  fi
  sudo "$@"
}

lab_docker() {
  lab_sudo docker "$@"
}

main() {
  case "${1:-}" in
    version)
      print_version
      ;;
    doctor)
      doctor
      ;;
    audit)
      audit
      ;;
    app)
      shift
      app "$@"
      ;;
    update)
      shift
      update_system "${1:-}"
      ;;
    snapshot)
      shift
      case "${1:-}" in
        create)
          snapshot_create "${2:-}"
          ;;
        list)
          snapshot_list
          ;;
        setup)
          snapshot_setup "${2:-}"
          ;;
        rollback)
          snapshot_rollback "${2:-}" "${3:-}"
          ;;
        *)
          die "사용법: robinctl snapshot create|list|setup|rollback"
          ;;
      esac
      ;;
    profile)
      shift
      case "${1:-}" in
        list|"")
          profile_list
          ;;
        *)
          profile_known "$1" || die "알 수 없는 프로필이에요: $1 (목록: robinctl profile list)"
          profile_install "$1" "${2:-}"
          ;;
      esac
      ;;
    packages)
      shift
      packages_print "${1:-}"
      ;;
    learn)
      shift
      learn "$@"
      ;;
    ctf)
      shift
      ctf "$@"
      ;;
    lab)
      shift
      case "${1:-}" in
        list)
          lab_list
          ;;
        info)
          shift
          lab_info "${1:-}"
          ;;
        status|start|stop)
          lab_run "$1" "${2:-}"
          ;;
        *)
          die "사용법: robinctl lab list|info|status|start|stop"
          ;;
      esac
      ;;
    help|-h|--help|"")
      usage
      ;;
    *)
      die "알 수 없는 명령이에요: ${1} (robinctl help로 목록을 볼 수 있어요)"
      ;;
  esac
}

main "$@"
