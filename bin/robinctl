learn_check_15() {
  local answer addresses
  answer="$(cat "${LEARN_FOR}/attacker.txt" 2>/dev/null || true)"
  if [[ -z "${answer//[[:space:]]/}" ]]; then
    learn_bad "~/practice/forensics/attacker.txt가 없거나 비어 있어요" "grep \"Failed password\" auth.log | grep -oE \"from [0-9.]+\" | sort | uniq -c | sort -n"
    return
  fi
  addresses="$(printf '%s' "${answer}" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u || true)"
  if [[ "${addresses}" == "203.0.113.45" ]]; then
    learn_ok "203.0.113.45가 12번 실패했어요. 비밀번호를 마구 넣어 본 흔적이에요"
  elif [[ "${addresses}" == *203.0.113.45* ]]; then
    learn_bad "주소를 하나만 적어요" "가장 많이 실패한 주소 하나만 남겨요"
  else
    learn_bad "가장 많이 실패한 주소가 아니에요" "uniq -c 로 센 숫자가 가장 큰 줄을 찾아요"
  fi
}

