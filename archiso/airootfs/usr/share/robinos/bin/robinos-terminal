#!/usr/bin/env bash
# RobinOS's terminal (docs/tasks.md T-154): Ptyxis, which draws its own title bar so
# the window can be dragged with the mouse, or foot where Ptyxis isn't installed
# (systems installed before 2026-10-12 that only updated the robinos files).
#
#   robinos-terminal [-T TITLE] [-- COMMAND ARGS...]
set -euo pipefail

title=""
if [[ "${1:-}" == "-T" ]]; then
  title="${2:-}"
  shift 2
fi
[[ "${1:-}" == "--" ]] && shift

if command -v ptyxis >/dev/null 2>&1; then
  args=(ptyxis --new-window)
  [[ -n "${title}" ]] && args+=(-T "${title}")
  (($#)) && args+=(-- "$@")
else
  args=(foot)
  [[ -n "${title}" ]] && args+=("--title=${title}")
  args+=("$@")
fi
exec "${args[@]}"
