#!/usr/bin/env bash
# RobinOS desktop session (started by SDDM through robinos.desktop).
#
# Picks a rendering mode before starting Hyprland:
#   - Graphics drivers without 3D acceleration (Hyper-V, QEMU std VGA, ...) start
#     straight in software rendering.
#   - Everything else starts with GPU acceleration. If Hyprland exits within a few
#     seconds (no usable GPU), it is started again with software rendering.
# ROBINOS_RENDER=hardware|software is exported so Hyprland and the shell can
# drop expensive effects (blur, shadows) in software mode.
#
# Force a mode by exporting ROBINOS_RENDER=software or ROBINOS_RENDER=hardware
# in ~/.bash_profile (SDDM starts the session through a login shell).
# Log: ~/.local/state/robinos/session.log

set -uo pipefail

state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/robinos"
log="${state_dir}/session.log"
mkdir -p "${state_dir}"
: >"${log}"

note() {
  printf '[robinos-session] %s\n' "$*" >>"${log}"
  logger -t robinos-session -- "$*" 2>/dev/null || true
}

# The boot test (scripts/boot-test.sh) boots with "robinos.debug" so Hyprland and
# shell output also reach the journal and the serial console.
debug="false"
if grep -qw robinos.debug /proc/cmdline 2>/dev/null; then
  debug="true"
fi

# DRM drivers that only offer 2D framebuffers in common VMs.
no_3d_driver() {
  local card driver
  for card in /sys/class/drm/card[0-9]*; do
    [[ -e "${card}/device/driver" ]] || continue
    driver="$(basename "$(readlink -f "${card}/device/driver")")"
    case "${driver}" in
      hyperv_drm|bochs|bochs-drm|simpledrm|cirrus|cirrus-qemu|qxl|vboxvideo|efifb|vesafb)
        note "graphics driver ${driver} has no 3D acceleration"
        return 0
        ;;
    esac
  done
  if ! compgen -G "/dev/dri/renderD*" >/dev/null; then
    note "no DRM render node found"
    return 0
  fi
  return 1
}

use_software() {
  export ROBINOS_RENDER=software
  export LIBGL_ALWAYS_SOFTWARE=1
  export WLR_RENDERER_ALLOW_SOFTWARE=1
  export WLR_NO_HARDWARE_CURSORS=1
  export AQ_NO_ATOMIC=1
}

# Hyprland itself, not start-hyprland: that watchdog restarts a Hyprland that
# exited uncleanly in --safe-mode, so the software retry below would never run
run_hyprland() {
  local started
  started="$(date +%s)"
  if [[ "${debug}" == "true" ]]; then
    Hyprland 2>&1 | tee -a "${log}" | systemd-cat -t hyprland
    status=${PIPESTATUS[0]}
  else
    Hyprland >>"${log}" 2>&1
    status=$?
  fi
  ran_for=$(( $(date +%s) - started ))
  note "Hyprland exited with ${status} after ${ran_for}s (ROBINOS_RENDER=${ROBINOS_RENDER})"
}

status=0
ran_for=0

case "${ROBINOS_RENDER:-auto}" in
  software)
    use_software
    ;;
  hardware)
    export ROBINOS_RENDER=hardware
    ;;
  *)
    if no_3d_driver; then
      use_software
    else
      export ROBINOS_RENDER=hardware
    fi
    ;;
esac

note "starting Hyprland (ROBINOS_RENDER=${ROBINOS_RENDER})"
run_hyprland

if [[ "${ROBINOS_RENDER}" == "hardware" && "${ran_for}" -lt 8 ]]; then
  note "hardware rendering failed to start; retrying with software rendering"
  use_software
  run_hyprland
fi

exit "${status}"
