// RobinOS: a short system summary with Korean labels that fits foot's
// 100-column window (the live session's ~/.bashrc shows it; `fastfetch` anywhere).
// The logo is the robin as terminal art (assets/brand/build-terminal-logo.py);
// raw logos need their size spelled out.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/robinos/fastfetch/robinos-logo.ansi",
    "width": 31,
    "height": 15,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "운영체제" },
    { "type": "kernel", "key": "커널" },
    { "type": "uptime", "key": "켜진 시간" },
    { "type": "packages", "key": "패키지" },
    { "type": "shell", "key": "셸" },
    { "type": "display", "key": "화면" },
    { "type": "wm", "key": "창 관리자" },
    { "type": "terminal", "key": "터미널" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "그래픽" },
    { "type": "memory", "key": "메모리" },
    { "type": "disk", "key": "디스크", "folders": "/" },
    { "type": "localip", "key": "IP 주소" },
    { "type": "locale", "key": "언어" },
    "break",
    "colors"
  ]
}
