# RobinOS GNOME/GTK interface defaults (system dconf database "local").
# Installed to /etc/dconf/db/local.d/00-robinos; run `dconf update` afterwards.
# GTK, libadwaita, Firefox and the xdg-desktop-portal settings read these.
# The shell changes color-scheme, gtk-theme and accent-color when the user picks a theme.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='RobinOS-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
cursor-size=24
font-name='Pretendard Variable 11'
document-font-name='Pretendard Variable 11'
monospace-font-name='Cascadia Mono 11'
accent-color='blue'
enable-hot-corners=false

# Text Editor paints its window from its style scheme; "robinos" (and its dark
# variant) has the kit's faces (desktop/gtk, scripts/build-gtk-theme.py)
[org/gnome/TextEditor]
style-scheme='robinos'

# Title bar buttons of GTK, Firefox and Qt apps. Hyprland 0.56 ignores an app's
# own minimize request (xdg_toplevel.set_minimized), so that button would do
# nothing; the dock minimizes instead (desktop/shell/ShellState.qml).
[org/gnome/desktop/wm/preferences]
button-layout='appmenu:maximize,close'

# Ptyxis, the terminal (T-154): follow the shell's light/dark choice, open each
# window clean instead of restoring the last session, a little larger than 80x24,
# and the interface's monospace font above (Cascadia Mono)
[org/gnome/Ptyxis]
interface-style='system'
restore-session=false
restore-window-size=false
default-columns=uint32 100
default-rows=uint32 28
default-profile-uuid='7b3e0c5a9d214f6e8a1c2b4d6e8f0a13'
profile-uuids=['7b3e0c5a9d214f6e8a1c2b4d6e8f0a13']

# The one profile uses the robin-ui V5 palette (desktop/ptyxis/robinos.palette, the
# same faces as foot.ini). Ptyxis reads palettes from the user's data directory only,
# so robinos-terminal keeps a copy there; without it Ptyxis falls back to its own.
[org/gnome/Ptyxis/Profiles/7b3e0c5a9d214f6e8a1c2b4d6e8f0a13]
label='RobinOS'
palette='robinos'
