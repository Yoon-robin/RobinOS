# RobinOS GNOME/GTK interface defaults (system dconf database "local").
# Installed to /etc/dconf/db/local.d/00-robinos; run `dconf update` afterwards.
# GTK, libadwaita, Firefox and the xdg-desktop-portal settings read these.
# The shell changes color-scheme, gtk-theme and accent-color when the user picks a theme.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
cursor-size=24
font-name='Geist 11'
document-font-name='Geist 11'
monospace-font-name='Geist Mono 11'
accent-color='red'
enable-hot-corners=false
