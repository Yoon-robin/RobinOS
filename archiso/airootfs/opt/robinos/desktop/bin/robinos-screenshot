#!/usr/bin/env bash
set -euo pipefail

# Usage: robinos-screenshot [region|screen]
# Saves to ~/Pictures/Screenshots, copies the image to the clipboard, and notifies.

mode="${1:-region}"
dir="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "${HOME}")/Screenshots"
file="${dir}/$(date +%Y%m%d-%H%M%S).png"

mkdir -p "${dir}"

case "${mode}" in
  region)
    geometry="$(slurp -d -b '#09090b99' -c '#fafafaff' -w 1)" || exit 0
    grim -g "${geometry}" "${file}"
    ;;
  screen)
    grim "${file}"
    ;;
  *)
    printf 'usage: %s [region|screen]\n' "$0" >&2
    exit 1
    ;;
esac

wl-copy --type image/png <"${file}"
# Like Windows' snipping tool toast: a click opens the picture, the button opens its
# folder. notify-send waits for the choice in the background, so the key returns now.
# The x-robinos-open hint lets the notification center open the picture later, after
# the toast (and this notify-send) are gone.
(
  action="$(notify-send --app-name=RobinOS --icon="${file}" --action=default=열기 --action=folder="폴더 열기" \
    --hint="string:x-robinos-open:${file}" "스크린샷을 저장했어요" "${file/#${HOME}/\~} · 클립보드에도 복사했어요" || true)"
  case "${action}" in
    default) xdg-open "${file}" ;;
    folder) xdg-open "${dir}" ;;
  esac
) >/dev/null 2>&1 &
